#!/usr/bin/env perl
# hps-onboard: review held hosts and assign them a role.
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use HPS::Onboard;

# Network hook for assign: the IPS script, unless the caller overrides it
# (HPS_ONBOARD_NETCONF_CMD set to a path, or to the empty string for none).
my $netconf_hook = "$RealBin/../scripts/hps-netconf-hook.sh";
$ENV{HPS_ONBOARD_NETCONF_CMD} = $netconf_hook
    if !defined $ENV{HPS_ONBOARD_NETCONF_CMD} && -x $netconf_hook;

my %EXIT = (usage => 2, refused => 3, notfound => 4, failed => 1);

sub usage {
    my ($msg) = @_;
    print STDERR "hps-onboard: $msg\n" if $msg;
    print STDERR <<'USAGE';
Usage:
  hps-onboard list [--all] [--json]
      without --all: the held hosts. With --all: every host, with its state and
      whether its last init succeeded (FAILED marks a failed init).
  hps-onboard show <mac> [--json]
  hps-onboard assign <mac> --type SCH,TCH,DRH --profile NAME \
      --os arch:name:version --pin PIN [--storage "note"]
  hps-onboard repin <mac> (--pin PIN | --to-latest)
  hps-onboard nets <mac> [--attach NAME[,NAME...]] [--json]
      without --attach: the networks attached to the host. With --attach:
      REPLACE the list (names from the cluster network layout; an empty
      --attach '' clears it).
Exit: 0 ok, 2 usage, 3 refused (assign: host not HELD; repin: host HELD
or already on that pin), 4 not found (host, OS, or pin artefacts).
USAGE
    return 2;
}

sub render_list {
    my (@held) = @_;
    return "No held hosts.\n" unless @held;
    my $out = sprintf("%-14s %-8s %s\n", 'MAC', 'AUDIT', 'AUDITED AT');
    $out .= sprintf("%-14s %-8s %s\n", $_->{mac}, $_->{has_audit} ? 'yes' : 'none', $_->{audit_at} // '-') for @held;
    return $out;
}

sub render_list_all {
    my (@hosts) = @_;
    return "No hosts.\n" unless @hosts;
    my $out = sprintf("%-14s %-12s %-8s %s\n", 'MAC', 'STATE', 'INIT', 'LAST INIT');
    for my $h (@hosts) {
        my $ok = $h->{init_ok};
        my $mark = !defined $ok ? '-' : $ok eq 'true' ? 'ok' : $ok eq 'false' ? 'FAILED' : $ok;
        $out .= sprintf("%-14s %-12s %-8s %s\n", $h->{mac}, $h->{state} // '-', $mark, $h->{init_at} // '-');
    }
    return $out;
}

# One init result as lines: header, then the failed steps first (rc, seconds,
# name, message), then the steps that succeeded.
sub render_init_result {
    my ($r, $label) = @_;
    my @steps = ref $r->{steps} eq 'ARRAY' ? @{ $r->{steps} } : ();
    my @bad = grep { ($_->{rc} // 0) != 0 } @steps;
    my @ok  = grep { ($_->{rc} // 0) == 0 } @steps;
    my $out = sprintf("%s: %s, finished %s, pin %s, boot %s\n", $label,
        @bad ? scalar(@bad) . " of " . scalar(@steps) . " steps FAILED" : "all " . scalar(@steps) . " steps ok",
        $r->{finished_at} || '-', $r->{pin} || '-', $r->{boot_id} || '-');
    for my $st (@bad, @ok) {
        my $rc = $st->{rc} // 0;
        $out .= sprintf("  %-6s rc=%-3s %4ss  %s\n", $rc ? 'FAILED' : 'ok', $rc, $st->{seconds} // 0, $st->{name} // '?');
        my $m = $st->{message};
        if ($rc && defined $m && length $m) {
            $out .= "           $_\n" for split /\n/, $m;
        }
    }
    return $out;
}

sub render_init {
    my ($s) = @_;
    return "\nNo init result reported by this host.\n" unless ref $s->{init} eq 'HASH';
    my $out = "\nInit\n" . render_init_result($s->{init}, '  Last boot');
    $out .= render_init_result($s->{init_prev}, '  Previous boot') if ref $s->{init_prev} eq 'HASH';
    return $out;
}

sub render_value {
    my ($v, $indent) = @_;
    my $pad = '  ' x $indent;
    if (ref $v eq 'HASH') {
        return join '', map {
            my $x = $v->{$_};
            ref $x ? "$pad$_:\n" . render_value($x, $indent + 1) : "$pad$_: " . (defined $x ? $x : '') . "\n"
        } sort keys %$v;
    }
    if (ref $v eq 'ARRAY') {
        return join '', map {
            ref $_ ? "$pad-\n" . render_value($_, $indent + 1) : "$pad- $_\n"
        } @$v;
    }
    return "$pad" . (defined $v ? $v : '') . "\n";
}

sub render_show {
    my ($s) = @_;
    my $out = "Host $s->{mac}\n  State: " . ($s->{state} // '-') . "\n\nIdentity\n";
    $out .= render_value($s->{identity}, 1);
    if (defined $s->{audit}) {
        $out .= "\nAudit" . (defined $s->{audit_at} ? " ($s->{audit_at})" : '') . "\n";
        my $a = $s->{audit};
        $out .= "\n";
        $out .= (ref $a eq 'HASH' && ($a->{schema} // '') eq 'hps-audit/1')
            ? HPS::Onboard::render_audit($a)
            : render_value($a, 1);   # unknown shape: plain dump
    }
    else {
        $out .= "\nNo audit stored for this host.\n";
    }
    $out .= render_init($s);
    if (ref $s->{nets} eq 'ARRAY' && @{ $s->{nets} }) {
        $out .= "\nNetworks attached: " . join(', ', @{ $s->{nets} }) . "\n";
    }
    return $out;
}

sub render_nets {
    my ($r) = @_;
    return "No networks attached.\n" unless @$r;
    return join '', map {
        sprintf("%-16s %-18s vlan %-5s bridge %-15s %s\n", $_->{name}, $_->{cidr} // '?',
            defined $_->{vlan} ? $_->{vlan} : '-', $_->{bridge} // '?', $_->{purpose} // '?')
    } @$r;
}

sub main {
    my @argv = @_;
    my ($json, $type, $profile, $os, $pin, $storage, $to_latest, $attach, $all);
    my $cmd = shift @argv // return usage('command required');
    GetOptionsFromArray(
        \@argv, 'json' => \$json, 'type=s' => \$type, 'profile=s' => \$profile,
        'os=s' => \$os, 'pin=s' => \$pin, 'storage=s' => \$storage, 'to-latest' => \$to_latest, 'attach=s' => \$attach, 'all' => \$all,
    ) or return usage();
    my $ob = HPS::Onboard->new;
    my $js = JSON::PP->new->canonical->pretty->allow_nonref;
    my $rc = eval {
        if ($cmd eq 'list') {
            return usage('list takes no arguments') if @argv;
            if ($all) {
                my @hosts = $ob->list_all;
                print $json ? $js->encode(\@hosts) : render_list_all(@hosts);
            }
            else {
                my @held = $ob->list_held;
                print $json ? $js->encode(\@held) : render_list(@held);
            }
        }
        elsif ($cmd eq 'show') {
            return usage('show needs one MAC') unless @argv == 1;
            my $s = $ob->show($argv[0]);
            print $json ? $js->encode($s) : render_show($s);
        }
        elsif ($cmd eq 'assign') {
            return usage('assign needs one MAC') unless @argv == 1;
            my $r = $ob->assign($argv[0], { type => $type, profile => $profile, os => $os, pin => $pin, storage_note => $storage });
            print "Assigned $r->{mac}: state now $r->{state}\n";
        }
        elsif ($cmd eq 'nets') {
            return usage('nets needs one MAC') unless @argv == 1;
            if (defined $attach) {
                my @names = grep { length } split /,/, $attach;
                my $r = $ob->attach_nets($argv[0], \@names);
                print "Networks for $r->{mac}: " . (@{ $r->{nets} } ? join(', ', @{ $r->{nets} }) : '(none)') . "\n";
            }
            else {
                my $r = $ob->nets($argv[0]);
                print $json ? $js->encode($r) : render_nets($r);
            }
        }
        elsif ($cmd eq 'repin') {
            return usage('repin needs one MAC') unless @argv == 1;
            my $r = $ob->repin($argv[0], { pin => $pin, to_latest => $to_latest });
            print "Repinned $r->{mac}: " . ($r->{from} // '(none)') . " -> $r->{to}\n";
        }
        else {
            return usage("unknown command '$cmd'");
        }
        0;
    };
    return $rc if defined $rc;
    my $err = $@;
    if (ref $err && $err->isa('HPS::Onboard::Error')) {
        print STDERR 'hps-onboard: ' . $err->message . "\n";
        return $EXIT{ $err->kind } // 1;
    }
    print STDERR "hps-onboard: $err";
    return 1;
}

exit main(@ARGV);
