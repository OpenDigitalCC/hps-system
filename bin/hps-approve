#!/usr/bin/env perl
# hps-approve: a human approves (or revokes) a destructive storage action.
# Approvals are HMAC-signed (HPS::Approval), bound to host, pool, disks and an
# expiry, and stored in the registry. Run by the operator, never by an agent.
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use POSIX qw(strftime);
use HPS::Registry;
use HPS::Keysafe;
use HPS::Approval;

# 0 ok, 1 failed, 2 usage, 3 refused (policy, bad permissions, bad signature), 4 not found
my %EXIT = (
    usage => 2, refused => 3, perms => 3, tampered => 3, expired => 3,
    malformed => 3, notfound => 4, failed => 1,
);

sub usage {
    my ($msg) = @_;
    print STDERR "hps-approve: $msg\n" if $msg;
    print STDERR <<'USAGE';
Usage:
  hps-approve pool-create <mac> --pool NAME --disk BY-ID [--disk BY-ID ...]
      [--wipe] [--expires SECONDS] [--allow-any-pool-name] [--json]
  hps-approve pool-destroy <mac> --pool NAME [--expires SECONDS]
      [--allow-any-pool-name] [--json]
  hps-approve zvol-destroy <mac> --dataset POOL/enc/[vm/]NAME [--expires SECONDS]
      [--allow-any-pool-name] [--json]
  hps-approve workload-destroy <mac> --workload NAME [--expires SECONDS] [--json]
  hps-approve host-forget <mac> [--expires SECONDS] [--json]
  hps-approve list <mac> [--json]
  hps-approve revoke <mac> <action> <pool> [--json]
The pool (for zvol-destroy the pool part of the dataset) is named after the
active cluster; any other name needs --allow-any-pool-name. Default expiry 3600 s.
workload-destroy: <mac> is the compute host of the workload's first VM; NAME is the
workload (no cluster-name rule); it covers the zvols of the workload's local legs.
host-forget: approves hps-onboard forget <mac> (removes the host from the registry, its
DHCP/DNS entries and its ctrl-exec agent); the approval goes with the host entry.
Exit: 0 ok, 2 usage, 3 refused, 4 not found, 1 failed.
USAGE
    return 2;
}

sub refuse { die HPS::Keysafe::Error->new('refused', $_[0]) }

sub utc { return strftime('%Y-%m-%d %H:%M:%S UTC', gmtime($_[0])) }

sub render_approval {
    my ($a, $verb) = @_;
    my $out = "$verb $a->{action} for host $a->{mac}\n  Pool:    $a->{pool}\n";
    $out .= "  Disks:\n" . join('', map {"    $_\n"} @{ $a->{disks} }) if @{ $a->{disks} };
    $out .= "  Wipe:    " . ($a->{wipe} ? 'yes (existing labels and signatures may be destroyed)' : 'no') . "\n";
    $out .= "  Expires: " . utc($a->{expires}) . " (epoch $a->{expires})\n";
    $out .= "  By:      $a->{issued_by}\n";
    return $out;
}

sub render_list {
    my (@rows) = @_;
    return "No approvals.\n" unless @rows;
    my $out = sprintf("%-13s %-8s %-14s %-9s %s\n", 'ACTION', 'STATUS', 'POOL', 'WIPE', 'EXPIRES');
    $out .= sprintf("%-13s %-8s %-14s %-9s %s\n", $_->{action} // '?', $_->{status}, $_->{pool} // '?',
        $_->{wipe} ? 'yes' : 'no', defined $_->{expires} ? utc($_->{expires}) : '-') for @rows;
    return $out;
}

# The pool ruling and the host check shared by the issuing commands.
sub check_policy {
    my ($reg, $cmd, $mac, $pool, $any) = @_;
    my $m = eval { HPS::Registry::normalise_mac($mac) };
    die HPS::Keysafe::Error->new('usage', "Invalid MAC address: $mac") unless defined $m;
    die HPS::Keysafe::Error->new('notfound', "No such host: $mac") unless $reg->host_exists($m);
    my $cluster = $reg->active_cluster;
    (my $pool_part = $pool) =~ s{/.*}{};
    refuse("pool '$pool_part' is not the active cluster name '$cluster' (use --allow-any-pool-name to override)")
        unless $any || $pool_part eq $cluster;
    if ($cmd eq 'pool-create') {
        my $state = $reg->host_get($m, 'STATE');
        refuse("host $m is not assigned (STATE is '" . ($state // '') . "'); run hps-onboard assign first")
            if !defined $state || $state eq '' || $state eq 'HELD';
    }
    return $m;
}

sub main {
    my @argv = @_;
    my ($json, $pool, $dataset, $workload, @disks, $wipe, $expires, $any);
    my $cmd = shift @argv // return usage('command required');
    GetOptionsFromArray(
        \@argv, 'json' => \$json, 'pool=s' => \$pool, 'dataset=s' => \$dataset, 'workload=s' => \$workload, 'disk=s' => \@disks, 'wipe' => \$wipe,
        'expires=s' => \$expires, 'allow-any-pool-name' => \$any,
    ) or return usage();
    return usage("unknown command '$cmd'") unless $cmd =~ /^(?:pool-create|pool-destroy|zvol-destroy|workload-destroy|host-forget|list|revoke)$/;
    my $js  = JSON::PP->new->canonical->pretty->allow_nonref;
    my $reg = HPS::Registry->new;
    my $rc = eval {
        my $ap = HPS::Approval->new(registry => $reg);
        return usage('--dataset is only for zvol-destroy') if defined $dataset && $cmd ne 'zvol-destroy';
        return usage('--workload is only for workload-destroy') if defined $workload && $cmd ne 'workload-destroy';
        if ($cmd eq 'pool-create' || $cmd eq 'pool-destroy') {
            return usage("$cmd needs one MAC") unless @argv == 1;
            return usage('--pool is required') unless defined $pool && length $pool;
            return usage('--disk is only for pool-create') if $cmd eq 'pool-destroy' && @disks;
            return usage('--wipe is only for pool-create') if $cmd eq 'pool-destroy' && $wipe;
            return usage('pool-create needs at least one --disk') if $cmd eq 'pool-create' && !@disks;
            return usage('--expires must be a positive number of seconds')
                if defined $expires && $expires !~ /^[1-9][0-9]{0,8}$/;
            my $mac = check_policy($reg, $cmd, $argv[0], $pool, $any);
            my %f = (action => $cmd, mac => $mac, pool => $pool, disks => [@disks], wipe => $wipe ? 1 : 0);
            $f{expires} = $ap->now + $expires if defined $expires;
            my $doc = $ap->issue(\%f);
            my $a = decode_json($doc);
            print $json ? $js->encode($a) : render_approval($a, 'Approved');
        }
        elsif ($cmd eq 'zvol-destroy') {
            return usage('zvol-destroy needs one MAC') unless @argv == 1;
            return usage('--dataset is required') unless defined $dataset && length $dataset;
            return usage('zvol-destroy takes --dataset, not --pool, --disk or --wipe') if defined $pool || @disks || $wipe;
            return usage('--expires must be a positive number of seconds')
                if defined $expires && $expires !~ /^[1-9][0-9]{0,8}$/;
            my $mac = check_policy($reg, $cmd, $argv[0], $dataset, $any);
            my %f = (action => $cmd, mac => $mac, pool => $dataset, disks => [], wipe => 0);
            $f{expires} = $ap->now + $expires if defined $expires;
            my $a = decode_json($ap->issue(\%f));
            print $json ? $js->encode($a) : render_approval($a, 'Approved');
        }
        elsif ($cmd eq 'workload-destroy') {
            return usage('workload-destroy needs one MAC') unless @argv == 1;
            return usage('--workload is required') unless defined $workload && length $workload;
            return usage('workload-destroy takes --workload, not --pool, --dataset, --disk or --wipe') if defined $pool || defined $dataset || @disks || $wipe;
            return usage('--expires must be a positive number of seconds')
                if defined $expires && $expires !~ /^[1-9][0-9]{0,8}$/;
            my $mac = check_policy($reg, $cmd, $argv[0], $workload, 1);
            my %f = (action => $cmd, mac => $mac, pool => $workload, disks => [], wipe => 0);
            $f{expires} = $ap->now + $expires if defined $expires;
            my $a = decode_json($ap->issue(\%f));
            print $json ? $js->encode($a) : render_approval($a, 'Approved');
        }
        elsif ($cmd eq 'host-forget') {
            return usage('host-forget needs one MAC') unless @argv == 1;
            return usage('host-forget takes only a MAC and --expires') if defined $pool || defined $dataset || defined $workload || @disks || $wipe;
            return usage('--expires must be a positive number of seconds')
                if defined $expires && $expires !~ /^[1-9][0-9]{0,8}$/;
            my $mac = check_policy($reg, $cmd, $argv[0], 'host', 1);
            my %f = (action => $cmd, mac => $mac, pool => 'host', disks => [], wipe => 0);
            $f{expires} = $ap->now + $expires if defined $expires;
            my $a = decode_json($ap->issue(\%f));
            print $json ? $js->encode($a) : render_approval($a, 'Approved');
        }
        elsif ($cmd eq 'list') {
            return usage('list needs one MAC') unless @argv == 1;
            my @rows = $ap->list($argv[0]);
            print $json ? $js->encode(\@rows) : render_list(@rows);
        }
        else {
            return usage('revoke needs <mac> <action> <pool>') unless @argv == 3;
            my $gone = $ap->revoke(@argv);
            die HPS::Keysafe::Error->new('notfound', "No $argv[1] approval for pool $argv[2] on $argv[0]") unless $gone;
            print $json ? $js->encode({ revoked => 1, action => $argv[1], pool => $argv[2] })
                        : "Revoked $argv[1] for pool $argv[2] on host $argv[0]\n";
        }
        0;
    };
    return $rc if defined $rc;
    my $err = $@;
    if (ref $err && $err->isa('HPS::Keysafe::Error')) {
        print STDERR 'hps-approve: ' . $err->message . "\n";
        return $EXIT{ $err->kind } // 1;
    }
    $err =~ s/\s+\z//;
    print STDERR "hps-approve: $err\n";
    return 1;
}

exit main(@ARGV);
