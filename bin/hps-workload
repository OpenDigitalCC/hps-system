#!/usr/bin/env perl
# hps-workload: create, start, stop, destroy and inspect a workload (HPS::Workload).
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use HPS::Keysafe;
use HPS::Workload;

# 0 ok, 1 failed, 2 usage, 3 refused (definition, policy, node refusal), 4 not found
my %EXIT = (
    usage => 2, refused => 3, perms => 3,
    malformed => 3, notfound => 4, failed => 1,
);

sub usage {
    my ($msg) = @_;
    print STDERR "hps-workload: $msg\n" if $msg;
    print STDERR <<'USAGE';
Usage:
  hps-workload create  <name> [--resume] [--dry-run] [--json] [--allow-any-pool-name]
  hps-workload start   <name> [--vm <vm>] [--dry-run] [--json]
  hps-workload stop    <name> [--vm <vm>] [--dry-run] [--json]
  hps-workload destroy <name> [--forget] [--dry-run] [--json] [--allow-any-pool-name]
  hps-workload status  <name> [--vm <vm>] [--dry-run] [--json]
  hps-workload grow-disk <name> <vm> <disk> <new size> [--dry-run] [--json]
  hps-workload define  <name> [--replace] [--dry-run] [--json]   (the JSON definition on stdin)
  hps-workload show-definition <name>
<name> is the workload: workloads/<name>.json under the cluster's config directory.
create refuses a workload that already exists unless --resume (continue an
unfinished create). destroy removes the instance (VMs, zvols, mirrors, record) and
keeps workloads/<name>.json, so a later create works; destroy --forget also removes
the definition.
grow-disk grows one disk of a VM (a single local zvol, never shrunk) to the new
size, like 64G, and tells the running guest (storage-zvol-grow, vm-disk-resize);
the filesystem inside the guest is grown there (cnh-disk-grow on a CNH).
define checks the JSON on stdin as create checks a definition and writes it to
workloads/<name>.json; an existing definition is replaced only with --replace,
and never while the workload exists (destroy it first). show-definition prints
the stored JSON.
--dry-run prints the node calls (define: checks the definition) and changes nothing.
Exit: 0 ok, 2 usage, 3 refused, 4 not found, 1 failed.
USAGE
    return 2;
}

sub render_plan {
    my ($plan) = @_;
    my $out = '';
    for my $s (@$plan) {
        $out .= "  $s->{n}. [$s->{host}] $s->{script}" . join('', map {" $_"} @{ $s->{args} }) . "\n";
        $out .= "     input: $s->{input}\n" if defined $s->{input};
        $out .= "     $s->{only}\n" if defined $s->{only};
    }
    return $out;
}

sub render_run {
    my ($r) = @_;
    my $out = '';
    for my $s (@{ $r->{steps} }) {
        if ($s->{skipped}) {
            $out .= "== $s->{n}. $s->{script}" . join('', map {" $_"} @{ $s->{args} })
                . ($s->{not_needed} ? " (skipped, not needed)\n" : " (skipped, done earlier)\n");
            next;
        }
        $out .= "== $s->{n}. $s->{script}" . join('', map {" $_"} @{ $s->{args} }) . " (exit $s->{rc})\n";
        $out .= $s->{stdout} . ($s->{stdout} =~ /\n\z/ || !length $s->{stdout} ? '' : "\n");
    }
    return $out;
}

sub render_status {
    my ($r) = @_;
    my $out = "Workload $r->{name}: $r->{state}\n";
    for my $v (@{ $r->{vms} }) {
        $out .= sprintf("  %-20s host %-14s recorded %-9s node %s%s\n", $v->{vm}, $v->{host} // '-',
            $v->{recorded_state} // '-', $v->{state}, $v->{ok} ? '' : ' (a node call failed)');
        $out .= "    mirror $_->{name}: $_->{state}\n" for @{ $v->{mirrors} };
    }
    return $out;
}

sub fail_exit {
    my ($err) = @_;
    if (ref $err && $err->isa('HPS::Keysafe::Error')) {
        print STDERR 'hps-workload: ' . $err->message . "\n";
        return $EXIT{ $err->kind } // 1;
    }
    $err =~ s/\s+\z//;
    print STDERR "hps-workload: $err\n";
    return 1;
}

# define <name> (the JSON on stdin) and show-definition <name>: the definition
# file itself, no node call.
sub definition_verb {
    my ($op, $name, $rest, %o) = @_;
    return usage("$op takes no further arguments") if @$rest;
    return usage("$op takes no --resume, --allow-any-pool-name, --vm or --forget") if $o{other};
    if ($op eq 'show-definition') {
        return usage('show-definition takes no options') if $o{json} || $o{dry_run} || $o{replace};
    }
    my $rc = eval {
        my $wl = HPS::Workload->new;
        if ($op eq 'show-definition') {
            my $text = $wl->show_definition($name);
            print $text, ($text =~ /\n\z/ || !length $text ? '' : "\n");
            return 0;
        }
        binmode STDIN;
        my $text = '';
        my $max = $HPS::Workload::MAX_DEFINITION_BYTES + 1;
        while (length $text < $max) {
            my $got = read(STDIN, $text, $max - length $text, length $text);
            die "cannot read the definition on stdin: $!\n" unless defined $got;
            last if $got == 0;
        }
        my $r = $wl->define($name, $text, replace => $o{replace}, dry_run => $o{dry_run});
        if ($o{json}) { print JSON::PP->new->canonical->pretty->encode($r) }
        elsif ($r->{dry_run}) {
            print "Dry run: define $name; the definition is valid (VMs: " . join(', ', @{ $r->{vms} })
                . "); $r->{path} would be " . ($r->{replaced} ? 'replaced' : 'written') . "; nothing is changed.\n";
        }
        else {
            print 'define ok: workload ' . $name . ' ' . ($r->{replaced} ? 'replaced' : 'defined')
                . " in $r->{path} (VMs: " . join(', ', @{ $r->{vms} }) . ")\n";
        }
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

sub main {
    my @argv = @_;
    my ($json, $dry, $resume, $any, $vm, $forget, $replace);
    GetOptionsFromArray(
        \@argv, 'json' => \$json, 'dry-run' => \$dry, 'resume' => \$resume,
        'allow-any-pool-name' => \$any, 'vm=s' => \$vm, 'forget' => \$forget,
        'replace' => \$replace,
    ) or return usage();
    my $op   = shift @argv // return usage('operation required');
    my $name = shift @argv // return usage('workload name required');
    return definition_verb($op, $name, \@argv, json => $json, dry_run => $dry, replace => $replace,
        other => ($resume || $any || defined $vm || $forget))
        if $op eq 'define' || $op eq 'show-definition';
    return usage('--replace is only for define') if $replace;
    return usage("unknown operation '$op'") unless grep { $_ eq $op } HPS::Workload::ops();
    my ($disk, $size);
    if ($op eq 'grow-disk') {
        return usage('grow-disk takes the VM as an argument, not --vm') if defined $vm;
        return usage('grow-disk needs <vm> <disk> <new size>') unless @argv == 3;
        ($vm, $disk, $size) = splice(@argv, 0, 3);
    }
    return usage("$op takes no further arguments") if @argv;
    return usage('--resume is only for create') if $resume && $op ne 'create';
    return usage('--forget is only for destroy') if $forget && $op ne 'destroy';
    return usage("--vm is not for $op") if defined $vm && ($op eq 'create' || $op eq 'destroy');
    return usage('--allow-any-pool-name is only for create and destroy') if $any && $op ne 'create' && $op ne 'destroy';
    my $js = JSON::PP->new->canonical->pretty->allow_nonref;
    my $rc = eval {
        my $wl = HPS::Workload->new(allow_any_pool_name => $any);
        my %a = (vm => $vm, resume => $resume, dry_run => $dry, forget => $forget, disk => $disk, size => $size);
        if ($dry) {
            my $r = $wl->run($op, $name, %a);
            if ($json) { print $js->encode($r) }
            else {
                print "Dry run: $op $name; nothing is sent or changed.\nNode calls:\n"
                    . (@{ $r->{plan} } ? render_plan($r->{plan}) : "  (none)\n");
                print "  note: $_\n" for @{ $r->{notes} // [] };
            }
            return 0;
        }
        my $r = $wl->run($op, $name, %a);
        if ($json) { print $js->encode($r) }
        elsif ($op eq 'status') { print render_status($r) }
        else {
            print render_run($r) . join('', map {"note: $_\n"} @{ $r->{notes} // [] }) . "$op ok: workload $name\n";
            print $r->{forgotten} ? "definition workloads/$name.json removed (--forget)\n"
                : "definition workloads/$name.json kept; create $name runs again from it, destroy --forget removes it\n"
                if $op eq 'destroy';
        }
        return $r->{ok} ? 0 : 1;
    };
    return $rc if defined $rc;
    return fail_exit($@);
}

exit main(@ARGV);
