#!/usr/bin/env perl
# hps-workload: create, start, stop, destroy and inspect a workload (HPS::Workload).
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use HPS::Keysafe;
use HPS::Workload;
use HPS::Workload::Net;
use HPS::Workload::Drain;
use HPS::BootReady;
use HPS::BootWatch;
use HPS::Workload::Report;
use HPS::Log;

# The DHCP and DNS regeneration after a reservation changes (IPS-42 row 5): the
# program hps-onboard forget uses, run as `<cmd> dns-dhcp`; the caller may
# override it (HPS_WORKLOAD_DNS_CMD set to a path, or to the empty string for none).
my $dns_hook = "$RealBin/../scripts/hps-forget-hook.sh";
$ENV{HPS_WORKLOAD_DNS_CMD} = $dns_hook
    if !defined $ENV{HPS_WORKLOAD_DNS_CMD} && -x $dns_hook;

# 0 ok, 1 failed, 2 usage, 3 refused (definition, policy, node refusal), 4 not found;
# drain and undrain also: 5 guests left (HPS::Workload::Drain::EXIT)
my %EXIT = (
    usage => 2, refused => 3, perms => 3,
    malformed => 3, notfound => 4, failed => 1,
);

sub usage {
    my ($msg) = @_;
    print STDERR "hps-workload: $msg\n" if $msg;
    print STDERR <<'USAGE';
Usage:
  hps-workload create  <name> [--resume [--image-written]] [--dry-run] [--json] [--allow-any-pool-name]
  hps-workload start   <name> [--vm <vm>] [--no-boot-wait] [--dry-run] [--json]
  hps-workload stop    <name> [--vm <vm>] [--force] [--dry-run] [--json]
  hps-workload suspend <name> [--vm <vm>] [--dry-run] [--json]
  hps-workload resume  <name> [--vm <vm>] [--dry-run] [--json]
  hps-workload resume-paused <name> [--vm <vm>] [--any-reason] [--dry-run] [--json]
  hps-workload destroy <name> [--forget] [--dry-run] [--json] [--allow-any-pool-name]
  hps-workload status  <name> [--vm <vm>] [--dry-run] [--json]   (per VM: its latest utilisation from the hypervisor)
  hps-workload grow-disk <name> <vm> <disk> <new size> [--dry-run] [--json]
  hps-workload console <name> [--vm <vm>] [--lines N] [--dry-run] [--json]
  hps-workload report  <name> [--vm <vm>] [--no-probe] [--json]   (a VM that will not start: storage, why, last errors; read-only)
  hps-workload define  <name> [--replace] [--dry-run] [--json]   (the JSON definition on stdin)
  hps-workload show-definition <name>
  hps-workload list   [--project <P>] [--json]
  hps-workload set-class <name> <1-4> [--dry-run] [--json]
  hps-workload reserve <name> [--dry-run] [--json]
  hps-workload set <name> [--flavour <F|none>] [--egress <h1,h2|none>] [--dns <wildcard|none>] [--dry-run] [--json]
  hps-workload drain   <host> [--include-nodes] [--dry-run] [--json]
  hps-workload undrain <host> [--dry-run] [--json]
  hps-workload images [--json]
  hps-workload egress [--project <P>] [--json]
start of a VM that boots from the network first waits (cluster key boot_ready_wait_seconds,
default 60 s) for this IPS's DHCP, TFTP and HTTP boot services to answer, and refuses (exit 3)
naming what does not; --no-boot-wait skips that. status shows "no netboot seen since start (N s)"
for such a VM that has not reached iPXE since it was started (docs/BOOT-RELIABILITY.md).
suspend saves each VM's memory to /<pool>/enc/state/<vm>.save on its compute host and
stops it (a long job survives a planned host reboot); resume brings it back where it
left off and removes the file. A 40 GB guest takes about 10 minutes each way. start and
stop of a suspended VM refuse and point to resume; destroy removes the saved state.
resume-paused resumes a guest the hypervisor paused on a disk I/O error (it is a different thing
from resume, which restores a suspended guest from its state file): vm-resume on the compute host,
which first checks that every disk of the guest is healthy again (a mirror assembled with a leg in
sync, a pool ONLINE) and refuses, naming why, when not (exit 3). Without --vm only the paused VMs
of the workload are resumed; with --vm the call is made as asked. A guest paused by an operator is
refused unless --any-reason. The healer does the same by itself for a guest-paused issue.
<name> is the workload: workloads/<name>.json under the cluster's config directory.
create refuses a workload that already exists unless --resume (continue an
unfinished create). destroy removes the instance (VMs, zvols, mirrors, record) and
keeps workloads/<name>.json, so a later create works; destroy --forget also removes
the definition.
grow-disk grows one disk of a VM (a single local zvol, never shrunk) to the new
size, like 64G, and tells the running guest (storage-zvol-grow, vm-disk-resize);
the filesystem inside the guest is grown there (cnh-disk-grow on a CNH).
define checks the JSON on stdin as create checks a definition and writes it to
workloads/<name>.json; an existing definition is replaced only with --replace,
and never while the workload exists (destroy it first). show-definition prints
the stored JSON. A disk whose definition sets no mbps_max gets one derived from the
measured write speed of its storage hosts (cluster key tenant_write_fraction); it
is written into the stored definition with an mbps_max_derived text naming the
source, and printed. An mbps_max in the definition always wins.
report answers, per VM and on one screen, "where is its storage, why will it not start, what were the last errors":
STORAGE first, per disk the mirror name, size and per leg the storage host (name and address), pool, zvol and iSCSI target
name, from the IPS's records alone (so complete with every node off), then the compute host; beside each, only when the node
answers, the live facts (zvol exists, target exported, session, device state, mirror array_state); a node that does not
answer is "not reachable". Then the last failed or refused operation (verb, step, time, the failure line verbatim) and
the open HPS-ISSUEs, the newest error lines with time and source, and the commands to assemble the mirror by hand.
A fact not on record reads "not recorded". It writes nothing and calls only read-only node scripts; --no-probe calls
no node at all. --json carries all of it (docs/WORKLOADS.md "report").
console prints the tail of each VM's serial console log (vm-console-log on its
compute host; read-only), --lines N of it (1-10000, default the node's 200);
with --vm the log alone, else each under a "== <vm> on <host>" heading. Exit 4
when the one VM asked for has no log, 1 when any VM's log could not be read.
A definition may carry "class": 1 core, 2 customer-facing, 3 ordinary (default), 4 batch
and test: what happens to the workload when its host must go down. set-class changes it
in the stored definition and the record of a created workload; nothing on a node changes.
drain empties a compute host before a planned reboot: it marks the host not placeable (host
key drain: create, start and resume refuse it), then handles each running guest, class 4
first: class 4 is stopped, class 3 suspended, class 1 and 2 suspended too (live migration is
not built). A guest that is a cluster node (a registered host, or a network-boot VM) is never
suspended: drain refuses while one runs there, or with --include-nodes stops them last.
undrain resumes what drain suspended and starts what drain stopped (class 1 first), leaves
what was already stopped or suspended, and clears the mark. Exit of drain: 0 drained and
ready for reboot (also when no guest was running), 5 guests still running (NOT ready), 3
refused (nothing changed). Exit of undrain: 0 done or not drained, 5 some guests not brought
back (kept in the record; run it again), 3 refused.
list prints every recorded workload: name, project (from its definition), state, class, compute
host(s), VM count, the first address and created_at; --json gives every address. Addresses
are DHCP leases of the IPS's dnsmasq matched by the VM's MAC (status --json carries them per
VM as addresses: [{net, mac, ip, source}], empty when none). images lists the catalogue
hps-resources/images/*.qcow2 with size, sha256 and date; define refuses an image that is not
in it.
reserve records the DHCP reservation of each NIC of the workload's VMs that holds a lease and has none
(by MAC, the address it has now), moves a reservation to the new MAC of a re-created VM, and
regenerates the IPS's DHCP and DNS files. create, start, stop, suspend and resume do the same for a
NIC that holds a lease; status and list only read, and show a reservation (address ... reserved) or,
for a lease without one, say to run reserve. It touches no VM. destroy keeps the reservations (a create from the same
definition keeps the address); destroy --forget releases them (docs/WORKLOADS.md "DHCP reservation").
set changes exactly three declarative fields of an existing workload's stored definition, which
define --replace cannot (it refuses while the workload exists): flavour, egress (comma list of host
names) and dns (wildcard). none removes a field. The whole new definition is checked as define
checks it; nothing else of the definition or the record changes and no VM is touched. dns takes
effect at once (the IPS's DNS files are regenerated); egress is for lab/egress-allow (the owner's
approved list decides).
egress lists the workloads whose definition declares "egress" hosts, with each one's flavour, state and
addresses (leases); it grants nothing: lab/egress-allow turns it into the egress proxy's per-address allowances,
and only for the hosts lab/egress-approved lists for that flavour (docs/WORKLOADS.md "Egress hosts").
--dry-run prints the node calls (define: checks the definition) and changes nothing.
Exit: 0 ok, 2 usage, 3 refused, 4 not found, 1 failed.
USAGE
    return 2;
}

sub render_plan {
    my ($plan) = @_;
    my $out = '';
    for my $s (@$plan) {
        $out .= "  $s->{n}. [$s->{host}] $s->{script}" . join('', map {" $_"} @{ $s->{args} }) . "\n";
        $out .= "     input: $s->{input}\n" if defined $s->{input};
        $out .= "     $s->{only}\n" if defined $s->{only};
    }
    return $out;
}

sub render_run {
    my ($r) = @_;
    my $out = '';
    for my $s (@{ $r->{steps} }) {
        if ($s->{skipped}) {
            $out .= "== $s->{n}. $s->{script}" . join('', map {" $_"} @{ $s->{args} })
                . ($s->{not_needed} ? " (skipped, not needed)\n" : " (skipped, done earlier)\n");
            next;
        }
        $out .= "== $s->{n}. $s->{script}" . join('', map {" $_"} @{ $s->{args} }) . " (exit $s->{rc})\n";
        $out .= $s->{stdout} . ($s->{stdout} =~ /\n\z/ || !length $s->{stdout} ? '' : "\n");
    }
    return $out;
}

sub render_status {
    my ($r) = @_;
    my $out = "Workload $r->{name}: $r->{state} (class " . ($r->{class} // 'unreadable') . ")\n";
    for my $v (@{ $r->{vms} }) {
        $out .= sprintf("  %-20s host %-14s recorded %-9s node %s%s\n", $v->{vm}, $v->{host} // '-',
            $v->{recorded_state} // '-', $v->{state} . (defined $v->{pause_reason} ? " ($v->{pause_reason})" : ''),
            $v->{ok} ? '' : ' (a node call failed)');
        $out .= "    mirror $_->{name}: $_->{state}\n" for @{ $v->{mirrors} };
        if (my $u = $v->{utilisation}) {
            $out .= sprintf("    utilisation (%s): cpu %s%% rss %s of %s MiB, %s vcpus, disk rd %s wr %s B/s, net rx %s tx %s B/s\n",
                $u->{sampled_at}, map { $_ // '-' } @$u{qw(cpu_pct rss_mib mem_mib vcpus rd_bps wr_bps rx_bps tx_bps)});
        }
        elsif (defined $v->{utilisation_reason}) { $out .= "    utilisation: none ($v->{utilisation_reason})\n" }
        $out .= sprintf("    suspended since %s: memory in %s (%s bytes)\n", $v->{saved_at} // '-', $v->{state_file} // '-', $v->{size_bytes} // '-')
            if ($v->{recorded_state} // '') eq 'suspended';
        $out .= "    seed: $v->{seed}\n" if defined $v->{seed};
        $out .= "    $v->{netboot_note}\n" if defined $v->{netboot_note};
        $out .= "    address $_->{ip} ($_->{net}, $_->{mac}, $_->{source}"
            . ($_->{reserved} ? ', reserved' : defined $_->{reserved_ip} ? ", reserved $_->{reserved_ip}"
                : $_->{source} eq 'dhcp-lease' ? ", not reserved: hps-workload reserve $r->{name}" : '') . ")\n"
            for @{ $v->{addresses} // [] };
    }
    $out .= "  note: $_\n" for @{ $r->{notes} // [] };
    return $out;
}

sub render_console {
    my ($r, $one) = @_;
    my $out = '';
    for my $v (@{ $r->{vms} }) {
        $out .= "== $v->{vm} on " . ($v->{host} // '-') . ($v->{rc} ? " (vm-console-log exit $v->{rc})" : '') . "\n" unless $one;
        $out .= $v->{log} . ($v->{log} =~ /\n\z/ || !length $v->{log} ? '' : "\n");
    }
    return $out;
}

sub fail_exit {
    my ($err) = @_;
    if (ref $err && $err->isa('HPS::Keysafe::Error')) {
        print STDERR 'hps-workload: ' . $err->message . "\n";
        return $EXIT{ $err->kind } // 1;
    }
    $err =~ s/\s+\z//;
    print STDERR "hps-workload: $err\n";
    return 1;
}

# define <name> (the JSON on stdin) and show-definition <name>: the definition
# file itself, no node call.
# The disk write caps define filled in or found (docs/WORKLOADS.md "Resource limits").
sub render_derived {
    my ($r) = @_;
    return join('', map { "  disk $_->{vm}/$_->{disk}: mbps_max " . (defined $_->{mbps_max} ? $_->{mbps_max} : '-') . " ($_->{source})\n" } @{ $r->{derived} // [] });
}

sub definition_verb {
    my ($op, $name, $rest, %o) = @_;
    return usage("$op takes no further arguments") if @$rest;
    return usage("$op takes no --resume, --allow-any-pool-name, --vm or --forget") if $o{other};
    if ($op eq 'show-definition') {
        return usage('show-definition takes no options') if $o{json} || $o{dry_run} || $o{replace};
    }
    my $rc = eval {
        my $wl = HPS::Workload->new;
        if ($op eq 'show-definition') {
            my $text = $wl->show_definition($name);
            print $text, ($text =~ /\n\z/ || !length $text ? '' : "\n");
            return 0;
        }
        binmode STDIN;
        my $text = '';
        my $max = $HPS::Workload::MAX_DEFINITION_BYTES + 1;
        while (length $text < $max) {
            my $got = read(STDIN, $text, $max - length $text, length $text);
            die "cannot read the definition on stdin: $!\n" unless defined $got;
            last if $got == 0;
        }
        my $r = $wl->define($name, $text, replace => $o{replace}, dry_run => $o{dry_run});
        if ($o{json}) { print JSON::PP->new->canonical->pretty->encode($r) }
        elsif ($r->{dry_run}) {
            print "Dry run: define $name; the definition is valid (VMs: " . join(', ', @{ $r->{vms} })
                . "); $r->{path} would be " . ($r->{replaced} ? 'replaced' : 'written') . "; nothing is changed.\n";
        }
        else {
            print 'define ok: workload ' . $name . ' ' . ($r->{replaced} ? 'replaced' : 'defined')
                . " in $r->{path} (VMs: " . join(', ', @{ $r->{vms} }) . ")\n";
        }
        print render_derived($r) unless $o{json};
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

sub catalogue_verb {
    my ($op, $rest, %o) = @_;
    return usage("$op takes no arguments") if @$rest;
    return usage('--dry-run is not for ' . $op) if $o{dry_run};
    return usage('--project is only for list and egress') if defined $o{project} && $op ne 'list' && $op ne 'egress';
    my $js = JSON::PP->new->canonical->pretty;
    my $rc = eval {
        my $wl = HPS::Workload->new;
        if ($op eq 'list') {
            my $rows = HPS::Workload::List::list($wl, project => $o{project});
            print $o{json} ? $js->encode({ workloads => $rows }) : HPS::Workload::List::render_list($rows);
        }
        elsif ($op eq 'egress') {
            my $rows = HPS::Workload::Net::egress_rows($wl, project => $o{project});
            print $o{json} ? $js->encode({ egress => $rows }) : HPS::Workload::Net::render_egress($rows);
        }
        else {
            my $rows = HPS::Workload::List::images($wl->{images_dir});
            print $o{json} ? $js->encode({ images => $rows }) : HPS::Workload::List::render_images($rows);
        }
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

# set-class <name> <1-4>: the class in the definition and the record.
sub class_verb {
    my ($name, $rest, %o) = @_;
    return usage('set-class needs <name> <1-4>') unless @$rest == 1;
    return usage('set-class takes only --dry-run and --json') if $o{other};
    my $rc = eval {
        my $r = HPS::Workload->new->set_class($name, $rest->[0], dry_run => $o{dry_run});
        if ($o{json}) { print JSON::PP->new->canonical->pretty->encode($r) }
        else {
            my $where = join(' and ', ($r->{definition} ? 'the definition' : ()), ($r->{record} ? 'the record' : ()));
            print(($r->{dry_run} ? 'Dry run: set-class' : 'set-class ok:') . " workload $name class "
                . ($r->{was} // 'unreadable') . " -> $r->{class} in $where" . ($r->{dry_run} ? '; nothing is changed' : '') . "\n");
        }
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

# set <name> --flavour/--egress/--dns: the declared network fields of an existing workload.
sub set_verb {
    my ($name, $rest, %o) = @_;
    return usage('set takes only --flavour, --egress, --dns, --dry-run and --json') if @$rest || $o{other};
    my %w;
    $w{flavour} = $o{flavour} eq 'none' ? undef : $o{flavour} if defined $o{flavour};
    $w{egress} = $o{egress} eq 'none' ? undef : [ split /,/, $o{egress}, -1 ] if defined $o{egress};
    if (defined $o{dns}) {
        $w{dns} = $o{dns} eq 'none' ? undef : [ map { $_ eq 'wildcard' ? '*' : $_ } split /,/, $o{dns}, -1 ];
    }
    return usage('set needs at least one of --flavour, --egress, --dns') unless %w;
    my $rc = eval {
        my $wl = HPS::Workload->new;
        my $r = HPS::Workload::Net::set_net($wl, $name, %w, dry_run => $o{dry_run});
        if ($o{json}) { print JSON::PP->new->canonical->pretty->encode($r) }
        else { print HPS::Workload::Net::render_set($r) }
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

# reserve <name>: the DHCP reservations of a workload's NICs (HPS::Workload::Net).
sub reserve_verb {
    my ($name, $rest, %o) = @_;
    return usage('reserve takes only --dry-run and --json') if @$rest || $o{other};
    my $rc = eval {
        my $wl = HPS::Workload->new;
        $wl->definition_path($name);    # the name check
        my $r = HPS::Workload::Net::reserve($wl, $name, dry_run => $o{dry_run});
        if ($o{json}) { print JSON::PP->new->canonical->pretty->encode($r) }
        else { print HPS::Workload::Net::render_reserve($r) }
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

# drain <host> and undrain <host> (HPS::Workload::Drain). The exit status is the
# outcome's; a refusal goes to stderr (and, with --json, the result to stdout).
sub drain_verb {
    my ($op, $host, $rest, %o) = @_;
    return usage("$op takes no further arguments") if @$rest;
    return usage("$op takes only --dry-run and --json" . ($op eq 'drain' ? ' and --include-nodes' : '')) if $o{other};
    return usage('--include-nodes is only for drain') if $o{include_nodes} && $op ne 'drain';
    return usage("$op needs a host: a MAC or a registry hostname") unless $host =~ /\A[A-Za-z0-9][A-Za-z0-9_.:-]*\z/;
    my $rc = eval {
        my $wl = HPS::Workload->new;
        my $r = $op eq 'drain' ? HPS::Workload::Drain::drain($wl, $host, dry_run => $o{dry_run}, include_nodes => $o{include_nodes})
            : HPS::Workload::Drain::undrain($wl, $host, dry_run => $o{dry_run});
        if ($o{json}) { print JSON::PP->new->canonical->pretty->encode($r) }
        else { print HPS::Workload::Drain::render($r) }
        print STDERR "hps-workload: $op $r->{host} refused: $r->{reason}\n" if $r->{outcome} eq 'refused' && !$o{json};
        return $r->{exit};
    };
    return defined $rc ? $rc : fail_exit($@);
}

# report <name>: HPS::Workload::Report (read-only).
sub report_verb {
    my ($name, %o) = @_;
    return usage('report takes only --vm, --no-probe and --json') if @{ $o{rest} } || $o{dry};
    my $rc = eval {
        my $wl = HPS::Workload->new;
        my $reg = $wl->{registry};
        $wl->definition_path($name);    # the name check
        my $rep = HPS::Workload::Report->new(registry => $reg, probe => ($o{no_probe} ? 0 : 1),
            runner => ($o{no_probe} ? undef : $wl->{runner}), log => HPS::Log->new(registry => $reg),
            jobs_dir => $reg->cluster_dir($reg->active_cluster) . '/jobs');
        my $r = $rep->report($name, vm => $o{vm});
        print $o{json} ? JSON::PP->new->canonical->pretty->encode($r) : HPS::Workload::Report::render($r);
        return 0;
    };
    return defined $rc ? $rc : fail_exit($@);
}

sub main {
    my @argv = @_;
    my ($flavour, $egress, $dns);
    my $nopr;
    my ($json, $dry, $resume, $any, $vm, $forget, $replace, $lines, $force, $project, $imgw, $nodes, $nobw, $anyr);
    GetOptionsFromArray(
        \@argv, 'json' => \$json, 'dry-run' => \$dry, 'resume' => \$resume,
        'allow-any-pool-name' => \$any, 'vm=s' => \$vm, 'forget' => \$forget, 'image-written' => \$imgw,
        'replace' => \$replace, 'lines=s' => \$lines, 'force' => \$force, 'project=s' => \$project,
        'include-nodes' => \$nodes,
        'no-boot-wait' => \$nobw, 'no-probe' => \$nopr, 'any-reason' => \$anyr, 'flavour=s' => \$flavour, 'egress=s' => \$egress, 'dns=s' => \$dns,
    ) or return usage();
    my $op   = shift @argv // return usage('operation required');
    if ($op eq 'report') {
        return usage('workload name required') unless @argv;
        my $rname = shift @argv;
        return report_verb($rname, json => $json, vm => $vm, no_probe => $nopr, rest => [@argv], dry => $dry);
    }
    return catalogue_verb($op, \@argv, json => $json, project => $project, dry_run => $dry) if $op eq 'list' || $op eq 'images' || $op eq 'egress';
    my $name = shift @argv // return usage($op eq 'drain' || $op eq 'undrain' ? 'host required' : 'workload name required');
    my $other = ($resume || $any || defined $vm || $forget || $replace || defined $lines || $force || defined $project || $imgw || $anyr);
    return drain_verb($op, $name, \@argv, json => $json, dry_run => $dry, include_nodes => $nodes, other => $other)
        if $op eq 'drain' || $op eq 'undrain';
    return usage('--include-nodes is only for drain') if $nodes;
    return usage('--no-probe is only for report') if $nopr && $op ne 'report';
    return class_verb($name, \@argv, json => $json, dry_run => $dry, other => $other) if $op eq 'set-class';
    return set_verb($name, \@argv, json => $json, dry_run => $dry, flavour => $flavour, egress => $egress, dns => $dns,
        other => ($resume || $any || defined $vm || $forget || $replace || defined $lines || $force || defined $project || $imgw || $anyr))
        if $op eq 'set';
    return usage('--flavour, --egress and --dns are only for set') if defined $flavour || defined $egress || defined $dns;
    return reserve_verb($name, \@argv, json => $json, dry_run => $dry, other => $other) if $op eq 'reserve';
    return definition_verb($op, $name, \@argv, json => $json, dry_run => $dry, replace => $replace,
        other => ($resume || $any || defined $vm || $forget))
        if $op eq 'define' || $op eq 'show-definition';
    return usage('--replace is only for define') if $replace;
    return usage('--lines is only for console') if defined $lines && $op ne 'console';
    return usage('--lines must be a number 1-10000')
        if defined $lines && !($lines =~ /\A[0-9]{1,5}\z/ && $lines >= 1 && $lines <= 10000);
    return usage("unknown operation '$op'") unless grep { $_ eq $op } HPS::Workload::ops();
    my ($disk, $size);
    if ($op eq 'grow-disk') {
        return usage('grow-disk takes the VM as an argument, not --vm') if defined $vm;
        return usage('grow-disk needs <vm> <disk> <new size>') unless @argv == 3;
        ($vm, $disk, $size) = splice(@argv, 0, 3);
    }
    return usage("$op takes no further arguments") if @argv;
    return usage('--resume is only for create') if $resume && $op ne 'create';
    return usage('--image-written is only for create --resume') if $imgw && !($op eq 'create' && $resume);
    return usage('--forget is only for destroy') if $forget && $op ne 'destroy';
    return usage('--force is only for stop') if $force && $op ne 'stop';
    return usage('--no-boot-wait is only for start') if $nobw && $op ne 'start';
    return usage('--any-reason is only for resume-paused') if $anyr && $op ne 'resume-paused';
    return usage("--vm is not for $op") if defined $vm && ($op eq 'create' || $op eq 'destroy');
    return usage('--allow-any-pool-name is only for create and destroy') if $any && $op ne 'create' && $op ne 'destroy';
    my $js = JSON::PP->new->canonical->pretty->allow_nonref;
    my $rc = eval {
        my $wl = HPS::Workload->new(allow_any_pool_name => $any);
        my %a = (vm => $vm, resume => $resume, dry_run => $dry, forget => $forget, image_written => $imgw, disk => $disk, size => $size, lines => $lines, force => $force, any_reason => $anyr);
        if ($dry) {
            my $r = $wl->run($op, $name, %a);
            if ($json) { print $js->encode($r) }
            else {
                print "Dry run: $op $name; nothing is sent or changed.\nNode calls:\n"
                    . (@{ $r->{plan} } ? render_plan($r->{plan}) : "  (none)\n");
                print "  note: $_\n" for @{ $r->{notes} // [] };
            }
            return 0;
        }
        # Gated: a VM that boots from the network and from THIS IPS (a NIC on the provisioning
        # net). A nested cluster's VM on a fabric net netboots from its own IPS: not gated.
        if ($op eq 'start' && !$nobw
            && HPS::BootWatch::netboot_vms(eval { $wl->load($name) } // {}, $vm, HPS::BootWatch->new(registry => $wl->{registry})->_layout)) {
            my $g = HPS::BootReady::gate();
            print STDERR "hps-workload: $_\n" for @{ $g->{warnings} };
            if (!$g->{ok}) {
                # the event is also the terminal line (the workload logger prints its text)
                $wl->_event('notice', $name, 'refused', "start $name refused: $g->{message}");
                return $EXIT{refused};
            }
        }
        my $r = $wl->run($op, $name, %a);
        HPS::BootWatch->annotate_status($wl, $name, $r) if $op eq 'status';
        if ($json) { print $js->encode($r) }
        elsif ($op eq 'status') { print render_status($r) }
        elsif ($op eq 'console') {
            print render_console($r, defined $vm);
            print STDERR "hps-workload: console $name: $_->{vm} on " . ($_->{host} // '-') . ": $_->{error}\n"
                for grep { $_->{rc} } @{ $r->{vms} };
            return $r->{rc};
        }
        else {
            print render_run($r) . join('', map {"note: $_\n"} @{ $r->{notes} // [] });
            if ($r->{pending}) {
                print "$op INCOMPLETE: workload $name is partly destroyed; run destroy $name again when the storage host is back\n";
                return 1;
            }
            print "$op ok: workload $name\n";
            print $r->{forgotten} ? "definition workloads/$name.json removed (--forget)\n"
                : "definition workloads/$name.json kept; create $name runs again from it, destroy --forget removes it\n"
                if $op eq 'destroy';
        }
        return $r->{ok} ? 0 : 1;
    };
    return $rc if defined $rc;
    return fail_exit($@);
}

exit main(@ARGV);
