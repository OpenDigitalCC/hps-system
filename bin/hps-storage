#!/usr/bin/env perl
# hps-storage: drive a node's storage role over ctrl-exec (HPS::Storage).
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use HPS::Registry;
use HPS::Keysafe;
use HPS::Storage;

# 0 ok, 1 failed, 2 usage, 3 refused (policy, node refusal), 4 not found
# operations that take arguments, and how many
my %ZVOL_OPS = ('zvol-create' => 2, 'zvol-destroy' => 1, 'zvol-list' => 0, 'export' => 1, 'unexport' => 1);
my %EXIT = (
    usage => 2, refused => 3, perms => 3,
    malformed => 3, notfound => 4, failed => 1,
);

sub usage {
    my ($msg) = @_;
    print STDERR "hps-storage: $msg\n" if $msg;
    print STDERR <<'USAGE';
Usage:
  hps-storage <host> up|down|trim-check|status [--dry-run] [--json] [--wait SECONDS]
  hps-storage <host> create <pool> --disk <by-id> --disk <by-id> [--disk <by-id>]... [--wipe]
      [--dry-run] [--json] [--allow-any-pool-name]
  hps-storage <host> destroy <pool> [--dry-run] [--json] [--allow-any-pool-name]
  hps-storage <host> zvol-create <pool>/enc/[vm/]<name> <size> [--dry-run] [--json]
  hps-storage <host> zvol-destroy <pool>/enc/[vm/]<name> [--dry-run] [--json] [--allow-any-pool-name]
  hps-storage <host> zvol-list [--json]
  hps-storage <host> export <pool>/enc/[vm/]<name> --iqn <iqn> --initiator <iqn> [--portal <ip>] [--dry-run] [--json]
  hps-storage <host> unexport <iqn> [--dry-run] [--json]
  hps-storage <host> forget-key [--yes] [--dry-run] [--json]
<host> is a MAC (any format) or a registry HOSTNAME. The pool is named after
the active cluster; any other name needs --allow-any-pool-name.
create makes one mirror of 2 to 4 disks (by-id names, with or without
/dev/disk/by-id/) on an assigned host; a disk that carries a pool label or a
signature is refused unless --wipe, which wipes exactly the named disks. A size is
like 1G (K, M, G, T). export records the target in the host's storage_exports
(portal defaults to the host's registry IP); up exports every recorded target again.
--dry-run prints the node calls and redacted inputs and changes nothing.
Exit: 0 ok, 2 usage, 3 refused, 4 not found, 1 failed.
USAGE
    return 2;
}

sub render_plan {
    my ($plan) = @_;
    my $out = '';
    for my $s (@$plan) {
        $out .= "  $s->{n}. $s->{script}" . join('', map {" $_"} @{ $s->{args} }) . "\n";
        $out .= "     input: $s->{input}\n" if defined $s->{input};
    }
    return $out;
}

sub render_run {
    my ($r) = @_;
    my $out = '';
    for my $s (@{ $r->{steps} }) {
        $out .= "== $s->{n}. $s->{script}" . join('', map {" $_"} @{ $s->{args} }) . " (exit $s->{rc})\n";
        $out .= $s->{stdout} . ($s->{stdout} =~ /\n\z/ || !length $s->{stdout} ? '' : "\n");
    }
    return $out . "$r->{op} ok: host $r->{mac}, pool $r->{pool}\n";
}

sub main {
    my @argv = @_;
    my ($json, $dry, $any, $yes, $wait, $iqn, $initiator, $portal, @disks, $wipe);
    GetOptionsFromArray(
        \@argv, 'json' => \$json, 'dry-run' => \$dry, 'allow-any-pool-name' => \$any,
        'yes' => \$yes, 'wait=i' => \$wait, 'iqn=s' => \$iqn, 'initiator=s' => \$initiator, 'portal=s' => \$portal,
        'disk=s' => \@disks, 'wipe' => \$wipe,
    ) or return usage();
    my $host = shift @argv // return usage('host required');
    my $op   = shift @argv // return usage('operation required');
    my $js   = JSON::PP->new->canonical->pretty->allow_nonref;
    my $needs_pool = $op =~ /^(?:create|destroy)$/;
    return usage("unknown operation '$op'") unless $needs_pool || $ZVOL_OPS{$op} || $op eq 'forget-key' || grep { $_ eq $op } HPS::Storage::ops();
    my ($pool, %opt);
    if ($needs_pool) {
        return usage("$op needs a pool name") unless @argv == 1;
        $pool = shift @argv;
    }
    elsif ($ZVOL_OPS{$op}) {
        my $n = $ZVOL_OPS{$op};
        return usage("$op needs $n argument" . ($n == 1 ? '' : 's')) unless @argv == $n;
        if ($op eq 'unexport') { $opt{iqn} = shift @argv }
        elsif ($n) { $opt{dataset} = shift @argv }
        $opt{size} = shift @argv if $op eq 'zvol-create';
    }
    return usage('--iqn, --initiator and --portal are only for export') if $op ne 'export' && (defined $iqn || defined $initiator || defined $portal);
    if ($op eq 'export') {
        return usage('export needs --iqn and --initiator') unless defined $iqn && defined $initiator;
        @opt{qw(iqn initiator)} = ($iqn, $initiator);
        $opt{portal} = $portal if defined $portal;
    }
    return usage("$op takes no further arguments") if @argv;
    return usage('--allow-any-pool-name is only for create, destroy and zvol-destroy') if $any && !$needs_pool && $op ne 'zvol-destroy';
    return usage('--disk and --wipe are only for create') if $op ne 'create' && (@disks || $wipe);
    if ($op eq 'create') {
        $opt{disks} = [@disks];
        $opt{wipe} = $wipe ? 1 : 0;
    }
    return usage('--yes is only for forget-key') if $yes && $op ne 'forget-key';
    return usage('--wait must be 0 or more seconds') if defined $wait && $wait < 0;

    my $rc = eval {
        my $st = HPS::Storage->new(host => $host, pool => $pool, allow_any_pool_name => $any, wait => $wait // 0);
        if ($op eq 'forget-key') {
            my $r = $st->forget_key(yes => $yes, dry_run => $dry);
            print $json ? $js->encode($r) : $dry
                ? ($r->{had_key} ? "Dry run: would delete the 'enc' key of host " . $st->mac . "\n" : "Dry run: no key held\n")
                : ($r->{forgot} ? "Deleted the 'enc' key of host " . $st->mac . "\n" : "No key held for host " . $st->mac . "\n");
            return 0;
        }
        my $plan = $st->plan($op, %opt);
        if ($dry) {
            if ($json) {
                print $js->encode({ dry_run => 1, op => $op, mac => $st->mac, pool => $st->pool, plan => $plan });
            }
            else {
                print "Dry run: $op on host " . $st->mac . ", pool " . $st->pool . "; nothing is sent or changed.\n";
                print "Node calls:\n" . (@$plan ? render_plan($plan) : "  (none)\n");
            }
            return 0;
        }
        my $r = $st->run($op, %opt);
        print $json ? $js->encode($r) : render_run($r);
        return 0;
    };
    return $rc if defined $rc;
    my $err = $@;
    if (ref $err && $err->isa('HPS::Keysafe::Error')) {
        print STDERR 'hps-storage: ' . $err->message . "\n";
        return $EXIT{ $err->kind } // 1;
    }
    $err =~ s/\s+\z//;
    print STDERR "hps-storage: $err\n";
    return 1;
}

exit main(@ARGV);
