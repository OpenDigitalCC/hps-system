#!/usr/bin/env perl
# hps-jobs: the IPS root job runner (ADR 0006). Takes job files that the web
# user wrote into <cluster>/jobs/new/, runs each from a fixed command table
# (an argument list, never a shell) and writes the result into done/ or failed/.
# Two lanes, one job at a time in each (HPS::Jobs::lane_of): 'pairing' (the
# pairing-* kinds) and 'work' (everything else, oldest first as before). A
# pairing approval therefore never waits behind a long storage-up, net-up or
# workload job. Runs under supervisor as root (program:hps-jobs).
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use POSIX qw(WNOHANG);
use Time::HiRes qw(sleep time);
use HPS::Jobs;

$| = 1;
umask 002;

sub log_line {
    my ($level, $msg) = @_;
    print "hps-jobs: $level: $msg\n";
    return;
}

sub usage {
    print STDERR <<'USAGE';
Usage: hps-jobs [--once] [--interval SECONDS] [--dir JOBS_DIR]
Runs queued privileged jobs. Without --once it polls new/ until stopped.
Kinds: pairing-window-open [seconds], pairing-window-close, pairing-list,
pairing-approve <reqid> [--replace], storage-up|down|trim-check|status <mac>, net-up <mac>,
osvc-deliver <mac>,
workload-create <name> [--resume], workload-start|stop|status <name> [--vm <vm>],
pins-prune [--keep-previous N] [--dry-run].
Environment: HPS_JOBS_DIR, CTRL_EXEC_DISPATCHER, HPS_STORAGE_CMD, HPS_WORKLOAD_CMD, HPS_PINS_CMD, HPS_NODE_CMD,
HPS_OSVC_CMD.
USAGE
    return 2;
}

sub read_capped {
    my ($file, $cap) = @_;
    open(my $fh, '<:raw', $file) or return '';
    my $text = '';
    read($fh, $text, $cap + 1);
    close $fh;
    return $text;
}

# start_argv(\@argv, $timeout, $workdir, $id): fork/exec with stdout and stderr
# in files (a daemonising child cannot hold the runner on a pipe). Returns a
# handle for poll_argv; a failed fork is a handle that is already finished.
sub start_argv {
    my ($argv, $timeout, $dir, $id) = @_;
    my $h = { outf => "$dir/.$id.out", errf => "$dir/.$id.err", timeout => $timeout, end => time + $timeout };
    my $pid = fork();
    unless (defined $pid) {
        $h->{done} = [ 127, '', "fork failed: $!\n" ];
        return $h;
    }
    if (!$pid) {
        open(STDIN,  '<', '/dev/null') or exit 126;
        open(STDOUT, '>', $h->{outf})  or exit 126;
        open(STDERR, '>', $h->{errf})  or exit 126;
        { exec { $argv->[0] } @$argv; }
        print STDERR "cannot run $argv->[0]: $!\n";
        exit 127;
    }
    $h->{pid} = $pid;
    return $h;
}

# poll_argv($h): undef while the command runs; then [$exit, $stdout, $stderr]
# (124 when it outlived its timeout and was killed).
sub poll_argv {
    my ($h) = @_;
    return $h->{done} if $h->{done};
    my ($status, $timed_out);
    my $w = waitpid($h->{pid}, WNOHANG);
    if    ($w == $h->{pid}) { $status = $? }
    elsif ($w < 0)          { $status = 255 << 8 }
    elsif (time >= $h->{end}) {
        $timed_out = 1;
        kill 'TERM', $h->{pid};
        sleep 2;
        kill 'KILL', $h->{pid} if waitpid($h->{pid}, WNOHANG) == 0;
        waitpid($h->{pid}, 0);
    }
    else { return undef }
    my $exit = $timed_out ? 124 : ($status & 127) ? 128 + ($status & 127) : $status >> 8;
    my $out  = read_capped($h->{outf}, $HPS::Jobs::OUTPUT_CAP);
    my $err  = read_capped($h->{errf}, $HPS::Jobs::OUTPUT_CAP);
    $err .= "timed out after $h->{timeout}s\n" if $timed_out;
    unlink $h->{outf}, $h->{errf};
    $h->{done} = [ $exit, $out, $err ];
    return $h->{done};
}

# run_argv(\@argv, $timeout, $workdir, $id): start_argv and wait for it.
# Returns ($exit, $stdout, $stderr).
sub run_argv {
    my $h = start_argv(@_);
    my $r;
    sleep 0.1 until ($r = poll_argv($h));
    return @$r;
}

# dispatcher_supports_replace: the usage text lists approve --replace (0.14.3+).
sub dispatcher_supports_replace {
    my ($ced, $dir) = @_;
    my (undef, $out, $err) = run_argv([ $ced, '--help' ], 20, $dir, 'probe');
    return ("$out$err" =~ /--replace/) ? 1 : 0;
}

# start_job: the job's command, started (a handle for poll_argv).
sub start_job {
    my ($jobs, $job, $env) = @_;
    my @args = @{ $job->{args} };
    if ($job->{kind} eq 'pairing-approve' && @args == 2 && !dispatcher_supports_replace($env->{dispatcher}, $jobs->sub_dir('run'))) {
        log_line(info => "job $job->{id}: dispatcher has no approve --replace; approving without it");
        pop @args;
    }
    my @argv = HPS::Jobs::command($job->{kind}, \@args, %$env);
    return start_argv(\@argv, HPS::Jobs::timeout_for($job->{kind}), $jobs->sub_dir('run'), $job->{id});
}

# take_one($jobs, $name, $env, $lane): claim new/<name> and start it. Returns
# ($entry, $taken): $entry the running {job, h, t0, lane}, undef when nothing
# runs; $taken false only when the file could not be claimed (a refused job is
# taken and finished at once).
sub take_one {
    my ($jobs, $name, $env, $lane) = @_;
    my ($job, $problem) = $jobs->claim($name);
    unless ($job) {
        log_line(error => "cannot take $name: $problem");
        return (undef, 0);
    }
    if (defined $problem) {
        log_line(error => "job $job->{id}: refused: $problem");
        $jobs->finish($job, exit => 2, stdout => '', stderr => "refused: $problem\n");
        return (undef, 1);
    }
    log_line(info => "job $job->{id}: start lane=$lane kind=$job->{kind} args=[" . join(' ', @{ $job->{args} }) . "] requested_by=" . ($job->{requested_by} // '?'));
    my $h = eval { start_job($jobs, $job, $env) } // { done => [ 127, '', "runner error: $@" ] };
    return ({ job => $job, h => $h, t0 => time, lane => $lane }, 1);
}

# reap($jobs, $running): finish the entries whose command has ended; returns
# the lanes that are still busy.
sub reap {
    my ($jobs, $running) = @_;
    for my $lane (sort keys %$running) {
        my $e = $running->{$lane};
        my $r = poll_argv($e->{h}) or next;
        my ($exit, $out, $err) = @$r;
        my $dur  = sprintf('%.1f', time - $e->{t0});
        my $dest = $jobs->finish($e->{job}, exit => $exit, stdout => $out, stderr => $err, duration => $dur);
        log_line(info => "job $e->{job}{id}: end lane=$lane kind=$e->{job}{kind} exit=$exit duration=${dur}s result=$dest");
        delete $running->{$lane};
    }
    return keys %$running;
}

# schedule($jobs, $env, $running): start the oldest pending job of every idle
# lane. Returns the number of jobs taken (started, or refused at once).
sub schedule {
    my ($jobs, $env, $running) = @_;
    my $n = 0;
    for my $name ($jobs->pending) {
        my $lane = HPS::Jobs::lane_of($jobs->peek_kind($name));
        next if $running->{$lane};
        my ($e, $taken) = take_one($jobs, $name, $env, $lane);
        $n++ if $taken;
        $running->{$lane} = $e if $e;
        last if keys %$running == @{ [ HPS::Jobs::lanes() ] };
    }
    return $n;
}

# recover_stale: a job left in run/ by a dead runner is failed, never re-run.
sub recover_stale {
    my ($jobs) = @_;
    for my $name ($jobs->stale_run) {
        my ($fid) = $name =~ /-([0-9a-f]{8})\.json$/;
        my $job = { id => $fid, kind => undef, file => $name };
        my $text = read_capped($jobs->sub_dir('run') . "/$name", 4096);
        $job->{kind} = $1 if defined $text && $text =~ /"kind"\s*:\s*"([a-z-]+)"/;
        $jobs->finish($job, exit => 125, stdout => '', stderr => "stale: found in run/ at runner start; the runner stopped while this job was running, it was not re-run\n");
        log_line(warn => "job $fid: stale run/ entry at startup moved to failed/");
    }
    return;
}

sub main {
    my @argv = @_;
    my ($once, $interval, $dir) = (0, 0.5);
    GetOptionsFromArray(\@argv, 'once' => \$once, 'interval=f' => \$interval, 'dir=s' => \$dir) or return usage();
    return usage() if @argv;
    my %opt = defined $dir ? (dir => $dir) : ();
    my $jobs = eval { HPS::Jobs->new(%opt) };
    unless ($jobs) {
        log_line(error => "cannot locate the job queue: $@");
        return 1;
    }
    eval { $jobs->ensure_dirs; 1 } or do { log_line(error => $@); return 1 };
    my $env = {
        dispatcher => $ENV{CTRL_EXEC_DISPATCHER} // 'ctrl-exec-dispatcher',
        storage    => $ENV{HPS_STORAGE_CMD} // "$RealBin/hps-storage",
        workload   => $ENV{HPS_WORKLOAD_CMD} // "$RealBin/hps-workload",
        pins       => $ENV{HPS_PINS_CMD} // "$RealBin/hps-pins",
        node       => $ENV{HPS_NODE_CMD} // "$RealBin/hps-node",
        osvc       => $ENV{HPS_OSVC_CMD} // "$RealBin/hps-osvc",
    };
    log_line(info => 'started; queue ' . $jobs->dir);
    recover_stale($jobs);
    my $stop = 0;
    $SIG{TERM} = $SIG{INT} = sub { $stop = 1 };
    my $last_prune = 0;
    my %running;    # lane => {job, h, t0, lane}
    while (1) {
        reap($jobs, \%running);
        my $started = $stop ? 0 : schedule($jobs, $env, \%running);
        my @busy = keys %running;
        # Stopping: no new job is taken; a running one is waited for.
        last if $stop && !@busy;
        if ($once) {
            last if !@busy && !$started;
            sleep 0.05;
            next;
        }
        if (time - $last_prune > 3600) {
            my $n = $jobs->prune(7);
            log_line(info => "pruned $n old result file(s)") if $n;
            $last_prune = time;
        }
        # While a job runs, look at the queue (and the job) often: a pairing
        # job queued behind it in another lane starts at once.
        sleep(@busy ? ($interval < 0.1 ? $interval : 0.1) : $interval);
    }
    log_line(info => 'stopped');
    return 0;
}

exit main(@ARGV);
