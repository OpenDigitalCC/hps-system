#!/usr/bin/env perl
# hps-starter: the IPS's stock starter and package repository per OS, as plain
# files (HPS::Starter, docs/STARTER.md). IPS tool.
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib/perl";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use HPS::Starter;

my %EXIT = (usage => 2, refused => 3, notfound => 4, failed => 1);

sub usage {
    my ($msg) = @_;
    print STDERR "hps-starter: $msg\n" if $msg;
    print STDERR <<'USAGE';
Usage:
  hps-starter sync <os> [--release VERSION] [--proxy http://HOST:PORT] [--packages FILE]
                        [--store-paths FILE] [--resources DIR]
  hps-starter list [--json] [--resources DIR]
  hps-starter verify [<os> [--release VERSION]] [--resources DIR]
sync fills <resources>/starter/<os>/<version>/ (the distribution's own netboot
kernel and initramfs) and <resources>/packages/<os>/<version>/ (the package
repository) from upstream, through the proxy: --proxy, else the cluster key
egress_proxy, else direct. Files already present with the recorded size and
sha256 are kept; everything else is fetched to a temporary name, checked and
renamed. An upstream that refuses is reported with its host name and exit 1.
  --release       the OS release (default: nixos 26.05)
  --packages      the package list (default: lib/starter/<os>.packages)
  --store-paths   the release's store path list, plain text or .xz, instead of
                  fetching store-paths.xz (needed when xz is not installed)
list shows what is synced; verify reads every recorded file back against the
manifest (size and sha256).
Last line: SYNCED <os> <version> release=<id> ... | VERIFY ok|failed ...
Exit: 0 ok, 1 failed (upstream, or a file that does not verify), 2 usage,
3 refused (alpine: not yet implemented), 4 nothing synced.
USAGE
    return 2;
}

sub human {
    my ($n) = @_;
    return $n >= 1048576 ? sprintf('%.1f MiB', $n / 1048576) : sprintf('%d B', $n);
}

sub main {
    my @argv = @_;
    my $cmd = shift @argv // return usage('command required');
    my ($release, $proxy, $packages, $store_paths, $resources, $json, $help);
    GetOptionsFromArray(\@argv, 'release=s' => \$release, 'proxy=s' => \$proxy, 'packages=s' => \$packages,
        'store-paths=s' => \$store_paths, 'resources=s' => \$resources, 'json' => \$json, 'help|h' => \$help)
        or return usage();
    if ($help || $cmd eq 'help') { usage(); return 0 }
    my $rc = eval {
        if ($cmd eq 'sync') {
            return usage('sync needs one OS') unless @argv == 1;
            my $os = $argv[0];
            if (!defined $proxy) {
                # The cluster key egress_proxy; no cluster (or no key) means direct.
                $proxy = eval {
                    require HPS::Registry;
                    my $r = HPS::Registry->new;
                    $r->cluster_get($r->active_cluster, 'egress_proxy');
                };
                $proxy = undef if defined $proxy && !length $proxy;
            }
            my $s = HPS::Starter->new(resources => $resources, proxy => $proxy, store_paths => $store_paths,
                packages => $packages // "$RealBin/../lib/starter/$os.packages");
            my $r = $s->sync($os, $release);
            printf "SYNCED %s %s release=%s starter(files=%d fetched=%d reused=%d bytes=%d) repository(paths=%d files=%d fetched=%d reused=%d bytes=%d)\n",
                $r->{os}, $r->{version}, $r->{release}, @{ $r->{starter} }{qw(files fetched reused bytes)},
                @{ $r->{repo} }{qw(paths files fetched reused bytes)};
            return 0;
        }
        elsif ($cmd eq 'list') {
            return usage('list takes no arguments') if @argv;
            my @l = HPS::Starter->new(resources => $resources)->list;
            if ($json) { print JSON::PP->new->canonical->pretty->encode(\@l); return 0 }
            if (!@l) { print "Nothing synced.\n"; return 0 }
            printf "%-11s %-8s %-8s %-30s %6s %12s %s\n", qw(KIND OS VERSION RELEASE FILES SIZE SYNCED);
            printf "%-11s %-8s %-8s %-30s %6d %12s %s\n", @$_{qw(kind os version release files)}, human($_->{bytes}), $_->{synced_at} // '-' for @l;
            return 0;
        }
        elsif ($cmd eq 'verify') {
            return usage('verify takes an OS at most') if @argv > 1;
            my $res = HPS::Starter->new(resources => $resources)->verify($argv[0], $release);
            my $bad = 0;
            for my $v (@$res) {
                if (@{ $v->{bad} }) {
                    $bad++;
                    print "FAIL $v->{kind} $v->{os} $v->{version}: $_\n" for @{ $v->{bad} };
                }
                else { print "ok   $v->{kind} $v->{os} $v->{version} release=$v->{release} files=$v->{files}\n" }
            }
            print "VERIFY " . ($bad ? 'failed' : 'ok') . " sets=" . scalar(@$res) . " bad=$bad\n";
            return $bad ? 1 : 0;
        }
        return usage("unknown command '$cmd'");
    };
    return $rc if defined $rc;
    my $err = $@;
    if (ref $err && $err->can('message')) {
        print STDERR 'hps-starter: ' . $err->message . "\n";
        return $EXIT{ $err->kind } // 1;
    }
    print STDERR "hps-starter: $err";
    return 1;
}

exit main(@ARGV);
