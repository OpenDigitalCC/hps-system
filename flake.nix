{
  # HPS NixOS node systems: the audit image and the netboot node profiles.
  #
  # Built by nix/build.sh inside the builder container (lab/builder). Each
  # package output is the netboot artefact set for one profile: bzImage, initrd
  # (kernel initrd + compressed squashfs store) and boot.json (init= store path,
  # base cmdline, nixpkgs rev). The IPS appends hps.ips= hps.mac= hps.profile=.
  #
  # NO SECRET OF ANY KIND IS PLACED IN THESE IMAGES: one image per profile,
  # per-node identity comes from the registry at boot (plans/phase-1.md §2).
  #
  # flake.lock is not committed yet: it is generated by `nix flake lock` in the
  # builder (this repository is written on a host without nix). See
  # lab/builder/README.md for the ctrl-exec input override.
  description = "HPS NixOS node systems: audit image and netboot node profiles";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    # Override for a local checkout:
    #   nix build --override-input ctrl-exec path:/ctrl-exec .#node-base
    ctrl-exec = {
      url = "github:OpenDigitalCC/ctrl-exec";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, ctrl-exec }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      lib = nixpkgs.lib;

      # Profile name -> the modules that distinguish it from hps-common.
      profiles = {
        audit = [ ./nix/modules/hps-audit.nix ];
        node-base = [ ./nix/modules/hps-node.nix ];
        node-converged = [ ./nix/modules/profiles/converged.nix ];
      };

      # The platform is set once, in hps-common.nix (nixpkgs.hostPlatform).
      mkSystem = name: extra: lib.nixosSystem {
        specialArgs = { inherit ctrl-exec; hpsProfile = name; };
        modules = [ ./nix/modules/hps-common.nix ] ++ extra;
      };

      # The netboot artefact set for one built system. boot.json carries only
      # build-determined facts; build.sh adds built_at and pin when it copies
      # the set out of the store.
      netbootArtefacts = name: nixos:
        let
          cfg = nixos.config;
          bootJson = pkgs.writeText "hps-boot-${name}.json" (builtins.toJSON {
            kernel = "bzImage";
            initrd = "initrd";
            init = "${cfg.system.build.toplevel}/init";
            # initrd=initrd names the iPXE initrd image for the EFI stub, as
            # the nixpkgs netboot.ipxe does.
            cmdline = "initrd=initrd " + toString cfg.boot.kernelParams;
            nixpkgs_rev = nixpkgs.rev or "dirty";
            nixos_version = cfg.system.nixos.release;
            profile = name;
          });
        in
        pkgs.runCommand "hps-netboot-${name}"
          { passthru = { toplevel = cfg.system.build.toplevel; }; }
          ''
            mkdir -p "$out"
            ln -s ${cfg.system.build.kernel}/${cfg.system.boot.loader.kernelFile} "$out/bzImage"
            ln -s ${cfg.system.build.netbootRamdisk}/${cfg.system.boot.loader.initrdFile} "$out/initrd"
            cp ${bootJson} "$out/boot.json"
          '';
    in
    {
      nixosConfigurations = lib.mapAttrs mkSystem profiles;

      packages.${system} =
        lib.mapAttrs (name: _: netbootArtefacts name self.nixosConfigurations.${name}) profiles
        // { default = self.packages.${system}.node-base; };
    };
}
