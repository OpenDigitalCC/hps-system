{
  # HPS NixOS node systems: the audit image and the netboot node profiles.
  #
  # Built by nix/build.sh inside the builder container (lab/builder). Each
  # package output is the netboot artefact set for one profile: bzImage, initrd
  # (kernel initrd + compressed squashfs store) and boot.json (init= store path,
  # base cmdline, nixpkgs rev); the audit image also firmware.cpio, its
  # firmware layer (nix/pkgs/hps-firmware-layer.nix). The IPS appends hps.ips=
  # hps.mac= hps.profile=.
  #
  # NO SECRET OF ANY KIND IS PLACED IN THESE IMAGES: one image per profile,
  # per-node identity comes from the registry at boot (plans/phase-1.md §2).
  #
  # flake.lock is not committed yet: it is generated by `nix flake lock` in the
  # builder (this repository is written on a host without nix). See
  # lab/builder/README.md for the ctrl-exec input override.
  description = "HPS NixOS node systems: audit image and netboot node profiles";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    # Override for a local checkout:
    #   nix build --override-input ctrl-exec path:/ctrl-exec .#node-base
    ctrl-exec = {
      url = "github:OpenDigitalCC/ctrl-exec";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # OpenSVC v3 (om3), pinned to the newest release tag (owner ruling
    # 2026-11-09: a current OpenSVC, bumped as releases land). Not in nixpkgs.
    om3-src = {
      url = "github:opensvc/om3/v3.0.0-rc60"; # 4ff6def4972f1975c8eff458765f9cb9b6049717
      flake = false;
    };
    # ctrl-exec agent plugins (nagios-check, check_mem): the node resource
    # monitor (docs/MONITORING.md). Pinned to a release tag, bumped as releases
    # land; the lab builder overrides it with a local export, like ctrl-exec:
    #   nix build --override-input ctrl-exec-plugins path:/ctrl-exec-plugins .#node-base
    ctrl-exec-plugins = {
      url = "github:OpenDigitalCC/ctrl-exec-plugins/v0.3.11";
      flake = false;
    };
  };

  outputs = { self, nixpkgs, ctrl-exec, om3-src, ctrl-exec-plugins }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      lib = nixpkgs.lib;

      # om3 from the pinned source; modules use pkgs.om3 through this overlay.
      om3Overlay = final: _prev: {
        om3 = final.callPackage ./nix/pkgs/om3.nix {
          src = om3-src;
          version = "3.0.0-rc60";
        };
      };

      # Profile name -> the modules that distinguish it from hps-common.
      profiles = {
        audit = [ ./nix/modules/hps-audit.nix ];
        node-base = [ ./nix/modules/hps-node.nix ];
        node-converged = [ ./nix/modules/profiles/converged.nix ];
        # CS-3.11: the container host (role CNH), metal and guest alike.
        node-cnh = [ ./nix/modules/profiles/container-host.nix ];
        # The image builder (role BLD, docs/BUILDER.md).
        node-builder = [ ./nix/modules/profiles/builder.nix ];
      };

      # The platform is set once, in hps-common.nix (nixpkgs.hostPlatform).
      mkSystem = name: extra: lib.nixosSystem {
        specialArgs = { inherit ctrl-exec ctrl-exec-plugins; hpsProfile = name; };
        modules = [ ./nix/modules/hps-common.nix { nixpkgs.overlays = [ om3Overlay ]; } ] ++ extra;
      };

      # The netboot artefact set for one built system. boot.json carries only
      # build-determined facts; build.sh adds built_at and pin when it copies
      # the set out of the store. A profile with a firmware layer (the audit image: system.build
      # .hpsFirmwareLayer) also gets firmware.cpio, and boot.json names it
      # (firmware_layer); build.sh publishes it once under nixos/firmware/
      # and turns that into extra_initrds.
      netbootArtefacts = name: nixos:
        let
          cfg = nixos.config;
          firmwareLayer = cfg.system.build.hpsFirmwareLayer or null;
          bootJson = pkgs.writeText "hps-boot-${name}.json" (builtins.toJSON ({
            kernel = "bzImage";
            initrd = "initrd";
            init = "${cfg.system.build.toplevel}/init";
            # initrd=initrd names the iPXE initrd image for the EFI stub, as
            # the nixpkgs netboot.ipxe does.
            cmdline = "initrd=initrd " + toString cfg.boot.kernelParams;
            nixpkgs_rev = nixpkgs.rev or "dirty";
            nixos_version = cfg.system.nixos.release;
            profile = name;
          } // lib.optionalAttrs (firmwareLayer != null) {
            firmware_layer = "firmware.cpio";
          }));
        in
        pkgs.runCommand "hps-netboot-${name}"
          { passthru = { toplevel = cfg.system.build.toplevel; inherit firmwareLayer; }; }
          (''
            mkdir -p "$out"
            ln -s ${cfg.system.build.kernel}/${cfg.system.boot.loader.kernelFile} "$out/bzImage"
            ln -s ${cfg.system.build.netbootRamdisk}/${cfg.system.boot.loader.initrdFile} "$out/initrd"
            cp ${bootJson} "$out/boot.json"
          '' + lib.optionalString (firmwareLayer != null) ''
            ln -s ${firmwareLayer}/firmware.cpio "$out/firmware.cpio"
          '');

      # iPXE from the pinned nixpkgs, built with exactly the targets the IPS
      # serves (IPS-09): snponly.efi (UEFI, dnsmasq's first chain step),
      # ipxe.efi (UEFI NICs without SNP) and undionly.kpxe (BIOS). The default
      # platform targets are switched off so nothing else is built; firmwareBinary
      # names one of ours because the package asserts it is among the targets.
      # No embedded script and no option beyond the package defaults: the DHCP
      # options chain to boot_manager.sh?cmd=init, and no secret is built in.
      # Secure Boot is out of scope: these binaries are unsigned (docs/IPXE.md).
      ipxeBuilt = pkgs.ipxe.override {
        enableDefaultPlatformTargets = false;
        additionalTargets = {
          "bin-x86_64-efi/snponly.efi" = null;
          "bin-x86_64-efi/ipxe.efi" = null;
          "bin/undionly.kpxe" = null;
        };
        firmwareBinary = "ipxe.efi";
      };

      # <out>/{snponly.efi,ipxe.efi,undionly.kpxe,ipxe.json}; ipxe.json carries
      # the version and file names, build.sh adds the sha256 on publishing.
      ipxeArtefacts =
        let
          ipxeJson = pkgs.writeText "hps-ipxe.json" (builtins.toJSON {
            version = ipxeBuilt.version;
            files = [ "snponly.efi" "ipxe.efi" "undionly.kpxe" ];
            nixpkgs_rev = nixpkgs.rev or "dirty";
          });
        in
        pkgs.runCommand "hps-ipxe-${ipxeBuilt.version}" { passthru = { inherit ipxeBuilt; }; } ''
          mkdir -p "$out"
          for f in snponly.efi ipxe.efi undionly.kpxe; do
            test -s ${ipxeBuilt}/$f
            cp ${ipxeBuilt}/$f "$out/$f"
          done
          cp ${ipxeJson} "$out/ipxe.json"
        '';
    in
    {
      overlays.default = om3Overlay;

      nixosConfigurations = lib.mapAttrs mkSystem profiles;

      packages.${system} =
        lib.mapAttrs (name: _: netbootArtefacts name self.nixosConfigurations.${name}) profiles
        // {
          default = self.packages.${system}.node-base;
          ipxe = ipxeArtefacts;
          om3 = (pkgs.extend om3Overlay).om3;
          # The audit image's firmware layer on its own (size checks:
          # nix path-info -S .#firmware-layer).
          firmware-layer = self.nixosConfigurations.audit.config.system.build.hpsFirmwareLayer;
        };

      # The AppArmor profiles of the compute role, parsed (no kernel load) from
      # the evaluated node-converged configuration, so the check sees exactly
      # the text the node ships. A sample generated per-guest profile exercises
      # the `include if exists <libvirt/<uuid>.files>` route the parser takes
      # when virt-aa-helper loads a guest's profile.
      # One checks.${system} set: a dynamic attribute may be defined only once.
      checks.${system} = {
      # The iPXE outputs build (their derivation fails on a missing or empty target).
      ipxe = ipxeArtefacts;

      apparmor-profiles =
        let
          aa = self.nixosConfigurations.node-converged.config.security.apparmor;
          incDir = pkgs.linkFarm "hps-apparmor-includes"
            (lib.mapAttrsToList (name: path: { inherit name path; }) aa.includes);
          policyFiles = lib.mapAttrsToList (n: p: pkgs.writeText "${n}.profile" p.profile) aa.policies;
        in
        pkgs.runCommand "hps-apparmor-profiles" { nativeBuildInputs = [ pkgs.apparmor-parser ]; } ''
          parse() { apparmor_parser -Q -K -I ${incDir} -I ${pkgs.apparmor-profiles}/etc/apparmor.d "$@"; }
          mkdir -p gen/libvirt
          cat > gen/libvirt/libvirt-00000000-0000-0000-0000-000000000000 <<'EOF'
          #include <tunables/global>
          profile libvirt-00000000-0000-0000-0000-000000000000 flags=(attach_disconnected) {
            #include <abstractions/libvirt-qemu>
            #include if exists <libvirt/libvirt-00000000-0000-0000-0000-000000000000.files>
          }
          EOF
          cat > gen/libvirt/libvirt-00000000-0000-0000-0000-000000000000.files <<'EOF'
            "/dev/md127" rwk,
            "/var/log/libvirt/**/vm.log" w,
          EOF
          for f in ${lib.concatStringsSep " " policyFiles} ${incDir}/libvirt/TEMPLATE.qemu; do
            echo "parsing $f"
            parse "$f"
          done
          echo "parsing sample generated guest profile"
          parse -I gen gen/libvirt/libvirt-00000000-0000-0000-0000-000000000000
          touch $out
        '';
      };
    };
}
