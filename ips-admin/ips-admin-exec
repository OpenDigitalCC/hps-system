#!/bin/bash
#===============================================================================
# ips-admin-exec <tool> [args...]
# -------------------------------
# The one body of every ips-admin agent script. Each ips-admin/<tool> is a
# two-line wrapper that execs this with its own name; the IPS's local ctrl-exec
# agent (ips.<cluster domain>, profile ips-admin) allowlists the wrappers, and
# an operator reaches them through the IPS's own ctrl-exec API (docs/OPERATOR.md).
#
# What it does, in order:
#   1. the tool must be one of the fixed table below (anything else: exit 2);
#   2. every argument must be a conservative token: 1-256 characters of
#      A-Z a-z 0-9 _ . , : = @ + -, no "..", and a "/" only inside an IPv4
#      CIDR (10.0.0.1/24) or, for hps-storage only, in exactly the dataset
#      forms hps-storage itself accepts (<pool>/enc, <pool>/enc/<name>,
#      <pool>/enc/vm/<name>; HPS::Storage $DS_RE); no shell metacharacter,
#      space, quote or newline ever passes, and no argument can name a file. At
#      most 64 arguments;
#   3. a few tools are narrowed to their safe subcommands (hps-bmc: status,
#      list, set, select; hps-monitor: run);
#   4. the tool runs from an empty private directory, as root (the agent's
#      user), with the HPS paths from hps.conf. Its stdin is /dev/null, except
#      for the three input=raw scripts (hps-bmc-credential,
#      hps-cluster-config-apply, hps-workload-define), whose stdin is the run's
#      confidential input.
#      Without input=raw the agent puts the request context (the caller's token
#      included) on stdin: it never reaches a tool;
#   5. one syslog line before (tag ips-admin: tool and arguments, never the
#      input) and one after (the exit status). The tool's own exit status is
#      returned.
#
# The tools validate their own arguments; this is only the gate in front.
# Exit: the tool's status; 2 refused here (unknown tool, bad argument,
# subcommand not open to ips-admin).
#===============================================================================
set -euo pipefail

TOOL="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

log() {
  logger -t ips-admin -p "auth.$1" -- "$2" 2> /dev/null || true
}

refuse() {
  log warning "refused tool=${TOOL:-none}: $1"
  echo "ips-admin: $1" >&2
  exit 2
}

# The HPS paths: the agent hands scripts a minimal environment, so they come
# from hps.conf (the file run-hps.sh and every tool read).
HPS_BASE="${HPS_BASE:-/srv}"
if [[ -r "${HPS_BASE}/hps.conf" ]]; then
  # shellcheck source=/dev/null
  source "${HPS_BASE}/hps.conf"
fi
HPS_SYSTEM_BASE="${HPS_SYSTEM_BASE:-${HPS_BASE}/hps-system}"
export HPS_BASE HPS_SYSTEM_BASE
for v in HPS_CONFIG_BASE HPS_RESOURCES HPS_LOG; do
  if [[ -n "${!v:-}" ]]; then
    export "${v?}"
  fi
done

# tool -> binary, input mode, and the argument shape it is narrowed to.
BIN=""
INPUT=0
PREFIX=()
case "$TOOL" in
  hps-onboard | hps-cluster-config | hps-node | hps-storage | hps-workload | hps-pins | hps-ips-check | hps-osvc | hps-repo)
    BIN="$TOOL" ;;
  hps-bmc)
    BIN=hps-bmc
    case "${1:-}" in
      status | list | set | select) ;;
      *) refuse "hps-bmc: only status, list, set and select are open to ips-admin (the credential goes through hps-bmc-credential)" ;;
    esac ;;
  hps-bmc-credential)
    # hps-bmc credential <host|device:NAME> [--user U]; stdin: the credential.
    BIN=hps-bmc
    INPUT=1
    PREFIX=(credential) ;;
  hps-cluster-config-apply)
    # hps-cluster-config apply - [--dry-run] [--json]; stdin: the key = value lines.
    BIN=hps-cluster-config
    INPUT=1
    PREFIX=(apply -)
    for a in "$@"; do
      case "$a" in
        --dry-run | --json) ;;
        *) refuse "hps-cluster-config-apply takes only --dry-run and --json; the configuration is the input" ;;
      esac
    done ;;
  hps-workload-define)
    # hps-workload define <name> [--dry-run] [--replace] [--json]; stdin: the definition JSON.
    BIN=hps-workload
    INPUT=1
    PREFIX=(define)
    names=0
    for a in "$@"; do
      case "$a" in
        --dry-run | --replace | --json) ;;
        -*) refuse "hps-workload-define takes only --dry-run, --replace and --json; the definition is the input" ;;
        *) names=$((names + 1)) ;;
      esac
    done
    [[ $names -eq 1 ]] || refuse "hps-workload-define takes exactly one workload name" ;;
  hps-monitor)
    BIN=hps-monitor
    [[ "${1:-}" == run ]] || refuse "hps-monitor: only run is open to ips-admin" ;;
  ips-syslog-forward)
    BIN=hps-syslog-forward ;;
  "")
    refuse "no tool named" ;;
  *)
    refuse "unknown tool '${TOOL//[^A-Za-z0-9_.-]/?}'" ;;
esac

if [[ $# -gt 64 ]]; then
  refuse "more than 64 arguments"
fi
TOKEN_RE='^[A-Za-z0-9_.,:=@+-]{1,256}$'
CIDR_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'
# The dataset forms of hps-storage, and nothing broader: <pool>/enc,
# <pool>/enc/<name>, <pool>/enc/vm/<name>. The pool and name parts are those of
# HPS::Storage ($POOL_RE, $DS_RE in lib/perl/HPS/Storage.pm): no leading "/",
# no empty part, no "." in a name, so no "..", "." or other directory.
DATASET_RE='^[a-z][a-z0-9_.-]*/enc(/(vm/)?[A-Za-z0-9_-]+)?$'
n=0
for a in "$@"; do
  n=$((n + 1))
  if [[ "$a" == */* ]]; then
    if [[ "$TOOL" == hps-storage ]]; then
      [[ ${#a} -le 256 && ( "$a" =~ $CIDR_RE || "$a" =~ $DATASET_RE ) ]] ||
        refuse "argument $n: a '/' is accepted only in an IPv4 CIDR or a dataset <pool>/enc[/[vm/]<name>]"
    else
      [[ "$a" =~ $CIDR_RE ]] || refuse "argument $n: a '/' is accepted only in an IPv4 CIDR"
    fi
  elif [[ ! "$a" =~ $TOKEN_RE ]]; then
    refuse "argument $n is not a plain token (letters, digits and _ . , : = @ + - only)"
  fi
  if [[ "$a" == *..* ]]; then
    refuse "argument $n contains '..'"
  fi
done

TOOL_PATH="${HPS_SYSTEM_BASE}/bin/${BIN}"
[[ -x "$TOOL_PATH" ]] || refuse "tool not installed: ${TOOL_PATH}"

WORK="/tmp/ips-admin.$$"
rm -rf -- "$WORK"
mkdir -m 0700 -- "$WORK"
trap 'rm -rf -- "$WORK"' EXIT
cd -- "$WORK"

log info "run tool=${TOOL} args=$*"
rc=0
if [[ $INPUT -eq 1 ]]; then
  "$TOOL_PATH" "${PREFIX[@]}" "$@" || rc=$?
else
  "$TOOL_PATH" "${PREFIX[@]}" "$@" < /dev/null || rc=$?
fi
log info "end tool=${TOOL} exit=${rc}"
exit "$rc"
