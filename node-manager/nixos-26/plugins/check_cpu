#!/usr/bin/env bash
#
# check_cpu - Nagios plugin: CPU usage over one sample interval.
#
# Run by nagios-check (ctrl-exec) on every node. Reads the aggregate "cpu" line
# of /proc/stat twice, INTERVAL seconds apart, and reports each state as a
# percentage of the interval. A usage check, not an alarm: OK unless -w/-c are
# given and the busy percentage reaches them.
#   busy = 100 - idle - iowait
# Output: "CPU OK - 3.2% busy (iowait 0.1%, steal 0.0%) | busy=3.2%;;;0;100
#          user=..% nice=..% system=..% iowait=..% irq=..% softirq=..% steal=..%
#          idle=..% cpus=<n>"
#
# Usage: check_cpu [-i SECONDS] [-w BUSY%] [-c BUSY%]
#   -i  sample interval, 1 to 5 seconds (default 1)
# Environment (tests): HPS_PROC (default /proc), HPS_SLEEP (default sleep).
# Exit: 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN.

set -uo pipefail

# @HPS_PATH@

PROC=${HPS_PROC:-/proc}
SLEEP=${HPS_SLEEP:-sleep}
interval=1
warn=""
crit=""

unknown() {
  echo "CPU UNKNOWN - $1"
  exit 3
}

while getopts "i:w:c:" opt; do
  case $opt in
    i) interval=$OPTARG ;;
    w) warn=$OPTARG ;;
    c) crit=$OPTARG ;;
    *) unknown "usage: check_cpu [-i SECONDS] [-w BUSY%] [-c BUSY%]" ;;
  esac
done
[[ $interval =~ ^[1-5]$ ]] || unknown "-i must be 1 to 5"
[[ -z $warn || $warn =~ ^[0-9]+(\.[0-9]+)?$ ]] || unknown "-w must be a number"
[[ -z $crit || $crit =~ ^[0-9]+(\.[0-9]+)?$ ]] || unknown "-c must be a number"

stat_line() {
  awk '$1 == "cpu" { for (i = 2; i <= 9; i++) printf "%s ", ($i == "" ? 0 : $i); print ""; exit }' "$PROC/stat"
}
cpu_count() {
  awk '$1 ~ /^cpu[0-9]+$/ { n++ } END { print n + 0 }' "$PROC/stat"
}

[[ -r $PROC/stat ]] || unknown "cannot read $PROC/stat"
a=$(stat_line)
[[ -n $a ]] || unknown "no cpu line in $PROC/stat"
"$SLEEP" "$interval"
b=$(stat_line)
[[ -n $b ]] || unknown "no cpu line in $PROC/stat"
cpus=$(cpu_count)

# fields: user nice system idle iowait irq softirq steal
awk -v a="$a" -v b="$b" -v cpus="$cpus" -v w="$warn" -v c="$crit" '
BEGIN {
  split(a, x, " "); split(b, y, " ")
  total = 0
  for (i = 1; i <= 8; i++) { d[i] = y[i] - x[i]; if (d[i] < 0) d[i] = 0; total += d[i] }
  if (total == 0) { print "CPU UNKNOWN - no CPU time elapsed between samples"; exit 3 }
  split("user nice system idle iowait irq softirq steal", n, " ")
  for (i = 1; i <= 8; i++) p[n[i]] = 100 * d[i] / total
  busy = 100 - p["idle"] - p["iowait"]
  if (busy < 0) busy = 0
  state = "OK"; code = 0
  if (w != "" && busy >= w) { state = "WARNING"; code = 1 }
  if (c != "" && busy >= c) { state = "CRITICAL"; code = 2 }
  printf "CPU %s - %.1f%% busy (iowait %.1f%%, steal %.1f%%) | busy=%.1f%%;%s;%s;0;100", state, busy, p["iowait"], p["steal"], busy, w, c
  split("user nice system iowait irq softirq steal idle", o, " ")
  for (i = 1; i <= 8; i++) printf " %s=%.1f%%", o[i], p[o[i]]
  printf " cpus=%d\n", cpus
  exit code
}'
