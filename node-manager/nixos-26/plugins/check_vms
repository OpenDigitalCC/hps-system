#!/usr/bin/env bash
#
# check_vms - Nagios plugin: resource use of the running libvirt guests.
#
# Run by nagios-check (ctrl-exec) on compute nodes. Runs
#   virsh -c qemu:///system domstats --raw --list-running --nowait --cpu-total
#         --balloon --vcpu --block --interface
# ONCE per run and reports per running guest (name lower-cased, characters
# outside [a-z0-9_-] become "_"):
#   <vm>_vcpus     vcpu.current
#   <vm>_rss       balloon.rss in bytes (host memory the guest process uses)
#   <vm>_mem       balloon.current in bytes (memory given to the guest)
# and, against the sample the previous run saved (STATE, below):
#   <vm>_cpu_pct   cpu.time delta / the time between the two runs, in %; 100 is
#                  one full vCPU, so a guest with several vCPUs can exceed 100
#   <vm>_rd_Bps <vm>_wr_Bps   block.N.rd.bytes / wr.bytes summed over its disks
#   <vm>_rx_Bps <vm>_tx_Bps   net.N.rx.bytes / tx.bytes summed over its NICs
# plus vms=<n>. A usage check: always OK when virsh answers; no running guest is
# OK.
#
# One call, not two: a nested libvirtd under I/O load (guests being created on
# the same host) could not answer twice inside nagios-check's 10 s budget
# (IPS-34 item 6: "timed out after 4s" on every TCH while one guest ran). The
# single call gets LIMIT seconds (8); a slower one is UNKNOWN "virsh domstats
# timed out after 8s". The sample (the time and one line per guest) is saved
# in STATE, written atomically, and the next run takes its rates from it. The
# first run, a sample older than MAX_AGE seconds (900, no monitor for a quarter
# of an hour: a reboot or a pause), or one no running guest appears in, gives
# the counts and levels only and says so in the text: "rates: no previous
# sample" / "previous sample too old" / "no guest in the previous sample". A
# guest absent from the previous sample (started since) gets its levels only; a
# counter that went backwards (the guest was restarted under the same name)
# counts as 0.
#
# --nowait: libvirtd does not wait for a guest's state-change lock (held, for
# example, by an earlier domstats it is still answering for a caller that gave
# up); it leaves out the values that need the lock. A label whose value a
# sample lacks is left out for that guest (a rate needs both samples).
# Output: "VMS OK - 2 running VMs (rss 4.0 GiB) | vms=2 <vm>_cpu_pct=..% ..."
#
# Usage: check_vms          (no options)
# Environment (tests): HPS_VIRSH (the virsh command, default virsh),
#   HPS_VMS_STATE (default /run/hps/check_vms.prev), HPS_NOW (epoch seconds,
#   default the clock).
# Exit: 0 OK, 3 UNKNOWN.

set -uo pipefail

# @HPS_PATH@

VIRSH=${HPS_VIRSH:-virsh}
STATE=${HPS_VMS_STATE:-/run/hps/check_vms.prev}
NOW=${HPS_NOW:-$EPOCHREALTIME}
LIMIT=8
MAX_AGE=900

unknown() {
  echo "VMS UNKNOWN - $1"
  exit 3
}

[[ $# -eq 0 ]] || unknown "usage: check_vms (no options)"

# One line per guest: name cpu_ns vcpus rss_kib mem_kib rd wr rx tx, "-" for a
# value the sample did not carry. On failure: the reason, and return 1.
sample() {
  local raw rc
  raw=$(timeout "$LIMIT" "$VIRSH" -c qemu:///system domstats --raw --list-running \
    --nowait --cpu-total --balloon --vcpu --block --interface 2>&1)
  rc=$?
  if (( rc == 124 )); then
    echo "timed out after ${LIMIT}s"
    return 1
  fi
  if (( rc != 0 )); then
    printf 'failed: %s\n' "${raw:-exit $rc}"
    return 1
  fi
  printf '%s\n' "$raw" | awk '
  function flush(  i, out) {
    if (name != "") { out = name; for (i = 2; i <= 9; i++) out = out " " v[i]; print out }
    name = ""; for (i = 2; i <= 9; i++) v[i] = "-"
  }
  function add(i, x) { v[i] = (v[i] == "-") ? x + 0 : v[i] + x }
  BEGIN { flush() }
  /^Domain: / { flush(); s = $0; sub(/^Domain: *\047?/, "", s); sub(/\047? *$/, "", s); name = s; next }
  {
    line = $0; sub(/^ +/, "", line)
    split(line, kv, "=")
    k = kv[1]; x = substr(line, length(k) + 2)
    if (k == "cpu.time") v[2] = x + 0
    else if (k == "vcpu.current") v[3] = x + 0
    else if (k == "balloon.rss") v[4] = x + 0
    else if (k == "balloon.current") v[5] = x + 0
    else if (k == "block.count") { add(6, 0); add(7, 0) }
    else if (k == "net.count") { add(8, 0); add(9, 0) }
    else if (k ~ /^block\.[0-9]+\.rd\.bytes$/) add(6, x)
    else if (k ~ /^block\.[0-9]+\.wr\.bytes$/) add(7, x)
    else if (k ~ /^net\.[0-9]+\.rx\.bytes$/) add(8, x)
    else if (k ~ /^net\.[0-9]+\.tx\.bytes$/) add(9, x)
  }
  END { flush() }'
}

# The previous sample: "ts=<epoch>" then the guest lines. Missing or malformed
# reads as empty; the time check is done in the report.
previous() {
  [[ -r $STATE ]] || return 0
  cat -- "$STATE"
}

# save <sample>: the sample for the next run, in place atomically. A state
# directory that cannot be written costs the rates, never the check.
save() {
  local tmp="$STATE.tmp.$$"
  mkdir -p -- "${STATE%/*}" 2> /dev/null
  printf 'ts=%s\n%s' "$NOW" "${1:+$1$'\n'}" 2> /dev/null > "$tmp" || return 0
  mv -f -- "$tmp" "$STATE" 2> /dev/null
}

b=$(sample) || unknown "virsh domstats ${b//$'\n'/ }"
a=$(previous)
save "$b"
if [[ -z $b ]]; then
  echo "VMS OK - no running VMs | vms=0"
  exit 0
fi

awk -v a="$a" -v b="$b" -v now="$NOW" -v max_age="$MAX_AGE" '
function level(lbl, val, fmt) { if (val != "-") perf = perf sprintf(" %s_" lbl "=" fmt, name, val) }
function delta(i) { return y[i] > x[i] ? y[i] - x[i] : 0 }
function rate(lbl, i) { if (x[i] != "-" && y[i] != "-") perf = perf sprintf(" %s_%s=%.0f", name, lbl, delta(i) / iv) }
BEGIN {
  na = split(a, la, "\n"); nb = split(b, lb, "\n")
  why = "no previous sample"; iv = 0
  if (na > 0 && la[1] ~ /^ts=[0-9.]+$/) {
    ts = substr(la[1], 4) + 0; iv = now - ts
    if (iv > max_age) { why = "previous sample too old"; iv = 0 }
    else if (iv <= 0) { why = "previous sample not before now"; iv = 0 }
    else why = "no guest in the previous sample"
  }
  if (iv > 0) for (k = 2; k <= na; k++) { split(la[k], x, " "); earlier[x[1]] = la[k] }
  perf = ""; n = 0; rss = 0; rated = 0
  for (k = 1; k <= nb; k++) {
    split(lb[k], y, " ")
    name = tolower(y[1]); gsub(/[^a-z0-9_-]/, "_", name)
    n++
    if (y[1] in earlier) {
      split(earlier[y[1]], x, " "); rated++
      if (x[2] != "-" && y[2] != "-") perf = perf sprintf(" %s_cpu_pct=%.1f%%", name, delta(2) / (iv * 1e9) * 100)
    }
    level("vcpus", y[3], "%d")
    if (y[4] != "-") rss += y[4] * 1024
    level("rss", y[4] == "-" ? "-" : y[4] * 1024, "%.0fB")
    level("mem", y[5] == "-" ? "-" : y[5] * 1024, "%.0fB")
    if (y[1] in earlier) { rate("rd_Bps", 6); rate("wr_Bps", 7); rate("rx_Bps", 8); rate("tx_Bps", 9) }
  }
  note = rated ? "" : ", rates: " why
  printf "VMS OK - %d running VMs (rss %.1f GiB%s) | vms=%d%s\n", n, rss / 1073741824, note, n, perf
}'
