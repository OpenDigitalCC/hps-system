#!/usr/bin/env bash
#
# check_zpool - Nagios plugin: health or capacity of the imported ZFS pools.
#
# Run by nagios-check (ctrl-exec) on storage nodes. Reads `zpool list` only.
# Health (no options; checks.conf: zpool):
#   OK        every imported pool is ONLINE (or no pool is imported)
#   WARNING   a pool is DEGRADED
#   CRITICAL  a pool is FAULTED, UNAVAIL, OFFLINE, REMOVED or SUSPENDED
# Output: "ZPOOL <STATE> - <n> pools: name=HEALTH ..." with perfdata
# "<pool>_cap=<percent>%;80;90;0;100" per pool.
# Capacity (-m cap [-w PCT] [-c PCT]; checks.conf: zpool_cap): how full each
# pool is, health aside (that is the zpool check's):
#   WARNING   a pool is -w (default 80) percent full or more
#   CRITICAL  a pool is -c (default 90) percent full or more
# Output: "ZPOOL_CAP <STATE> - <n> pools: name 41% ..." with perfdata
# "<pool>_cap=<percent>%;<w>;<c>;0;100" per pool.
# Either: UNKNOWN when zpool cannot be run.
#
# Usage: check_zpool [-m health|cap] [-w PCT] [-c PCT]
# Exit: 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN.

set -uo pipefail

mode=health
warn=80
crit=90
label=ZPOOL

usage() {
  echo "$label UNKNOWN - $1"
  exit 3
}

while getopts "m:w:c:" opt; do
  case $opt in
    m) mode=$OPTARG ;;
    w) warn=$OPTARG ;;
    c) crit=$OPTARG ;;
    *) usage "usage: check_zpool [-m health|cap] [-w PCT] [-c PCT]" ;;
  esac
done
shift $((OPTIND - 1))
case $mode in
  health) ;;
  cap) label=ZPOOL_CAP ;;
  *) usage "-m is health or cap" ;;
esac
if [[ $# -ne 0 ]]; then
  usage "takes no arguments, only options"
fi
if ! [[ $warn =~ ^[0-9]{1,3}$ && $crit =~ ^[0-9]{1,3}$ && $warn -lt $crit && $crit -le 100 ]]; then
  usage "-w and -c must be percentages with -w below -c"
fi

if ! out=$(zpool list -H -o name,health,capacity 2>&1); then
  echo "$label UNKNOWN - zpool list failed: ${out//$'\n'/ }"
  exit 3
fi

state=OK
code=0
n=0
desc=""
perf=""
while IFS=$'\t' read -r name health cap; do
  [[ -n $name ]] || continue
  n=$((n + 1))
  cap=${cap%\%}
  perf+="${perf:+ }${name}_cap=${cap}%;$warn;$crit;0;100"
  if [[ $mode == health ]]; then
    desc+="${desc:+ }$name=$health"
    case $health in
      ONLINE) ;;
      DEGRADED)
        if [[ $code -lt 1 ]]; then state=WARNING; code=1; fi
        ;;
      *) state=CRITICAL; code=2 ;;
    esac
  else
    desc+="${desc:+ }$name ${cap}%"
    if [[ ! $cap =~ ^[0-9]+$ ]]; then
      echo "$label UNKNOWN - pool $name capacity '$cap' is not a percentage"
      exit 3
    fi
    if [[ $cap -ge $crit ]]; then
      state=CRITICAL; code=2
    elif [[ $cap -ge $warn && $code -lt 1 ]]; then
      state=WARNING; code=1
    fi
  fi
done <<< "$out"

if [[ $n -eq 0 ]]; then
  echo "$label OK - no pools imported"
  exit 0
fi
echo "$label $state - $n pools: $desc | $perf"
exit "$code"
