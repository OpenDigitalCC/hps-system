#!/usr/bin/env bash
#
# iscsi-export - export a zvol as an iSCSI LUN (LIO, via targetcli).
#
# ctrl-exec allowlisted node script. One action, a straight sequence of
# targetcli commands, every command logged as "+ <command>", no library
# sourcing (the Alpine n_iscsi-* functions were the reference, not reused).
#
# Usage: iscsi-export <pool>/<...>/<zvol> --iqn <target-iqn> --initiator <initiator-iqn> --portal <ip>
#
# Creates, each step only when it is not there yet (so a re-run changes nothing):
#   /backstores/block   <name> -> /dev/zvol/<zvol>   (name = zvol with / -> _)
#   /iscsi              <target-iqn>
#   .../tpg1/luns       the backstore
#   .../tpg1/acls       <initiator-iqn>
#   .../tpg1/portals    <ip>:3260, and the default 0.0.0.0:3260 portal removed
# then targetcli saveconfig. No CHAP is configured; access is the ACL and the
# portal address only.
#
# Exit: 0 exported, 2 usage, 3 refused (bad argument, not a zvol, backstore
# name taken by another device), 1 a command failed.

set -euo pipefail

ZVOL=""
IQN=""
INITIATOR=""
PORTAL=""
NAME=""

log() {
  printf '[iscsi-export] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: iscsi-export <zvol> --iqn <target-iqn> --initiator <initiator-iqn> --portal <ip>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

parse_args() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      --iqn | --initiator | --portal)
        [[ $# -ge 2 ]] || { log "$arg needs a value"; usage; exit 2; }
        case "$arg" in
          --iqn) IQN=$2 ;;
          --initiator) INITIATOR=$2 ;;
          --portal) PORTAL=$2 ;;
        esac
        shift 2
        ;;
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$ZVOL" ]]; then
          log "only one zvol is accepted"
          usage
          exit 2
        fi
        ZVOL=$arg
        shift
        ;;
    esac
  done
  [[ -n "$ZVOL" && -n "$IQN" && -n "$INITIATOR" && -n "$PORTAL" ]] || { usage; exit 2; }
  if [[ ! "$ZVOL" =~ ^[a-z][a-z0-9_.-]*(/[A-Za-z0-9_.:-]+)+$ ]]; then
    refuse "zvol '$ZVOL' is not <pool>/<name>"
  fi
  if [[ ! "$IQN" =~ ^iqn\.[0-9]{4}-[0-9]{2}\.[a-z0-9.-]+(:[A-Za-z0-9._:-]+)?$ ]]; then
    refuse "target '$IQN' is not an iqn name"
  fi
  if [[ ! "$INITIATOR" =~ ^iqn\.[0-9]{4}-[0-9]{2}\.[a-z0-9.-]+(:[A-Za-z0-9._:-]+)?$ ]]; then
    refuse "initiator '$INITIATOR' is not an iqn name"
  fi
  if [[ ! "$PORTAL" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || "$PORTAL" == "0.0.0.0" ]]; then
    refuse "portal '$PORTAL' is not a specific IPv4 address"
  fi
  NAME=${ZVOL//\//_}
}

require_zvol() {
  local type
  type=$(run zfs list -H -o type "$ZVOL") || refuse "'$ZVOL' does not exist"
  if [[ "$type" != "volume" ]]; then
    refuse "'$ZVOL' is a $type, not a zvol"
  fi
}

# tc <path> [args...]: one logged targetcli command.
tc() {
  run targetcli "$@"
}

# listing <path>: the targetcli tree at <path>, empty when it does not exist.
listing() {
  printf '+ targetcli ls %s\n' "$1" >&2
  targetcli ls "$1" 2> /dev/null || true
}

ensure_backstore() {
  local ls
  ls=$(listing /backstores/block)
  if printf '%s\n' "$ls" | grep -Eq "o- ${NAME} "; then
    if ! printf '%s\n' "$ls" | grep -F "o- ${NAME} " | grep -qF "/dev/zvol/${ZVOL} "; then
      refuse "backstore '$NAME' exists for another device"
    fi
    log "backstore $NAME already present"
  else
    tc /backstores/block create "$NAME" "/dev/zvol/$ZVOL"
  fi
}

ensure_target() {
  if listing /iscsi | grep -qF "o- ${IQN} "; then
    log "target $IQN already present"
  else
    tc /iscsi create "$IQN"
  fi
}

ensure_lun() {
  if listing "/iscsi/$IQN/tpg1/luns" | grep -qF "block/${NAME} "; then
    log "lun for $NAME already present"
  else
    tc "/iscsi/$IQN/tpg1/luns" create "/backstores/block/$NAME"
  fi
}

ensure_acl() {
  if listing "/iscsi/$IQN/tpg1/acls" | grep -qF "o- ${INITIATOR} "; then
    log "acl for $INITIATOR already present"
  else
    tc "/iscsi/$IQN/tpg1/acls" create "$INITIATOR"
  fi
}

ensure_portal() {
  local ls
  ls=$(listing "/iscsi/$IQN/tpg1/portals")
  if printf '%s\n' "$ls" | grep -qF "o- ${PORTAL}:3260 "; then
    log "portal $PORTAL:3260 already present"
  else
    tc "/iscsi/$IQN/tpg1/portals" create "$PORTAL"
  fi
  if printf '%s\n' "$ls" | grep -qF "o- 0.0.0.0:3260 "; then
    tc "/iscsi/$IQN/tpg1/portals" delete 0.0.0.0 3260
  fi
}

main() {
  parse_args "$@"
  require_zvol
  ensure_backstore
  ensure_target
  ensure_lun
  ensure_acl
  ensure_portal
  tc saveconfig
}

main "$@"
