#!/usr/bin/env bash
#
# osvc-secret-set - receive the OpenSVC cluster secret and (re)start the daemon.
#
# Usage: osvc-secret-set          (no arguments; the value arrives on stdin)
# ctrl-exec input = raw: stdin is the cluster secret as lower-case hex (32 to
# 128 digits), delivered by hps-osvc deliver on the IPS from the keysafe. It is
# never an argument, never logged and never in the image.
#
# Writes $HPS_RUN_DIR/osvc-cluster-secret (root only, RAM); hps-osvc-config puts
# it in cluster.conf when opensvc-daemon starts. The daemon is always
# (re)started, so each delivery also refreshes the node list from the IPS
# (re-deliver on every node after a node is paired).
#
# Overrides for tests: HPS_RUN_DIR.
# Exit: 0 done, 1 the unit failed to start, 2 usage, 3 stdin is not a hex secret.

set -euo pipefail

: "${HPS_RUN_DIR:=/run/hps}"

log() {
  printf '[osvc-secret-set] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

main() {
  local value target
  if [[ $# -ne 0 ]]; then
    echo "Usage: osvc-secret-set (cluster secret on stdin)" >&2
    exit 2
  fi
  IFS= read -r value || true
  if [[ ! "$value" =~ ^[0-9a-f]{32,128}$ ]]; then
    log "refused: stdin is not a 32-128 digit lower-case hex value"
    exit 3
  fi
  target="$HPS_RUN_DIR/osvc-cluster-secret"
  run mkdir -p "$HPS_RUN_DIR"
  log "+ write $target (root only; value not shown)"
  ( umask 077; printf '%s\n' "$value" > "$target.tmp" )
  chmod 0600 "$target.tmp"
  mv -f "$target.tmp" "$target"
  run systemctl restart opensvc-daemon.service
  printf 'cluster secret stored; opensvc-daemon restarted\n'
}

main "$@"
