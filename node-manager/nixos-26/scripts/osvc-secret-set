#!/usr/bin/env bash
#
# osvc-secret-set - receive the OpenSVC cluster secret and (re)start the daemon.
#
# Usage: osvc-secret-set          (no arguments; the value arrives on stdin)
# ctrl-exec input = raw: stdin is the cluster secret as lower-case hex, exactly 32
# characters, delivered by hps-osvc deliver on the IPS from the keysafe. It is
# never an argument, never logged and never in the image.
#
# Writes $HPS_RUN_DIR/osvc-cluster-secret (root only, RAM); hps-osvc-config puts
# it in cluster.conf when opensvc-daemon starts. The daemon is always
# (re)started, so each delivery also refreshes the node list from the IPS
# (re-deliver on every node after a node is paired).
#
# Optional line 2 (IPS-12): "<epoch> <base64 of ca.conf>", the cluster's one om3 CA
# held by the IPS keysafe ('opensvc-ca'). It is validated first (malformed: exit 3,
# nothing written) and installed as $OSVC_ETC/namespaces/system/sec/ca.conf (dir
# 0700, file 0600, mtime = the epoch, because om3 discovery prefers the newest
# copy) before the daemon restarts. When the file differed or was absent, the
# node certificate cert.conf is removed so the daemon reissues it from the shared
# CA. The CA content is never printed or logged.
#
# Overrides for tests: HPS_RUN_DIR, OSVC_ETC (default /etc/opensvc).
# Why 32: om3 uses the secret string itself as the AES key of its heartbeat secret
# (AES takes 16, 24 or 32 bytes; its own default is a dash-less UUID, 32 characters).
# Exit: 0 done, 1 the unit failed to start, 2 usage, 3 stdin is not a 32-digit hex secret
# or line 2 is not a valid CA line.

set -euo pipefail

: "${HPS_RUN_DIR:=/run/hps}"
: "${OSVC_ETC:=/etc/opensvc}"

log() {
  printf '[osvc-secret-set] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

# install_ca <epoch> <base64>: put the cluster CA in place; sets CA_RESULT.
install_ca() {
  local epoch=$1 b64=$2 dir ca
  dir="$OSVC_ETC/namespaces/system/sec"
  ca="$dir/ca.conf"
  run mkdir -p -m 0700 "$dir"
  ( umask 077; printf '%s' "$b64" | base64 -d > "$ca.tmp" )
  chmod 0600 "$ca.tmp"
  if [[ -f "$ca" ]] && cmp -s "$ca.tmp" "$ca"; then
    log "cluster CA unchanged (content not shown)"
    rm -f "$ca.tmp"
    chmod 0600 "$ca"
    touch -d "@$epoch" "$ca"
    CA_RESULT="cluster CA unchanged"
    return 0
  fi
  log "+ write $ca (root only; content not shown)"
  touch -d "@$epoch" "$ca.tmp"
  mv -f "$ca.tmp" "$ca"
  if [[ -e "$dir/cert.conf" ]]; then
    log "cluster CA changed: removing the node certificate, it is reissued from the shared CA"
    rm -f "$dir/cert.conf"
  fi
  CA_RESULT="cluster CA installed"
}

main() {
  local value target ca_line="" epoch="" b64=""
  CA_RESULT=""
  if [[ $# -ne 0 ]]; then
    echo "Usage: osvc-secret-set (cluster secret on stdin)" >&2
    exit 2
  fi
  IFS= read -r value || true
  if [[ ! "$value" =~ ^[0-9a-f]{32}$ ]]; then
    log "refused: stdin is not a 32 digit lower-case hex value"
    exit 3
  fi
  IFS= read -r ca_line || true
  if [[ -n "$ca_line" ]]; then
    epoch=${ca_line%% *}
    b64=${ca_line#* }
    if [[ "$ca_line" != *" "* || ! "$epoch" =~ ^[0-9]{1,12}$ || ! "$b64" =~ ^[A-Za-z0-9+/]+=?=?$ ]]; then
      log "refused: line 2 is not '<epoch> <base64>'"
      exit 3
    fi
    if ! printf '%s' "$b64" | base64 -d 2> /dev/null | grep -E '^\[(DEFAULT|data)\]' > /dev/null; then
      log "refused: line 2 does not decode to a CA file"
      exit 3
    fi
  fi
  target="$HPS_RUN_DIR/osvc-cluster-secret"
  run mkdir -p "$HPS_RUN_DIR"
  log "+ write $target (root only; value not shown)"
  ( umask 077; printf '%s\n' "$value" > "$target.tmp" )
  chmod 0600 "$target.tmp"
  mv -f "$target.tmp" "$target"
  if [[ -n "$ca_line" ]]; then
    install_ca "$epoch" "$b64"
  fi
  run systemctl restart opensvc-daemon.service
  printf 'cluster secret stored; opensvc-daemon restarted\n'
  if [[ -n "$CA_RESULT" ]]; then
    printf '%s\n' "$CA_RESULT"
  fi
}

main "$@"
