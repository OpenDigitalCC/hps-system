#!/usr/bin/env bash
#
# storage-pool-create - create a mirrored, encrypted-parent ZFS pool.
#
# ctrl-exec allowlisted node script, declared input=raw (nix/modules/
# hps-ctrl-exec.nix): the pool key arrives on stdin as ONE JSON document,
# never in an argument and never in a file on the node:
#
#   {"key_hex": "<64 hex: the 32-byte raw key for <pool>/enc>"}
#
# Who may run it is ctrl-exec's decision (the agent's script allowlist and the
# dispatcher's auth hook; docs/adr/0007).
#
# Usage: storage-pool-create <pool> --disk <by-id> --disk <by-id> [--disk <by-id>]... [--wipe]
# A mirror of every disk given (2 to 4: a three-way mirror survives two disk
# losses; owner 2026-11-11, scale test storage nodes).
#
#   --wipe   a disk that carries a pool label or a filesystem/partition
#            signature is wiped (only the disks named); without it such a
#            disk is refused
#
# Checks, all before any disk is touched: the pool name, 2 to 4 distinct by-id
# names, the key; then per disk: exists under /dev/disk/by-id, whole disk,
# unmounted with no holders, not a member of an imported pool, and no pool
# label or filesystem/partition signature unless --wipe - in which case
# "WILL WIPE: <by-id>" is printed and exactly those devices get zpool
# labelclear -f and wipefs -a.
# Then zpool create, and zfs create of <pool>/enc (aes-256-gcm raw key) with the
# key piped to stdin; the key stays loaded for this session. Idempotent: the
# same pool on the same disks with <pool>/enc present exits 0 after status.
#
# Exit: 0 done, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

POOL=""
DISKS=()
PAYLOAD=""
ENC_KEY=""
WIPE=0
POOL_EXISTS=0
DISK_DIRTY=0
IMPORT_LISTING=""

log() {
  printf '[storage-pool-create] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-pool-create <pool> --disk <by-id> --disk <by-id> [--disk <by-id> ...] [--wipe]
  2 to 4 disks; the pool is one mirror of them all.
Input (stdin): {"key_hex":"<64 hex>"}
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

byid_name() {
  local d=$1
  d=${d#/dev/disk/by-id/}
  printf '%s\n' "$d"
}

parse_args() {
  local arg d
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      --disk)
        [[ $# -ge 2 ]] || { log "--disk needs a value"; usage; exit 2; }
        d=$(byid_name "$2")
        if [[ ! "$d" =~ ^[A-Za-z0-9._:+@-]+$ ]]; then
          refuse "disk '$2' is not a /dev/disk/by-id name"
        fi
        DISKS+=("$d")
        shift 2
        ;;
      --wipe)
        WIPE=1
        shift
        ;;
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$POOL" ]]; then
          log "only one pool name is accepted"
          usage
          exit 2
        fi
        POOL=$arg
        shift
        ;;
    esac
  done
  [[ -n "$POOL" ]] || { usage; exit 2; }
  [[ ${#DISKS[@]} -ge 2 && ${#DISKS[@]} -le 4 ]] || { log "two to four --disk arguments are required"; usage; exit 2; }
  if [[ ! "$POOL" =~ ^[a-z][a-z0-9_.-]*$ ]]; then
    refuse "pool name '$POOL' does not match ^[a-z][a-z0-9_.-]*\$"
  fi
  if [[ "$(printf '%s\n' "${DISKS[@]}" | sort | uniq -d | head -1)" != "" ]]; then
    refuse "a disk is given more than once"
  fi
}

sorted_disks() {
  printf '%s\n' "${DISKS[@]}" | LC_ALL=C sort | paste -sd, -
}

# read_key: the pool key from the stdin document {"key_hex":"<64 hex>"}.
read_key() {
  log "reading the pool key document from stdin (key not logged)"
  PAYLOAD=$(cat)
  if ! printf '%s' "$PAYLOAD" | jq -e 'type == "object"' > /dev/null 2>&1; then
    refuse "the input is not a JSON object"
  fi
  ENC_KEY=$(printf '%s' "$PAYLOAD" | jq -r '.key_hex // ""')
  PAYLOAD=""
  if [[ ! "$ENC_KEY" =~ ^[0-9a-fA-F]{64}$ ]]; then
    refuse "key_hex must be 64 hex characters"
  fi
  log "disks: $(sorted_disks); wipe=$WIPE"
}

pool_is_imported() {
  zpool list -H -o name "$POOL" > /dev/null 2>&1
}

# The by-id names (partition suffix removed) the existing pool uses, sorted.
existing_pool_disks() {
  zpool status -P "$POOL" | grep -o '/dev/disk/by-id/[^ 	]*' | sed -e 's|^/dev/disk/by-id/||' -e 's/-part[0-9]*$//' | LC_ALL=C sort -u | paste -sd, -
}

# Decides idempotency: the pool already there on the same disks is not an error.
check_existing_pool() {
  local have
  if ! pool_is_imported; then
    return 0
  fi
  have=$(existing_pool_disks)
  if [[ "$have" != "$(sorted_disks)" ]]; then
    refuse "pool '$POOL' already exists on different disks ($have)"
  fi
  POOL_EXISTS=1
  log "pool '$POOL' already exists on the named disks"
}

in_active_pool() {
  local d=$1
  if zpool status -P 2> /dev/null | grep -qF "/dev/disk/by-id/$d"; then
    refuse "$d is a member of an imported pool"
  fi
}

# check_disk <by-id>: sets DISK_DIRTY=1 when a label or signature is present.
check_disk() {
  local d=$1 dev tree
  dev=$(run readlink -e -- "/dev/disk/by-id/$d") || refuse "/dev/disk/by-id/$d does not exist"
  tree=$(run lsblk -nr -o TYPE,MOUNTPOINTS "$dev") || refuse "lsblk cannot read $dev"
  if [[ "$(printf '%s\n' "$tree" | awk 'NR==1{print $1}')" != "disk" ]]; then
    refuse "$d is not a whole disk"
  fi
  if printf '%s\n' "$tree" | awk 'NR>1 && $2!=""{f=1} END{exit !f}'; then
    refuse "$d (or a partition on it) is mounted"
  fi
  if printf '%s\n' "$tree" | awk 'NR>1 && $1!="part"{f=1} END{exit !f}'; then
    refuse "$d has a holder (lvm/crypt/md) on it"
  fi
  in_active_pool "$d"
  if run blkid -p -o export "$dev" > /dev/null 2>&1; then
    log "$d carries a filesystem or partition signature"
    DISK_DIRTY=1
  fi
  if run zdb -l "$dev" > /dev/null 2>&1; then
    log "$d carries a ZFS label"
    DISK_DIRTY=1
  fi
  if printf '%s\n' "$IMPORT_LISTING" | grep -qF "$d"; then
    log "$d appears in the zpool import listing"
    DISK_DIRTY=1
  fi
}

check_disks() {
  local d
  DISK_DIRTY=0
  printf '+ zpool import -d /dev/disk/by-id\n' >&2
  IMPORT_LISTING=$(zpool import -d /dev/disk/by-id 2>&1) || true
  for d in "${DISKS[@]}"; do
    check_disk "$d"
  done
  if [[ $DISK_DIRTY -eq 1 && "$WIPE" != "1" ]]; then
    refuse "a disk carries a pool label or signature; --wipe is needed to wipe it"
  fi
}

wipe_disks() {
  local d
  if [[ "$WIPE" != "1" ]]; then
    return 0
  fi
  for d in "${DISKS[@]}"; do
    log "WILL WIPE: /dev/disk/by-id/$d"
  done
  for d in "${DISKS[@]}"; do
    run zpool labelclear -f "/dev/disk/by-id/$d" || log "no ZFS label to clear on $d"
    run wipefs -a "/dev/disk/by-id/$d"
  done
}

create_pool() {
  local d
  local -a DEVS=()
  for d in "${DISKS[@]}"; do DEVS+=("/dev/disk/by-id/$d"); done
  for d in "${DISKS[@]}"; do
    log "using /dev/disk/by-id/$d"
  done
  run zpool create -o ashift=12 -o autotrim=on -O compression=lz4 -O atime=off -O xattr=sa -O mountpoint=none "$POOL" mirror "${DEVS[@]}"
}

enc_exists() {
  zfs list -H -o name "$POOL/enc" > /dev/null 2>&1
}

# The 32-byte raw key goes to zfs on stdin only (keylocation=prompt).
create_enc() {
  printf '+ zfs create -o encryption=aes-256-gcm -o keyformat=raw -o keylocation=prompt %s/enc  (raw key on stdin)\n' "$POOL" >&2
  printf '%s' "$ENC_KEY" | xxd -r -p | zfs create -o encryption=aes-256-gcm -o keyformat=raw -o keylocation=prompt "$POOL/enc"
}

main() {
  parse_args "$@"
  read_key
  check_existing_pool
  if [[ $POOL_EXISTS -eq 0 ]]; then
    check_disks
    wipe_disks
    create_pool
  fi
  if enc_exists; then
    log "$POOL/enc already exists"
  else
    create_enc
  fi
  run zpool status "$POOL"
}

main "$@"
