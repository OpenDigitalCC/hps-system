#!/usr/bin/env bash
#
# storage-trim-check - prove TRIM reaches every disk of a pool.
#
# ctrl-exec allowlisted node script. Usage: storage-trim-check <pool>
#
# For each disk of the (imported) pool: lsblk -D shows whether the device
# advertises discard (DISC-GRAN / DISC-MAX non-zero). Then zpool trim -w (waits
# for completion) and zpool status -t (per-vdev trim state). The LAST line is
# the verdict: "TRIM OK", or "TRIM NOT REACHING <disk>" for the first disk
# whose discard is zero or whose vdev is not reported trimmed.
#
# Exit: 0 TRIM OK, 3 not OK / pool not imported, 2 usage, 1 a command failed.

set -euo pipefail

POOL=""
BAD=""

log() {
  printf '[storage-trim-check] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-trim-check <pool>
Exit: 0 TRIM OK, 3 not OK, 2 usage, 1 failed.
USAGE
}

parse_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$POOL" ]]; then
          log "only one pool name is accepted"
          usage
          exit 2
        fi
        POOL="$arg"
        ;;
    esac
  done
  if [[ -z "$POOL" ]]; then
    usage
    exit 2
  fi
  if [[ ! "$POOL" =~ ^[a-z][a-z0-9_.-]*$ ]]; then
    log "refused: pool name '$POOL' does not match ^[a-z][a-z0-9_.-]*\$"
    exit 3
  fi
}

# note_bad <device>: remember the first offending disk (by-id name, no -partN).
note_bad() {
  local d=${1##*/}
  if [[ -z "$BAD" ]]; then
    BAD=${d%-part[0-9]*}
  fi
}

# Discard capability of each pool device (lsblk -D, bytes; 0 = none).
check_discard() {
  local dev out name gran max
  for dev in "$@"; do
    out=$(run lsblk -D -b -n -o NAME,DISC-GRAN,DISC-MAX "$dev" | head -n 1) || out=""
    printf '%s\n' "$out"
    read -r name gran max <<< "$out"
    if [[ -z "${name:-}" || "${gran:-0}" == "0" || "${max:-0}" == "0" ]]; then
      note_bad "$dev"
    fi
  done
}

# A vdev line of "zpool status -t" that does not say "trimmed" was not trimmed.
check_trim_state() {
  local status=$1 line dev
  while IFS= read -r line; do
    dev=$(printf '%s\n' "$line" | awk '{print $1}')
    if [[ "$line" == *"trim unsupported"* || "$line" == *"untrimmed"* ]]; then
      note_bad "$dev"
    fi
  done < <(printf '%s\n' "$status" | grep -E '\((untrimmed|trim unsupported|[0-9]+% trimmed|trimmed)' || true)
}

main() {
  local devs=() line status
  parse_args "$@"
  if ! zpool list -H -o name "$POOL" > /dev/null 2>&1; then
    log "refused: pool '$POOL' is not imported"
    exit 3
  fi
  while IFS= read -r line; do
    [[ -n "$line" ]] && devs+=("$line")
  done < <(zpool status -P "$POOL" | grep -o '/dev/disk/by-id/[^ 	]*' || true)
  printf '+ zpool status -P %s\n' "$POOL" >&2
  if [[ ${#devs[@]} -eq 0 ]]; then
    log "no by-id devices found for pool '$POOL'"
    exit 3
  fi
  check_discard "${devs[@]}"
  run zpool trim -w "$POOL" || note_bad "${devs[0]}"
  status=$(run zpool status -t "$POOL")
  printf '%s\n' "$status"
  check_trim_state "$status"
  if [[ -n "$BAD" ]]; then
    printf 'TRIM NOT REACHING %s\n' "$BAD"
    exit 3
  fi
  printf 'TRIM OK\n'
}

main "$@"
