#!/usr/bin/env bash
#
# storage-zvol-create - create a sparse zvol under a pool's encrypted parent.
#
# ctrl-exec allowlisted node script. Usage:
#   storage-zvol-create <dataset> <size> [--sync standard|always|disabled] [--logbias latency|throughput]
#
#   <dataset>  <pool>/enc/<name> or <pool>/enc/vm/<name>  (guest disks live under
#              <pool>/enc/vm, apart from other zvols; that filesystem dataset is
#              created here when absent and inherits the encryption of <pool>/enc)
#   <size>     ^[0-9]+[KMGT]$      binary multiples, a multiple of 16K, > 0
#   --sync, --logbias  the cluster's write policy (cluster keys storage_zvol_sync
#              and storage_zvol_logbias; hps-storage passes them when they are
#              not the ZFS default), set on the new zvol as -o sync= -o logbias=.
#              Without them the zvol inherits <pool>/enc. An existing zvol keeps
#              its properties (storage-zfs-set changes them).
#
# The parent <pool>/enc must have keystatus "available" (a locked parent is
# never written to). Then:
#   zfs create -V <size> -s -o volblocksize=16k -o compression=lz4 [-o sync=..] [-o logbias=..] <dataset>
# Idempotent: the dataset already there as a zvol of exactly that size exits 0
# without a change; a different size, or a dataset that is not a zvol, is
# refused. Nothing is ever resized or replaced.
#
# Exit: 0 created or already identical, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

DATASET=""
SIZE=""
POOL=""
VM_PARENT=""
BYTES=0
SYNC=""
LOGBIAS=""

log() {
  printf '[storage-zvol-create] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-zvol-create <pool>/enc/[vm/]<name> <size> [--sync standard|always|disabled] [--logbias latency|throughput]
  (size like 1G, 512M, 2T)
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

parse_args() {
  local -a pos=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --sync)
        [[ $# -ge 2 ]] || { log "--sync needs a value"; usage; exit 2; }
        case "$2" in
          standard | always | disabled) SYNC=$2 ;;
          *) refuse "--sync '$2' is not standard, always or disabled" ;;
        esac
        shift 2 ;;
      --logbias)
        [[ $# -ge 2 ]] || { log "--logbias needs a value"; usage; exit 2; }
        case "$2" in
          latency | throughput) LOGBIAS=$2 ;;
          *) refuse "--logbias '$2' is not latency or throughput" ;;
        esac
        shift 2 ;;
      -*) log "unknown option: $1"; usage; exit 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  if [[ ${#pos[@]} -ne 2 ]]; then
    usage
    exit 2
  fi
  DATASET=${pos[0]}
  SIZE=${pos[1]}
  if [[ ! "$DATASET" =~ ^([a-z][a-z0-9_.-]*)/enc/(vm/)?[A-Za-z0-9_-]+$ ]]; then
    refuse "dataset '$DATASET' is not <pool>/enc/<name> or <pool>/enc/vm/<name>"
  fi
  POOL=${BASH_REMATCH[1]}
  VM_PARENT=""
  if [[ -n "${BASH_REMATCH[2]}" ]]; then
    VM_PARENT="$POOL/enc/vm"
  fi
  if [[ ! "$SIZE" =~ ^[0-9]+[KMGT]$ ]]; then
    refuse "size '$SIZE' does not match ^[0-9]+[KMGT]\$"
  fi
}

# size_bytes: BYTES from SIZE; refuses zero, overflow and a size that is not a
# multiple of the 16K volblocksize.
size_bytes() {
  local num=${SIZE%?} unit=${SIZE: -1} sh
  case "$unit" in
    K) sh=10 ;;
    M) sh=20 ;;
    G) sh=30 ;;
    T) sh=40 ;;
  esac
  num=$((10#$num))
  if ((${#SIZE} > 12 || num == 0)); then
    refuse "size '$SIZE' is zero or out of range"
  fi
  BYTES=$((num << sh))
  if ((BYTES % 16384 != 0)); then
    refuse "size '$SIZE' is not a multiple of the 16K volblocksize"
  fi
}

require_unlocked_parent() {
  local ks
  ks=$(run zfs get -H -o value keystatus "$POOL/enc") || refuse "cannot read keystatus of $POOL/enc"
  if [[ "$ks" != "available" ]]; then
    refuse "$POOL/enc is not unlocked (keystatus: $ks)"
  fi
}

# <pool>/enc/vm: a plain filesystem dataset below the unlocked <pool>/enc; it
# inherits the encryption, so no key is given.
ensure_vm_parent() {
  [[ -n "$VM_PARENT" ]] || return 0
  if zfs list -H -o type "$VM_PARENT" > /dev/null 2>&1; then
    return 0
  fi
  log "creating $VM_PARENT (inherits the encryption of $POOL/enc)"
  run zfs create "$VM_PARENT"
}

# Exits 0 when the dataset is already a zvol of the requested size.
check_existing() {
  local type have
  printf '+ zfs list -H -o type %s\n' "$DATASET" >&2
  if ! type=$(zfs list -H -o type "$DATASET" 2> /dev/null); then
    return 0
  fi
  if [[ "$type" != "volume" ]]; then
    refuse "'$DATASET' exists and is a $type, not a zvol"
  fi
  have=$(run zfs get -H -p -o value volsize "$DATASET")
  if [[ "$have" == "$BYTES" ]]; then
    log "$DATASET already exists with size $SIZE; nothing to do"
    exit 0
  fi
  refuse "'$DATASET' exists with a different size ($have bytes, wanted $BYTES)"
}

main() {
  local -a props=()
  parse_args "$@"
  size_bytes
  require_unlocked_parent
  check_existing
  ensure_vm_parent
  [[ -z "$SYNC" ]] || props+=(-o "sync=$SYNC")
  [[ -z "$LOGBIAS" ]] || props+=(-o "logbias=$LOGBIAS")
  run zfs create -V "$SIZE" -s -o volblocksize=16k -o compression=lz4 "${props[@]}" "$DATASET"
  log "created $DATASET ($SIZE, sparse${SYNC:+, sync=$SYNC}${LOGBIAS:+, logbias=$LOGBIAS})"
}

main "$@"
