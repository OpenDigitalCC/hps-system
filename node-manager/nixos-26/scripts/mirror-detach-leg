#!/usr/bin/env bash
#
# mirror-detach-leg - take one leg out of a running mirror (a planned leg loss).
#
# ctrl-exec allowlisted node script.
#
# Usage: mirror-detach-leg <name> --leg <spec>
# mdadm /dev/md/<name> --fail <dev>, then --remove <dev>. The mirror keeps
# running degraded on the other leg; mirror-rejoin brings the leg back from the
# bitmap. Refuses (3) if the mirror is not assembled, the leg is not one of its
# legs, or it is the last active leg. A leg that is not a member any more:
# nothing to do, exit 0.
# Exit: 0 done, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

NAME=""
LEGS=()
DEVS=()
REMOTE_INDEX=""

log() {
  printf '[mirror-detach-leg] %s\n' "$*" >&2
}

usage() {
  cat >&2 <<'USAGE'
Usage: mirror-detach-leg <name> --leg <spec>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

# --- shared helpers (copied into each mirror script; no runtime sourcing) ---

: "${HPS_MIRROR_DIR:=/run/hps/mirrors}"
: "${HPS_CMDLINE:=/proc/cmdline}"
: "${HPS_LEG_RESOLVE:=$(dirname "$0")/leg-resolve}"

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

refuse() {
  log "refused: $*"
  exit 3
}

check_name() {
  if [[ ! "$NAME" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    refuse "mirror name '$NAME' does not match ^[A-Za-z][A-Za-z0-9_-]*\$"
  fi
}

check_spec() {
  case "$1" in
    local:* | iscsi:*) ;;
    *) refuse "leg spec '$1' is neither local:... nor iscsi:..." ;;
  esac
}

leg_kind() {
  case "$1" in
    local:*) printf 'local\n' ;;
    *) printf 'remote\n' ;;
  esac
}

# resolve_leg <spec>: prints the device path (leg-resolve is the only code that
# knows the two kinds of leg).
resolve_leg() {
  run "$HPS_LEG_RESOLVE" "$1"
}

# pick_remote_index: REMOTE_INDEX stays as given; unset, it is the index of the
# only iscsi: leg, and empty (no write-mostly leg) when that is not unique.
pick_remote_index() {
  local i n=0 found=""
  if [[ -n "$REMOTE_INDEX" ]]; then
    if [[ "$(leg_kind "${LEGS[$REMOTE_INDEX]}")" != remote ]]; then
      refuse "--remote-index $REMOTE_INDEX names a local leg"
    fi
    return 0
  fi
  for i in 0 1; do
    if [[ "${LEGS[$i]}" == iscsi:* ]]; then
      n=$((n + 1))
      found=$i
    fi
  done
  if ((n == 1)); then
    REMOTE_INDEX=$found
  fi
}

sidecar_path() {
  printf '%s/%s.json\n' "$HPS_MIRROR_DIR" "$NAME"
}

# sidecar_write: LEGS[], DEVS[] (an empty device = leg not present), REMOTE_INDEX.
sidecar_write() {
  local i path wm legs="[]"
  path=$(sidecar_path)
  mkdir -p "$HPS_MIRROR_DIR"
  for i in 0 1; do
    wm=0
    if [[ "$REMOTE_INDEX" == "$i" ]]; then wm=1; fi
    legs=$(jq -c --arg s "${LEGS[$i]}" --arg d "${DEVS[$i]:-}" --arg k "$(leg_kind "${LEGS[$i]}")" --argjson w "$wm" \
      '. + [{spec:$s,dev:$d,kind:$k,write_mostly:$w}]' <<< "$legs")
  done
  printf '+ write %s\n' "$path" >&2
  jq -n -c --arg n "$NAME" --argjson l "$legs" --arg r "$REMOTE_INDEX" \
    '{name:$n,remote_index:(if $r == "" then null else ($r | tonumber) end),legs:$l}' > "$path"
}

array_present() {
  mdadm --detail "/dev/md/$NAME" > /dev/null 2>&1
}

parse_args() {
  local arg spec=""
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      --leg)
        [[ $# -ge 2 ]] || { log "$arg needs a value"; usage; exit 2; }
        spec=$2
        shift 2
        ;;
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$NAME" ]]; then
          log "only one mirror name is accepted"
          usage
          exit 2
        fi
        NAME=$arg
        shift
        ;;
    esac
  done
  [[ -n "$NAME" && -n "$spec" ]] || { usage; exit 2; }
  check_name
  check_spec "$spec"
  DETACH=$spec
}

# The device of the leg, from the sidecar.
leg_device() {
  local side i
  side=$(sidecar_path)
  if [[ ! -r "$side" ]]; then
    refuse "mirror $NAME has no sidecar $side"
  fi
  for i in 0 1; do
    if [[ "$(jq -r ".legs[$i].spec" "$side")" == "$DETACH" ]]; then
      jq -r ".legs[$i].dev" "$side"
      return 0
    fi
  done
  refuse "$DETACH is not a leg of $NAME"
}

main() {
  local dev real detail active
  parse_args "$@"
  if ! array_present; then
    refuse "/dev/md/$NAME is not assembled"
  fi
  dev=$(leg_device)
  if [[ -z "$dev" ]]; then
    refuse "no device recorded for $DETACH"
  fi
  real=$(readlink -f -- "$dev")
  detail=$(mdadm --detail "/dev/md/$NAME")
  if ! grep -qF -e "$dev" -e "$real" <<< "$detail"; then
    log "$DETACH is not a member of $NAME; nothing to do"
    return 0
  fi
  active=$(sed -n -E '/^[[:space:]]*Active Devices[[:space:]]*:/{s/^[^:]*:[[:space:]]*//;p;q}' <<< "$detail")
  if [[ ! "$active" =~ ^[0-9]+$ ]] || ((active < 2)); then
    refuse "$DETACH is the last active leg of $NAME"
  fi
  run mdadm "/dev/md/$NAME" --fail "$dev"
  run mdadm "/dev/md/$NAME" --remove "$dev"
  log "leg $DETACH detached from $NAME; $NAME runs degraded"
}

main "$@"
