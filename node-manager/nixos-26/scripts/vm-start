#!/usr/bin/env bash
#
# vm-start - start a defined guest.
#
# ctrl-exec allowlisted node script.
#
# Usage: vm-start <vm> [--priority <1-5>] [--provides-storage]
#
# Stop order. --priority (the workload VM's priority, default 3) and
# --provides-storage (the guest provides storage to others, e.g. a nested SCH)
# are recorded in $HPS_GUEST_ORDER_DIR/<vm> (default /run/hps/guests) once the
# guest runs. hps-shutdown-storage stops guests by them: priority 5 first,
# 1 last, and within one priority the storage consumers before the providers.
# Not defined: refused with 4. Already running: nothing to do, exit 0. Shut
# off: virsh start, then wait up to 30 s (HPS_VM_WAIT) for the state "running".
# Any other state (paused, crashed, ...) is refused (3). The mirror under the
# guest must already be assembled (mirror-assemble/mirror-create): this script
# does not touch it.
#
# Fabric ports. A NIC defined with --vlan-pvid / --vlan-tagged (vm-define) has
# them recorded in the domain metadata (<hps:nic index= pvid= tagged=/>), because
# libvirt configures no VLANs on the tap port of a Linux bridge. After the guest
# runs (and also when it already runs: re-applying is harmless), each such NIC's
# tap (<target dev=> of the interface at that index, from virsh dumpxml) gets:
#   bridge vlan del dev <tap> vid 1            (only if the port is in VLAN 1)
#   bridge vlan add dev <tap> vid <pvid> pvid untagged
#   bridge vlan add dev <tap> vid <v>          (per tagged VLAN)
# A guest with no such metadata gets no bridge call. Needs `bridge` (iproute2)
# on the ctrl-exec script path.
#
# Guest memory budget. Before a shut-off guest starts, its memory plus the
# memory of every running guest must fit the guests' budget: machine.slice's
# memory.max (cgroup v2, $HPS_CGROUP_ROOT/machine.slice/memory.max), which
# host-reserve-apply sets at boot to the host's RAM less host_reserve_mem_mib
# and the ZFS ARC cap. Over it: refused (3), nothing started; the guest would
# otherwise push the slice into its OOM killer, which kills a running guest.
# No budget set (no file, or "max": host-reserve-apply has not run): no check,
# one log line. Memory per guest: "Max memory" of virsh dominfo.
#
# Last line on success: VM <vm> running
# Exit: 0 running, 2 usage, 3 refused, 4 not defined, 1 failed or not running in time.

set -euo pipefail

: "${HPS_VM_WAIT:=30}"
: "${HPS_VM_STEP:=1}"
: "${HPS_GUEST_ORDER_DIR:=/run/hps/guests}"
: "${HPS_CGROUP_ROOT:=/sys/fs/cgroup}"

VM=""
PRIORITY=3
PROVIDES_STORAGE=0

log() {
  printf '[vm-start] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

# run_q <command...>: log, then execute with stderr silenced (a probe).
run_q() {
  printf '+ %s\n' "$*" >&2
  "$@" 2> /dev/null
}

usage() {
  cat >&2 <<'USAGE'
Usage: vm-start <vm> [--priority <1-5>] [--provides-storage]
Exit: 0 ok, 2 usage, 3 refused, 4 not defined, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

parse_args() {
  [[ $# -ge 1 ]] || { usage; exit 2; }
  case "$1" in
    -*) usage; exit 2 ;;
  esac
  VM=$1
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --priority)
        [[ $# -ge 2 && "$2" =~ ^[1-5]$ ]] || { log "--priority takes 1-5"; usage; exit 2; }
        PRIORITY=$2
        shift 2
        ;;
      --provides-storage) PROVIDES_STORAGE=1; shift ;;
      *) log "unknown argument: $1"; usage; exit 2 ;;
    esac
  done
  [[ "$VM" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || refuse "vm name '$VM' does not match ^[a-z0-9][a-z0-9-]{0,31}\$"
}

# record_order: the guest's stop order for hps-shutdown-storage, one line
# "<priority> <provides storage 0|1>" in $HPS_GUEST_ORDER_DIR/<vm> (tmpfs: a
# node runs from RAM, and after a reboot no guest runs). Never fails the start.
record_order() {
  mkdir -p "$HPS_GUEST_ORDER_DIR" 2> /dev/null || true
  printf '%s %s\n' "$PRIORITY" "$PROVIDES_STORAGE" > "$HPS_GUEST_ORDER_DIR/$VM" 2> /dev/null \
    || log "cannot record the stop order in $HPS_GUEST_ORDER_DIR/$VM (continuing)"
}

# guest_mem_mib <vm>: the guest's memory in MiB ("Max memory: <n> KiB" of virsh dominfo).
guest_mem_mib() {
  local info kib
  info=$(run virsh -c qemu:///system dominfo "$1")
  kib=$(awk '/^Max memory:/ { print $3; exit }' <<< "$info")
  [[ "$kib" =~ ^[0-9]+$ ]] || { log "no Max memory for $1 in virsh dominfo"; exit 1; }
  printf '%s\n' $((kib / 1024))
}

# check_memory_budget: this guest plus the running ones within machine.slice's memory.max.
check_memory_budget() {
  local file="$HPS_CGROUP_ROOT/machine.slice/memory.max" max budget want used=0 others="" g m list
  if [[ ! -r "$file" ]]; then
    log "no guest memory budget ($file absent): not checked"
    return 0
  fi
  max=$(< "$file")
  if [[ ! "$max" =~ ^[0-9]+$ ]]; then
    log "no guest memory budget (machine.slice memory.max is '$max'): not checked"
    return 0
  fi
  budget=$((max / 1048576))
  want=$(guest_mem_mib "$VM")
  list=$(run virsh -c qemu:///system list --name)
  while read -r g; do
    [[ -n "$g" && "$g" != "$VM" ]] || continue
    m=$(guest_mem_mib "$g")
    used=$((used + m))
    others+=" $g"
  done <<< "$list"
  if ((used + want > budget)); then
    refuse "starting $VM ($want MiB) would put the running guests at $((used + want)) MiB, over the guest memory budget of $budget MiB (machine.slice memory.max: host RAM less host_reserve_mem_mib and the ZFS ARC cap); running:${others:- none}"
  fi
  log "guest memory: $((used + want)) of $budget MiB with $VM"
}

wait_running() {
  local waited=0 state
  while :; do
    state=$(run virsh -c qemu:///system domstate "$VM")
    if [[ "$state" == "running" ]]; then
      return 0
    fi
    waited=$((waited + 1))
    if ((waited > HPS_VM_WAIT)); then
      log "$VM is '$state' after $HPS_VM_WAIT s"
      exit 1
    fi
    sleep "$HPS_VM_STEP"
  done
}

# nic_vlans: one "<tap> <pvid|-> <tagged,list|->" line per NIC with VLAN
# metadata, from the domain XML on stdin.
nic_vlans() {
  awk -v q="'" '
    # Either quote style: libvirt re-serialises custom metadata (hps:nic) with
    # double quotes, its own elements with single (lab 2026-11-11: "no tap
    # device found for a NIC with VLANs").
    function attr(line, name,    r) {
      if (match(line, name "=" q "[^" q "]*" q) || match(line, name "=\"[^\"]*\"")) {
        r = substr(line, RSTART + length(name) + 2, RLENGTH - length(name) - 3)
        return r
      }
      return ""
    }
    /<interface[ >]/ { inif = 1; idx++ }
    inif && /<target dev=/ { tap[idx - 1] = attr($0, "dev") }
    /<\/interface>/ { inif = 0 }
    /<hps:nic / { m++; mi[m] = attr($0, "index"); mp[m] = attr($0, "pvid"); mt[m] = attr($0, "tagged") }
    END {
      for (i = 1; i <= m; i++)
        printf "%s %s %s\n", (tap[mi[i]] == "" ? "-" : tap[mi[i]]), (mp[i] == "" ? "-" : mp[i]), (mt[i] == "" ? "-" : mt[i])
    }'
}

# port_has_vid <tap> <vid>
port_has_vid() {
  bridge vlan show dev "$1" 2> /dev/null | awk -v want="$2" '
    { v = ($1 ~ /^[0-9]+$/) ? $1 : $2; if (v == want) found = 1 }
    END { exit found ? 0 : 1 }'
}

apply_vlans() {
  local xml tap pvid tagged v
  xml=$(run virsh -c qemu:///system dumpxml "$VM")
  while read -r tap pvid tagged; do
    [[ -n "$tap" ]] || continue
    if [[ "$tap" == "-" ]]; then
      log "no tap device found for a NIC with VLANs"
      exit 1
    fi
    if port_has_vid "$tap" 1; then
      run bridge vlan del dev "$tap" vid 1
    fi
    if [[ "$pvid" != "-" ]]; then
      run bridge vlan add dev "$tap" vid "$pvid" pvid untagged
    fi
    if [[ "$tagged" != "-" ]]; then
      for v in ${tagged//,/ }; do
        run bridge vlan add dev "$tap" vid "$v"
      done
    fi
  done < <(nic_vlans <<< "$xml")
}

main() {
  local state
  parse_args "$@"
  if ! state=$(run_q virsh -c qemu:///system domstate "$VM"); then
    log "$VM is not defined"
    exit 4
  fi
  case "$state" in
    running)
      log "$VM is already running; nothing to start"
      apply_vlans
      record_order
      printf 'VM %s running\n' "$VM"
      return 0
      ;;
    "shut off") ;;
    *) refuse "$VM is '$state', not shut off" ;;
  esac
  check_memory_budget
  run virsh -c qemu:///system start "$VM"
  wait_running
  apply_vlans
  record_order
  printf 'VM %s running\n' "$VM"
}

main "$@"
