#!/usr/bin/env bash
#
# leg-resolve - turn a mirror leg spec into the block device path on this node.
#
# ctrl-exec allowlisted node script. The ONE place that knows the two kinds of
# leg; the mirror-* scripts call it and never look at a spec themselves.
#
# Usage: leg-resolve <leg-spec>
#   local:<pool>/enc/vm/<name>   -> /dev/zvol/<pool>/enc/vm/<name> (must exist)
#   iscsi:<portal-ip>:<iqn>      -> /dev/disk/by-path/ip-<ip>:3260-iscsi-<iqn>-lun-0
#                                   after making sure the session is logged in
#                                   (discovery + login, each only when needed)
#
# Prints the device path on stdout (nothing else on stdout); the log goes to
# stderr. Test hooks: HPS_DEV (default /dev), HPS_LEG_TIMEOUT (default 30 s).
#
# Fail fast, not stall (owner ruling 2026-11-12: "apps can handle outage, not a
# blocking delay"). Before every login the node record gets the ISCSI_TIMEOUTS
# below, so a dead storage host turns into failed I/O within ~15 s (md then
# fails that leg and the mirror runs on the other) instead of I/O queued for
# open-iscsi's default 120 s. The compute profile sets the same values as the
# iscsid.conf defaults; this is the per-record guarantee.
# Exit: 0 resolved, 2 usage, 3 refused (bad spec, no such zvol, LUN did not
# appear), 1 a command failed.

set -euo pipefail

: "${HPS_DEV:=/dev}"
: "${HPS_LEG_TIMEOUT:=30}"

SPEC=""

# The session timeouts written to the node record before each login (seconds).
#   replacement_timeout  how long I/O is queued while a lost session is being
#                        re-established before it fails up to md (default 120)
#   noop_out_interval    how often a NOP-Out ping checks the connection
#   noop_out_timeout     how long a ping may go unanswered before the connection
#                        is declared dead and recovery (the timer above) starts
#   login_timeout        how long one login attempt may take
# A lost leg is therefore detected within ~10 s and failed within ~15 s more.
ISCSI_TIMEOUTS=(
  "node.session.timeo.replacement_timeout=15"
  "node.conn[0].timeo.noop_out_interval=5"
  "node.conn[0].timeo.noop_out_timeout=5"
  "node.conn[0].timeo.login_timeout=15"
)

log() {
  printf '[leg-resolve] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: leg-resolve <leg-spec>
  local:<pool>/enc/vm/<name> | iscsi:<portal-ip>:<iqn>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

parse_args() {
  case $# in
    1) ;;
    *) usage; exit 2 ;;
  esac
  case "$1" in
    -*) usage; exit 2 ;;
  esac
  SPEC=$1
}

resolve_local() {
  local rest=${SPEC#local:} dev
  if [[ ! "$rest" =~ ^[a-z][a-z0-9_.-]*/enc/vm/[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
    refuse "local leg '$rest' does not match <pool>/enc/vm/<name>"
  fi
  dev="$HPS_DEV/zvol/$rest"
  if [[ ! -e "$dev" ]]; then
    refuse "zvol device $dev does not exist"
  fi
  printf '%s\n' "$dev"
}

session_present() {
  local iqn=$1 sessions
  printf '+ iscsiadm -m session\n' >&2
  sessions=$(iscsiadm -m session 2> /dev/null || true)
  grep -qF -- "$iqn" <<< "$sessions"
}

# set_timeouts <ip> <iqn>: write ISCSI_TIMEOUTS into the node record (made by
# the discovery) so the login that follows uses them.
set_timeouts() {
  local ip=$1 iqn=$2 kv
  for kv in "${ISCSI_TIMEOUTS[@]}"; do
    run iscsiadm -m node -T "$iqn" -p "$ip" -o update -n "${kv%%=*}" -v "${kv#*=}" >&2
  done
}

ensure_session() {
  local ip=$1 iqn=$2
  if session_present "$iqn"; then
    log "session for $iqn already logged in"
    return 0
  fi
  run iscsiadm -m discovery -t sendtargets -p "$ip" >&2
  set_timeouts "$ip" "$iqn"
  run iscsiadm -m node -T "$iqn" -p "$ip" --login >&2
  run udevadm settle --timeout=10 >&2
}

wait_for_device() {
  local dev=$1 waited=0
  while [[ ! -e "$dev" ]]; do
    if ((waited >= HPS_LEG_TIMEOUT)); then
      refuse "$dev did not appear within ${HPS_LEG_TIMEOUT}s"
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

resolve_iscsi() {
  local rest=${SPEC#iscsi:} ip iqn dev
  ip=${rest%%:*}
  iqn=${rest#*:}
  if [[ ! "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    refuse "portal '$ip' is not an IPv4 address"
  fi
  if [[ "$rest" == "$ip" || ! "$iqn" =~ ^iqn\.[0-9]{4}-[0-9]{2}\.[a-z0-9.-]+(:[A-Za-z0-9._:-]+)?$ ]]; then
    refuse "iqn '$iqn' is not an iSCSI qualified name"
  fi
  dev="$HPS_DEV/disk/by-path/ip-$ip:3260-iscsi-$iqn-lun-0"
  if [[ ! -e "$dev" ]]; then
    ensure_session "$ip" "$iqn"
  else
    log "$dev is already present"
  fi
  wait_for_device "$dev"
  printf '%s\n' "$dev"
}

main() {
  parse_args "$@"
  case "$SPEC" in
    local:*) resolve_local ;;
    iscsi:*) resolve_iscsi ;;
    *) refuse "leg spec '$SPEC' is neither local:... nor iscsi:..." ;;
  esac
}

main "$@"
