#!/usr/bin/env bash
#
# vm-define - define (not start) a libvirt guest from a template.
#
# ctrl-exec allowlisted node script.
#
# Usage: vm-define <vm> --memory <MiB> --vcpus <n> --disk <block device> [--disk <dev>...]
#          --net <bridge> [--mac <mac>] [--net <bridge> [--mac <mac>]...]
#          --image <base qcow2> [--serial-log <path>] [--replace]
#          [--disk-bus virtio|scsi|sata] [--smbios vendor=<v>,product=<p>[,serial=<s>]]
#          [--cpu-weight <n>] [--cpu-max-pct <pct>] [--mem-hard-limit <MiB>]
#          [--io-weight <n>] per --disk: [--disk-iops <n>] [--disk-mbps <n>]
#        vm-define <vm> --boot network --memory <MiB> --vcpus <n>
#          --net <bridge> [--mac <mac>] [--net ...] [--disk <dev>]
#          [--serial-log <path>] [--replace]
#
#   <vm>      ^[a-z0-9][a-z0-9-]{0,31}$
#   --disk    a guest disk: the md mirror device made by mirror-create
#             (/dev/md/<name>) or a zvol; must exist, under /dev. Attached as
#             raw. Repeatable, 1..8, each path once. The first --disk is disk 1:
#             target vda (virtio) or sda (scsi, sata); the next ones take the
#             next letters in the order given (vdb, vdc, ... / sdb, sdc, ...).
#             All share the one --disk-bus. With --boot network the NIC boots
#             first, then disk 1; without it disk 1 is the boot disk.
#   --net     a bridge (made by net-bridge-ensure); one virtio NIC per --net.
#   --image   the base qcow2 the FIRST disk was filled from (vm-image-write writes
#             one disk; the others are left empty). It is only RECORDED in the domain metadata; vm-define neither reads
#             nor copies it, and never touches the disk.
#   --boot    disk (default) | network. network: OVMF netboots from the first
#             NIC (<boot dev='network'/>, then the disk if there is one); the
#             guest may have NO disk and no --image (a node that is deployed
#             over the network, like metal).
#   --mac     the MAC of the NIC given by the --net just before it (lower-case
#             unicast aa:bb:cc:dd:ee:ff); without it libvirt generates one.
#   --nic-model   virtio (default) | e1000e | rtl8139: the model of the NIC given
#             by the --net just before it (like --mac).
#   --vlan-pvid <1-4094>, --vlan-tagged <v[,v...]>   per NIC, after its --net:
#             the NIC's native (untagged) VLAN and its tagged VLANs on a
#             VLAN-aware (fabric) bridge. libvirt gives a Linux bridge's tap
#             ports no VLAN config, so they are only RECORDED in the domain
#             metadata (<hps:nic index= pvid= tagged=/>); vm-start applies them
#             with `bridge vlan` after the guest starts. A NIC on a bridge with
#             vlan_filtering 1 (a fabric bridge, see net-bridge-ensure) must
#             have a --vlan-pvid: such a port passes nothing without a VLAN.
#   Every disk gets a <serial> "<vm>-d<N>" (N = 1-based position in the --disk
#             order), so the guest finds it under /dev/disk/by-id; at most 20
#             characters (the virtio-blk and ATA limit): a longer one keeps its
#             last 20. Two disks of one VM with the same serial are refused.
#   --disk-bus  virtio (default) | scsi | sata: the bus of every --disk. scsi adds
#             one virtio-scsi controller (targets sda, sdb, ...); sata uses the
#             q35 AHCI controller, one port each (sda, sdb, ...); virtio is
#             vda, vdb, ....
#   --smbios  vendor=<v>,product=<p>[,serial=<s>]: the guest's SMBIOS system
#             manufacturer, product name and serial (libvirt sysinfo smbios).
#             Values: letters, digits, space, . _ - (first one alphanumeric).
#   --serial-log  default /var/log/libvirt/qemu/<vm>-serial.log
#
# Resource limits (docs/WORKLOADS.md "Resource limits"; the host side is
# host-reserve-apply). Each is optional; the two defaults are always written:
#   --cpu-weight <1-10000>   <cputune><shares>: the guest's CPU weight against the
#             other guests when the host CPUs are contended (cgroup v2 cpu.weight).
#             Default 100 per vCPU (at most 10000), so every vCPU weighs the same.
#   --cpu-max-pct <1-100>    <cputune><period>100000 <quota>: each vCPU may use at
#             most this percent of one host CPU. Default: no cap.
#   --mem-hard-limit <MiB>   <memtune><hard_limit>: the most the guest's QEMU process
#             may hold (guest RAM plus QEMU's own); at least --memory + 128.
#             Default --memory + 256 + --memory/16 (QEMU's overhead with room).
#   --io-weight <10-1000>    <blkiotune><weight>. Default: none written.
#   per --disk, after it: --disk-iops <n> and --disk-mbps <n> (MiB/s): the disk's
#             <iotune> total_iops_sec / total_bytes_sec (QEMU throttling).
#             Default: no throttle.
#
# The domain: q35, OVMF UEFI, host-passthrough CPU, virtio disk (raw, cache
# none), virtio NIC (unless --nic-model) per bridge, serial console written to a log file, NO
# graphics, NO spice, no video device.
#
# Firmware paths ASSUMED (unverified on a real node; nix is not available on
# the development host): the compute profile (nixpkgs 26.05 libvirtd module)
# links the QEMU firmware files into /run/libvirt/nix-ovmf/, so
#   loader  /run/libvirt/nix-ovmf/edk2-x86_64-code.fd   (read-only pflash, raw)
#   nvram template  /run/libvirt/nix-ovmf/edk2-i386-vars.fd
#   nvram per guest /var/lib/libvirt/qemu/nvram/<vm>_VARS.fd
# Override with HPS_OVMF_CODE, HPS_OVMF_VARS if the lab shows other names.
#
# Idempotent: the rendered definition's sha256 is stored in the domain metadata
# (hps:spec). The same arguments again: nothing changes, exit 0. A different
# definition of an already defined name is refused (3) unless --replace, which
# redefines it (keeping the uuid) only while the guest is not running.
#
# Calls, in order: virsh dominfo; (if defined) virsh dumpxml; (--replace)
# virsh domuuid, virsh domstate; virsh define; (--boot network) virsh domiflist.
# Last line on success: VM <vm> defined. With --boot network the last lines are
# one "VM <vm> defined mac=<mac>" per NIC, in --net order (read back with
# virsh domiflist, so libvirt-generated MACs are reported too).
# Exit: 0 defined or already identical, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

: "${HPS_DEV:=/dev}"
: "${HPS_OVMF_CODE:=/run/libvirt/nix-ovmf/edk2-x86_64-code.fd}"
: "${HPS_OVMF_VARS:=/run/libvirt/nix-ovmf/edk2-i386-vars.fd}"
: "${HPS_NVRAM_DIR:=/var/lib/libvirt/qemu/nvram}"
: "${HPS_LIBVIRT_LOGDIR:=/var/log/libvirt/qemu}"

VM=""
MEMORY=""
VCPUS=""
DISKS=()
IMAGE=""
SERIAL=""
BOOT="disk"
REPLACE=0
NETS=()
MACS=()
PVIDS=()
TAGGEDS=()
MODELS=()
DISK_BUS="virtio"
SMBIOS=""
SM_VENDOR=""
SM_PRODUCT=""
SM_SERIAL=""
NIC_META=""
DISK_IOPS=()
DISK_MBPS=()
CPU_WEIGHT=""
CPU_MAX_PCT=""
MEM_HARD=""
IO_WEIGHT=""
TMP=""
MAX_DISKS=8
SERIAL_MAX=20

log() {
  printf '[vm-define] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

# run_q <command...>: log, then execute with stderr silenced (a probe).
run_q() {
  printf '+ %s\n' "$*" >&2
  "$@" 2> /dev/null
}

usage() {
  cat >&2 <<'USAGE'
Usage: vm-define <vm> --memory <MiB> --vcpus <n> --disk <block device> [--disk <dev> ... up to 8]
         --net <bridge> [--mac <mac>] [--net <bridge> [--mac <mac>]...]
         --image <base qcow2> [--serial-log <path>] [--replace]
         per --net: [--mac <mac>] [--nic-model virtio|e1000e|rtl8139]
                    [--vlan-pvid <1-4094>] [--vlan-tagged <v[,v...]>]
         [--disk-bus virtio|scsi|sata] [--smbios vendor=<v>,product=<p>[,serial=<s>]]
         [--cpu-weight <1-10000>] [--cpu-max-pct <1-100>] [--mem-hard-limit <MiB>]
         [--io-weight <10-1000>]  per --disk: [--disk-iops <n>] [--disk-mbps <MiB/s>]
       vm-define <vm> --boot network --memory <MiB> --vcpus <n>
         --net <bridge> [--mac <mac>] [...] [--disk <dev>] [--serial-log <path>]
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

# set_disk_option <flag> <array name> <value>: a per-disk option, once, after its --disk.
set_disk_option() {
  local flag=$1 arr=$2 value=$3
  local -n dref=$arr
  if [[ ${#DISKS[@]} -eq 0 ]]; then
    log "$flag must follow the --disk it belongs to"
    usage
    exit 2
  fi
  if [[ -n "${dref[-1]}" ]]; then
    log "only one $flag per --disk"
    usage
    exit 2
  fi
  dref[-1]=$value
}

# set_nic_option <flag> <array name> <value>: a per-NIC option, once, after its --net.
set_nic_option() {
  local flag=$1 arr=$2 value=$3
  local -n ref=$arr
  if [[ ${#NETS[@]} -eq 0 ]]; then
    log "$flag must follow the --net it belongs to"
    usage
    exit 2
  fi
  if [[ "$flag" != --mac && -z "$value" ]]; then
    log "$flag needs a value"
    usage
    exit 2
  fi
  if [[ -n "${ref[-1]}" ]]; then
    log "only one $flag per --net"
    usage
    exit 2
  fi
  ref[-1]=$value
}

parse_args() {
  [[ $# -ge 1 ]] || { usage; exit 2; }
  case "$1" in
    -*) usage; exit 2 ;;
  esac
  VM=$1
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --memory | --vcpus | --disk | --net | --image | --serial-log | --boot | --mac \
        | --nic-model | --vlan-pvid | --vlan-tagged | --disk-bus | --smbios \
        | --cpu-weight | --cpu-max-pct | --mem-hard-limit | --io-weight | --disk-iops | --disk-mbps)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        case "$1" in
          --memory) MEMORY=$2 ;;
          --vcpus) VCPUS=$2 ;;
          --disk) DISKS+=("$2"); DISK_IOPS+=(""); DISK_MBPS+=("") ;;
          --disk-iops) set_disk_option "$1" DISK_IOPS "$2" ;;
          --disk-mbps) set_disk_option "$1" DISK_MBPS "$2" ;;
          --cpu-weight) CPU_WEIGHT=$2 ;;
          --cpu-max-pct) CPU_MAX_PCT=$2 ;;
          --mem-hard-limit) MEM_HARD=$2 ;;
          --io-weight) IO_WEIGHT=$2 ;;
          --net) NETS+=("$2"); MACS+=(""); PVIDS+=(""); TAGGEDS+=(""); MODELS+=("") ;;
          --mac) set_nic_option "$1" MACS "$2" ;;
          --nic-model) set_nic_option "$1" MODELS "$2" ;;
          --vlan-pvid) set_nic_option "$1" PVIDS "$2" ;;
          --vlan-tagged) set_nic_option "$1" TAGGEDS "$2" ;;
          --disk-bus) DISK_BUS=$2 ;;
          --smbios) SMBIOS=$2 ;;
          --boot) BOOT=$2 ;;
          --image) IMAGE=$2 ;;
          --serial-log) SERIAL=$2 ;;
        esac
        shift 2
        ;;
      --replace) REPLACE=1; shift ;;
      *) log "unknown argument: $1"; usage; exit 2 ;;
    esac
  done
  if [[ -z "$MEMORY" || -z "$VCPUS" || ${#NETS[@]} -eq 0 ]]; then
    usage
    exit 2
  fi
  if [[ "$BOOT" != "network" && ( ${#DISKS[@]} -eq 0 || -z "$IMAGE" ) ]]; then
    usage
    exit 2
  fi
}

# check_macs: every --mac is a lower-case unicast MAC, none used twice.
check_macs() {
  local m seen=" "
  for m in "${MACS[@]}"; do
    [[ -n "$m" ]] || continue
    [[ "$m" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || refuse "--mac '$m' is not a lower-case MAC aa:bb:cc:dd:ee:ff"
    (( (16#${m:0:2} & 1) == 0 )) || refuse "--mac '$m' is a multicast address"
    [[ "$seen" != *" $m "* ]] || refuse "--mac '$m' is given twice"
    seen+="$m "
  done
}

# check_vlans: --vlan-pvid 1-4094, --vlan-tagged a list of distinct 1-4094
# without the pvid; fills NIC_META (one <hps:nic/> per NIC that has either).
check_vlans() {
  local i p t v seen
  NIC_META=""
  for i in "${!NETS[@]}"; do
    p=${PVIDS[$i]}
    t=${TAGGEDS[$i]}
    if [[ -n "$p" ]]; then
      [[ "$p" =~ ^[1-9][0-9]{0,3}$ ]] && ((p <= 4094)) || refuse "--vlan-pvid '$p' is not 1-4094"
    fi
    if [[ -n "$t" ]]; then
      seen=",${p},"
      for v in ${t//,/ }; do
        [[ "$v" =~ ^[1-9][0-9]{0,3}$ ]] && ((v <= 4094)) || refuse "--vlan-tagged '$t': '$v' is not 1-4094"
        [[ "$seen" != *",$v,"* ]] || refuse "--vlan-tagged '$t': VLAN $v is given twice or is also the pvid"
        seen+="$v,"
      done
      [[ "$t" =~ ^[0-9]+(,[0-9]+)*$ ]] || refuse "--vlan-tagged '$t' is not a comma separated list of VLAN ids"
    fi
    if [[ -z "$p" ]] && is_filtering_bridge "${NETS[$i]}"; then
      refuse "--net '${NETS[$i]}' is a VLAN-aware (fabric) bridge: a NIC on it needs --vlan-pvid (a port without a VLAN passes nothing)"
    fi
    if [[ -n "$p$t" ]]; then
      NIC_META+="      <hps:nic index='$i'${p:+ pvid='$p'}${t:+ tagged='$t'}/>"$'\n'
    fi
  done
}

# is_filtering_bridge <bridge>: it exists and has vlan_filtering 1.
is_filtering_bridge() {
  local out
  out=$(run_q ip -d link show dev "$1") || return 1
  [[ "$out" == *"vlan_filtering 1"* ]]
}

# check_hardware: --nic-model, --disk-bus, --smbios.
check_hardware() {
  local m kv k v
  for m in "${MODELS[@]}"; do
    [[ -z "$m" || "$m" == virtio || "$m" == e1000e || "$m" == rtl8139 ]] || refuse "--nic-model '$m' is not virtio, e1000e or rtl8139"
  done
  case "$DISK_BUS" in
    virtio | scsi | sata) ;;
    *) refuse "--disk-bus '$DISK_BUS' is not virtio, scsi or sata" ;;
  esac
  [[ "$DISK_BUS" == virtio || ${#DISKS[@]} -gt 0 ]] || refuse "--disk-bus $DISK_BUS needs a --disk"
  [[ -n "$SMBIOS" ]] || return 0
  local -a parts
  IFS=',' read -r -a parts <<< "$SMBIOS"
  for kv in "${parts[@]}"; do
    [[ "$kv" == *=* ]] || refuse "--smbios '$SMBIOS': '$kv' is not key=value"
    k=${kv%%=*}
    v=${kv#*=}
    [[ "$v" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]{0,62}$ ]] || refuse "--smbios $k value '$v' must be letters, digits, space, . _ - (at most 63, first alphanumeric)"
    case "$k" in
      vendor) [[ -z "$SM_VENDOR" ]] || refuse "--smbios vendor given twice"; SM_VENDOR=$v ;;
      product) [[ -z "$SM_PRODUCT" ]] || refuse "--smbios product given twice"; SM_PRODUCT=$v ;;
      serial) [[ -z "$SM_SERIAL" ]] || refuse "--smbios serial given twice"; SM_SERIAL=$v ;;
      *) refuse "--smbios key '$k' is not vendor, product or serial" ;;
    esac
  done
  [[ -n "$SM_VENDOR" && -n "$SM_PRODUCT" ]] || refuse "--smbios needs vendor=<v> and product=<p>"
}

# check_limits: the resource limits in range; fills the defaults (CPU_WEIGHT,
# MEM_HARD). Runs after MEMORY and VCPUS are checked.
check_limits() {
  local i v
  if [[ -n "$CPU_WEIGHT" ]]; then
    [[ "$CPU_WEIGHT" =~ ^[1-9][0-9]{0,4}$ ]] && ((CPU_WEIGHT <= 10000)) || refuse "--cpu-weight '$CPU_WEIGHT' is not 1-10000"
  else
    CPU_WEIGHT=$((VCPUS * 100))
    ((CPU_WEIGHT <= 10000)) || CPU_WEIGHT=10000
  fi
  if [[ -n "$CPU_MAX_PCT" ]]; then
    [[ "$CPU_MAX_PCT" =~ ^[1-9][0-9]{0,2}$ ]] && ((CPU_MAX_PCT <= 100)) || refuse "--cpu-max-pct '$CPU_MAX_PCT' is not 1-100"
  fi
  if [[ -n "$MEM_HARD" ]]; then
    [[ "$MEM_HARD" =~ ^[1-9][0-9]{0,6}$ ]] || refuse "--mem-hard-limit '$MEM_HARD' is not a number of MiB"
    ((MEM_HARD >= MEMORY + 128)) || refuse "--mem-hard-limit $MEM_HARD is below --memory $MEMORY + 128 MiB (QEMU needs room of its own)"
  else
    MEM_HARD=$((MEMORY + 256 + MEMORY / 16))
  fi
  if [[ -n "$IO_WEIGHT" ]]; then
    [[ "$IO_WEIGHT" =~ ^[1-9][0-9]{1,3}$ ]] && ((IO_WEIGHT <= 1000)) || refuse "--io-weight '$IO_WEIGHT' is not 10-1000"
  fi
  for i in "${!DISKS[@]}"; do
    v=${DISK_IOPS[$i]}
    if [[ -n "$v" ]]; then
      [[ "$v" =~ ^[1-9][0-9]{0,7}$ ]] || refuse "--disk-iops '$v' is not 1-99999999"
    fi
    v=${DISK_MBPS[$i]}
    if [[ -n "$v" ]]; then
      [[ "$v" =~ ^[1-9][0-9]{0,5}$ ]] || refuse "--disk-mbps '$v' is not 1-999999 (MiB/s)"
    fi
  done
}

check_args() {
  local n
  [[ "$VM" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || refuse "vm name '$VM' does not match ^[a-z0-9][a-z0-9-]{0,31}\$"
  [[ "$MEMORY" =~ ^[0-9]{1,7}$ ]] || refuse "--memory '$MEMORY' is not a number of MiB"
  [[ "$VCPUS" =~ ^[0-9]{1,3}$ ]] || refuse "--vcpus '$VCPUS' is not a number"
  MEMORY=$((10#$MEMORY))
  VCPUS=$((10#$VCPUS))
  ((MEMORY >= 64)) || refuse "--memory $MEMORY is below 64 MiB"
  ((VCPUS >= 1)) || refuse "--vcpus must be at least 1"
  check_limits
  [[ "$BOOT" == "disk" || "$BOOT" == "network" ]] || refuse "--boot '$BOOT' is not disk or network"
  ((${#DISKS[@]} <= MAX_DISKS)) || refuse "${#DISKS[@]} --disk given; at most $MAX_DISKS per guest"
  local d seen=" "
  for d in "${DISKS[@]}"; do
    [[ "$d" =~ ^[A-Za-z0-9/_.:-]+$ && "$d" != *..* ]] || refuse "--disk '$d' has characters outside [A-Za-z0-9/_.:-] or contains .."
    [[ "$d" == "$HPS_DEV"/* ]] || refuse "--disk '$d' is not under $HPS_DEV"
    [[ -e "$d" && ! -d "$d" ]] || refuse "--disk '$d' does not exist"
    [[ "$seen" != *" $d "* ]] || refuse "--disk '$d' is given twice"
    seen+="$d "
  done
  for n in "${NETS[@]}"; do
    [[ "$n" =~ ^[a-z][a-z0-9_.-]{0,14}$ ]] || refuse "--net '$n' is not a bridge name"
  done
  check_serials
  check_macs
  check_hardware
  check_vlans
  if [[ -n "$IMAGE" ]]; then
    [[ "$IMAGE" =~ ^/[A-Za-z0-9/_.-]+\.qcow2$ && "$IMAGE" != *..* ]] || refuse "--image '$IMAGE' is not an absolute path ending .qcow2"
  fi
  if [[ -z "$SERIAL" ]]; then
    SERIAL="$HPS_LIBVIRT_LOGDIR/$VM-serial.log"
  fi
  [[ "$SERIAL" =~ ^/[A-Za-z0-9/_.-]+$ && "$SERIAL" != *..* ]] || refuse "--serial-log '$SERIAL' is not a plain absolute path"
}

# disk_serial <index>: the stable serial of disk index+1, "<vm>-d<N>"; when
# longer than SERIAL_MAX (the virtio-blk and ATA limit) its last SERIAL_MAX
# characters, so the disk number survives.
disk_serial() {
  local s="$VM-d$(($1 + 1))"
  if ((${#s} > SERIAL_MAX)); then
    s=${s:${#s}-SERIAL_MAX}
  fi
  printf '%s' "$s"
}

# check_serials: no two disks of the VM end up with the same serial.
check_serials() {
  local i s seen=" "
  for i in "${!DISKS[@]}"; do
    s=$(disk_serial "$i")
    [[ "$seen" != *" $s "* ]] || refuse "disk serial '$s' is used twice (vm name too long to keep the disk number)"
    seen+="$s "
  done
}

# render_xml <uuid-or-empty>: the domain XML on stdout, the spec hash inside.
render_xml() {
  local uuid=$1 n i body hash boot_xml disk_xml="" mac_xml smbios_os="" sysinfo_xml="" ctl_xml="" dev m prefix=vd letters=abcdefgh
  local tune_xml iotune_xml
  if [[ "$BOOT" == "network" ]]; then
    boot_xml="    <boot dev='network'/>"
    if ((${#DISKS[@]} > 0)); then
      boot_xml+=$'\n'"    <boot dev='hd'/>"
    fi
  else
    boot_xml="    <boot dev='hd'/>"
  fi
  if ((${#DISKS[@]} > 0)); then
    if [[ "$DISK_BUS" != virtio ]]; then
      prefix=sd
    fi
    if [[ "$DISK_BUS" == scsi ]]; then
      ctl_xml="    <controller type='scsi' index='0' model='virtio-scsi'/>"
      disk_xml="$ctl_xml"$'\n'
    fi
    for i in "${!DISKS[@]}"; do
      dev=$prefix${letters:$i:1}
      disk_xml+="    <disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native'/>
      <source dev='${DISKS[$i]}'/>
      <target dev='$dev' bus='$DISK_BUS'/>
      <serial>$(disk_serial "$i")</serial>"
      iotune_xml=""
      if [[ -n "${DISK_IOPS[$i]}" ]]; then
        iotune_xml+=$'\n'"        <total_iops_sec>${DISK_IOPS[$i]}</total_iops_sec>"
      fi
      if [[ -n "${DISK_MBPS[$i]}" ]]; then
        iotune_xml+=$'\n'"        <total_bytes_sec>$((DISK_MBPS[i] * 1048576))</total_bytes_sec>"
      fi
      if [[ -n "$iotune_xml" ]]; then
        disk_xml+=$'\n'"      <iotune>$iotune_xml"$'\n'"      </iotune>"
      fi
      disk_xml+="
    </disk>"
      if ((i < ${#DISKS[@]} - 1)); then
        disk_xml+=$'\n'
      fi
    done
  fi
  tune_xml="  <memtune>
    <hard_limit unit='MiB'>$MEM_HARD</hard_limit>
  </memtune>
  <cputune>
    <shares>$CPU_WEIGHT</shares>"
  if [[ -n "$CPU_MAX_PCT" ]]; then
    tune_xml+="
    <period>100000</period>
    <quota>$((CPU_MAX_PCT * 1000))</quota>"
  fi
  tune_xml+="
  </cputune>"
  if [[ -n "$IO_WEIGHT" ]]; then
    tune_xml+="
  <blkiotune>
    <weight>$IO_WEIGHT</weight>
  </blkiotune>"
  fi
  if [[ -n "$SM_VENDOR" ]]; then
    smbios_os="    <smbios mode='sysinfo'/>"
    sysinfo_xml="  <sysinfo type='smbios'>
    <system>
      <entry name='manufacturer'>$SM_VENDOR</entry>
      <entry name='product'>$SM_PRODUCT</entry>${SM_SERIAL:+
      <entry name='serial'>$SM_SERIAL</entry>}
    </system>
  </sysinfo>"
  fi
  body=$(
    cat <<XML
  <name>$VM</name>
  <memory unit='MiB'>$MEMORY</memory>
  <currentMemory unit='MiB'>$MEMORY</currentMemory>
  <vcpu placement='static'>$VCPUS</vcpu>
$tune_xml
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' type='pflash' format='raw'>$HPS_OVMF_CODE</loader>
    <nvram template='$HPS_OVMF_VARS' templateFormat='raw' format='raw'>$HPS_NVRAM_DIR/${VM}_VARS.fd</nvram>
$boot_xml${smbios_os:+
$smbios_os}
  </os>${sysinfo_xml:+
$sysinfo_xml}
  <features><acpi/><apic/></features>
  <cpu mode='host-passthrough' check='none'/>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
$disk_xml
XML
    for i in "${!NETS[@]}"; do
      n=${NETS[$i]}
      mac_xml=""
      if [[ -n "${MACS[$i]}" ]]; then
        mac_xml="
      <mac address='${MACS[$i]}'/>"
      fi
      m=${MODELS[$i]:-virtio}
      cat <<XML
    <interface type='bridge'>$mac_xml
      <source bridge='$n'/>
      <model type='$m'/>
    </interface>
XML
    done
    cat <<XML
    <serial type='file'>
      <source path='$SERIAL'/>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='file'>
      <source path='$SERIAL'/>
      <target type='serial' port='0'/>
    </console>
    <video><model type='none'/></video>
    <memballoon model='virtio'/>
  </devices>
XML
  )
  # The NIC VLAN metadata joins the hash only when there is any, so a
  # definition made before --vlan-* existed keeps its hash.
  hash=$(printf '%s\n%s\n%s' "$body" "$IMAGE" "${NIC_META:+$NIC_META}" | sha256sum)
  hash=${hash%% *}
  SPEC_HASH=$hash
  printf "<domain type='kvm'>\n"
  if [[ -n "$uuid" ]]; then
    printf '  <uuid>%s</uuid>\n' "$uuid"
  fi
  printf '%s\n' "$body" | sed -n '1,/<\/os>/p'
  printf "  <metadata>\n    <hps:vm xmlns:hps='urn:hps:vm'>\n"
  if [[ -n "$IMAGE" ]]; then
    printf '      <hps:image>%s</hps:image>\n' "$IMAGE"
  fi
  printf '%s' "$NIC_META"
  printf "      <hps:spec>%s</hps:spec>\n    </hps:vm>\n  </metadata>\n" "$hash"
  printf '%s\n' "$body" | sed -n '/<\/os>/,$p' | sed '1d'
  printf '</domain>\n'
}

defined_spec() {
  local xml
  xml=$(run virsh -c qemu:///system dumpxml "$VM")
  sed -n -E 's/.*<hps:spec>([0-9a-f]+)<\/hps:spec>.*/\1/p' <<< "$xml" | head -n 1
}

# report_macs: one "VM <vm> defined mac=<mac>" per NIC (--boot network only),
# read back from the defined domain so generated MACs are included.
report_macs() {
  local list mac
  list=$(run virsh -c qemu:///system domiflist "$VM")
  while read -r _ type _ _ mac; do
    if [[ "$type" == "bridge" && -n "$mac" ]]; then
      printf 'VM %s defined mac=%s\n' "$VM" "$mac"
    fi
  done <<< "$list"
}

# finish: the success lines.
finish() {
  if [[ "$BOOT" == "network" ]]; then
    report_macs
  else
    printf 'VM %s defined\n' "$VM"
  fi
}

main() {
  local have uuid="" state
  parse_args "$@"
  check_args
  TMP=/tmp/vm-define-$$
  mkdir -p "$TMP"
  trap 'rm -rf "$TMP"' EXIT
  render_xml "" > "$TMP/domain.xml"
  if run_q virsh -c qemu:///system dominfo "$VM" > /dev/null; then
    have=$(defined_spec)
    if [[ "$have" == "$SPEC_HASH" ]]; then
      log "$VM is already defined with this definition; nothing to do"
      finish
      return 0
    fi
    if ((REPLACE == 0)); then
      refuse "$VM is defined differently (spec ${have:-none}, wanted $SPEC_HASH); use --replace to redefine"
    fi
    state=$(run virsh -c qemu:///system domstate "$VM")
    if [[ "$state" == "running" || "$state" == "paused" ]]; then
      refuse "$VM is $state; --replace needs it shut off"
    fi
    uuid=$(run virsh -c qemu:///system domuuid "$VM")
    render_xml "$uuid" > "$TMP/domain.xml"
  fi
  run virsh -c qemu:///system define "$TMP/domain.xml"
  finish
}

main "$@"
