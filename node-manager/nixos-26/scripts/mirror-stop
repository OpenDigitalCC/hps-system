#!/usr/bin/env bash
#
# mirror-stop - stop the md RAID1 of a VM disk.
#
# ctrl-exec allowlisted node script.
#
# Usage: mirror-stop <name>
# Refuses (3) while the array is in use: anything in /sys/block/md*/holders, a
# mount of it in /proc/mounts, or a libvirt guest that is not shut off and has
# the device in its block list (virsh list --name; virsh domblklist; a running
# VM holds the device open without showing in holders or mounts). When virsh is
# not on PATH the libvirt check is skipped and logged. Otherwise mdadm --stop
# /dev/md/<name>. Then every iscsi: leg of the mirror (from the sidecar) is
# logged out and its node record deleted:
#   iscsiadm -m node -T <iqn> -p <portal> --logout
#   iscsiadm -m node -T <iqn> -p <portal> -o delete
# so the initiator does not retry a target that is gone (a local leg is left
# alone; no session or no record is fine). Then the sidecar is removed. Not
# assembled: nothing to stop; the iscsi: legs are logged out the same way and
# the sidecar is removed, exit 0. A logout that fails keeps the sidecar (so a
# second mirror-stop retries it) and exits 1. No sidecar: no leg is known, none
# is logged out.
# Exit: 0 done, 2 usage, 3 refused (in use), 1 a command failed.

set -euo pipefail

NAME=""

log() {
  printf '[mirror-stop] %s\n' "$*" >&2
}

usage() {
  cat >&2 <<'USAGE'
Usage: mirror-stop <name>
Exit: 0 ok, 2 usage, 3 refused (in use), 1 failed.
USAGE
}

: "${HPS_SYS:=/sys}"
: "${HPS_PROC_MOUNTS:=/proc/mounts}"

# --- shared helpers (copied into each mirror script; no runtime sourcing) ---

: "${HPS_MIRROR_DIR:=/run/hps/mirrors}"
: "${HPS_CMDLINE:=/proc/cmdline}"
: "${HPS_LEG_RESOLVE:=$(dirname "$0")/leg-resolve}"

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

refuse() {
  log "refused: $*"
  exit 3
}

check_name() {
  if [[ ! "$NAME" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    refuse "mirror name '$NAME' does not match ^[A-Za-z][A-Za-z0-9_-]*\$"
  fi
}

check_spec() {
  case "$1" in
    local:* | iscsi:*) ;;
    *) refuse "leg spec '$1' is neither local:... nor iscsi:..." ;;
  esac
}

leg_kind() {
  case "$1" in
    local:*) printf 'local\n' ;;
    *) printf 'remote\n' ;;
  esac
}

# resolve_leg <spec>: prints the device path (leg-resolve is the only code that
# knows the two kinds of leg).
resolve_leg() {
  run "$HPS_LEG_RESOLVE" "$1"
}

# pick_remote_index: REMOTE_INDEX stays as given; unset, it is the index of the
# only iscsi: leg, and empty (no write-mostly leg) when that is not unique.
pick_remote_index() {
  local i n=0 found=""
  if [[ -n "$REMOTE_INDEX" ]]; then
    if [[ "$(leg_kind "${LEGS[$REMOTE_INDEX]}")" != remote ]]; then
      refuse "--remote-index $REMOTE_INDEX names a local leg"
    fi
    return 0
  fi
  for i in 0 1; do
    if [[ "${LEGS[$i]}" == iscsi:* ]]; then
      n=$((n + 1))
      found=$i
    fi
  done
  if ((n == 1)); then
    REMOTE_INDEX=$found
  fi
}

sidecar_path() {
  printf '%s/%s.json\n' "$HPS_MIRROR_DIR" "$NAME"
}

# sidecar_write: LEGS[], DEVS[] (an empty device = leg not present), REMOTE_INDEX.
sidecar_write() {
  local i path wm legs="[]"
  path=$(sidecar_path)
  mkdir -p "$HPS_MIRROR_DIR"
  for i in 0 1; do
    wm=0
    if [[ "$REMOTE_INDEX" == "$i" ]]; then wm=1; fi
    legs=$(jq -c --arg s "${LEGS[$i]}" --arg d "${DEVS[$i]:-}" --arg k "$(leg_kind "${LEGS[$i]}")" --argjson w "$wm" \
      '. + [{spec:$s,dev:$d,kind:$k,write_mostly:$w}]' <<< "$legs")
  done
  printf '+ write %s\n' "$path" >&2
  jq -n -c --arg n "$NAME" --argjson l "$legs" --arg r "$REMOTE_INDEX" \
    '{name:$n,remote_index:(if $r == "" then null else ($r | tonumber) end),legs:$l}' > "$path"
}

array_present() {
  mdadm --detail "/dev/md/$NAME" > /dev/null 2>&1
}

# --- iSCSI leg logout (the same in mirror-stop and mirror-detach-leg) ---

# iscsiadm_tolerant <args...>: logged iscsiadm; exit 21 (no matching session or
# node record) is success: there was nothing to log out or delete.
iscsiadm_tolerant() {
  local rc=0
  printf '+ iscsiadm %s\n' "$*" >&2
  iscsiadm "$@" >&2 || rc=$?
  case $rc in
    0) ;;
    21) log "nothing to do for: iscsiadm $* (no matching session or record)" ;;
    *)
      log "iscsiadm $* failed (exit $rc)"
      return 1
      ;;
  esac
}

# leg_logout <spec>: an iscsi:<portal>:<iqn> leg's session is logged out and its
# node record deleted, so the initiator stops retrying a target that is going
# away (after a destroy the storage host logged ~70 failed logins per target).
# A local: leg is untouched. Returns 1 when iscsiadm failed.
leg_logout() {
  local spec=$1 rest ip iqn rc=0
  case "$spec" in
    iscsi:*) ;;
    *) return 0 ;;
  esac
  rest=${spec#iscsi:}
  ip=${rest%%:*}
  iqn=${rest#*:}
  if [[ ! "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || ! "$iqn" =~ ^iqn\.[0-9]{4}-[0-9]{2}\.[a-z0-9.-]+(:[A-Za-z0-9._:-]+)?$ ]]; then
    log "leg spec '$spec' is not iscsi:<portal-ip>:<iqn>; not logged out"
    return 1
  fi
  iscsiadm_tolerant -m node -T "$iqn" -p "$ip" --logout || rc=1
  iscsiadm_tolerant -m node -T "$iqn" -p "$ip" -o delete || rc=1
  return "$rc"
}

# logout_legs: leg_logout for both legs in the sidecar; 1 when one failed.
logout_legs() {
  local side spec rc=0
  side=$(sidecar_path)
  if [[ ! -r "$side" ]]; then
    log "no sidecar $side; no iSCSI leg known to log out"
    return 0
  fi
  while IFS= read -r spec; do
    leg_logout "$spec" || rc=1
  done < <(jq -r '.legs[].spec' "$side")
  return "$rc"
}

# remove_sidecar: after every leg is logged out; a failed logout keeps it.
remove_sidecar() {
  if ! logout_legs; then
    log "an iSCSI leg of $NAME was not logged out; the sidecar is kept so mirror-stop can be run again"
    exit 1
  fi
  printf '+ rm -f %s\n' "$(sidecar_path)" >&2
  rm -f -- "$(sidecar_path)"
}

parse_args() {
  [[ $# -eq 1 ]] || { usage; exit 2; }
  case "$1" in
    -*) usage; exit 2 ;;
  esac
  NAME=$1
  check_name
}

check_not_in_use() {
  local real base holders
  real=$(readlink -f -- "/dev/md/$NAME" 2> /dev/null || printf '/dev/md/%s' "$NAME")
  base=${real##*/}
  if [[ -d "$HPS_SYS/block/$base/holders" ]]; then
    holders=$(ls -A "$HPS_SYS/block/$base/holders")
    if [[ -n "$holders" ]]; then
      refuse "$NAME is in use: holders: $holders"
    fi
  fi
  if grep -qE "^(/dev/md/$NAME|$real) " "$HPS_PROC_MOUNTS"; then
    refuse "$NAME is mounted"
  fi
  check_no_guest "$real"
}

# check_no_guest <real device>: refuse when a libvirt guest that is not shut
# off lists /dev/md/<name> or its resolved device among its block devices.
check_no_guest() {
  local real="$1" dom
  if ! command -v virsh > /dev/null 2>&1; then
    log "virsh not on PATH; libvirt in-use check skipped"
    return 0
  fi
  while IFS= read -r dom; do
    [[ -n "$dom" ]] || continue
    if virsh domblklist "$dom" 2> /dev/null | grep -qE "[[:space:]](/dev/md/$NAME|$real)\$"; then
      refuse "$NAME is attached to running guest $dom"
    fi
  done < <(virsh list --name 2> /dev/null)
}

main() {
  parse_args "$@"
  if ! array_present; then
    log "/dev/md/$NAME is not assembled; nothing to stop"
    remove_sidecar
    return 0
  fi
  check_not_in_use
  run mdadm --stop "/dev/md/$NAME"
  remove_sidecar
  log "mirror $NAME stopped"
}

main "$@"
