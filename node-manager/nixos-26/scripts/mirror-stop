#!/usr/bin/env bash
#
# mirror-stop - stop the md RAID1 of a VM disk.
#
# ctrl-exec allowlisted node script.
#
# Usage: mirror-stop <name>
# Refuses (3) while the array is in use: anything in /sys/block/md*/holders, a
# mount of it in /proc/mounts, or a libvirt guest that is not shut off and has
# the device in its block list (virsh list --name; virsh domblklist; a running
# VM holds the device open without showing in holders or mounts). When virsh is
# not on PATH the libvirt check is skipped and logged. Otherwise mdadm --stop
# /dev/md/<name> and the sidecar is removed. Not assembled: nothing to stop, the sidecar is removed, exit 0.
# Exit: 0 done, 2 usage, 3 refused (in use), 1 a command failed.

set -euo pipefail

NAME=""

log() {
  printf '[mirror-stop] %s\n' "$*" >&2
}

usage() {
  cat >&2 <<'USAGE'
Usage: mirror-stop <name>
Exit: 0 ok, 2 usage, 3 refused (in use), 1 failed.
USAGE
}

: "${HPS_SYS:=/sys}"
: "${HPS_PROC_MOUNTS:=/proc/mounts}"

# --- shared helpers (copied into each mirror script; no runtime sourcing) ---

: "${HPS_MIRROR_DIR:=/run/hps/mirrors}"
: "${HPS_CMDLINE:=/proc/cmdline}"
: "${HPS_LEG_RESOLVE:=$(dirname "$0")/leg-resolve}"

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

refuse() {
  log "refused: $*"
  exit 3
}

check_name() {
  if [[ ! "$NAME" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    refuse "mirror name '$NAME' does not match ^[A-Za-z][A-Za-z0-9_-]*\$"
  fi
}

check_spec() {
  case "$1" in
    local:* | iscsi:*) ;;
    *) refuse "leg spec '$1' is neither local:... nor iscsi:..." ;;
  esac
}

leg_kind() {
  case "$1" in
    local:*) printf 'local\n' ;;
    *) printf 'remote\n' ;;
  esac
}

# resolve_leg <spec>: prints the device path (leg-resolve is the only code that
# knows the two kinds of leg).
resolve_leg() {
  run "$HPS_LEG_RESOLVE" "$1"
}

# pick_remote_index: REMOTE_INDEX stays as given; unset, it is the index of the
# only iscsi: leg, and empty (no write-mostly leg) when that is not unique.
pick_remote_index() {
  local i n=0 found=""
  if [[ -n "$REMOTE_INDEX" ]]; then
    if [[ "$(leg_kind "${LEGS[$REMOTE_INDEX]}")" != remote ]]; then
      refuse "--remote-index $REMOTE_INDEX names a local leg"
    fi
    return 0
  fi
  for i in 0 1; do
    if [[ "${LEGS[$i]}" == iscsi:* ]]; then
      n=$((n + 1))
      found=$i
    fi
  done
  if ((n == 1)); then
    REMOTE_INDEX=$found
  fi
}

sidecar_path() {
  printf '%s/%s.json\n' "$HPS_MIRROR_DIR" "$NAME"
}

# sidecar_write: LEGS[], DEVS[] (an empty device = leg not present), REMOTE_INDEX.
sidecar_write() {
  local i path wm legs="[]"
  path=$(sidecar_path)
  mkdir -p "$HPS_MIRROR_DIR"
  for i in 0 1; do
    wm=0
    if [[ "$REMOTE_INDEX" == "$i" ]]; then wm=1; fi
    legs=$(jq -c --arg s "${LEGS[$i]}" --arg d "${DEVS[$i]:-}" --arg k "$(leg_kind "${LEGS[$i]}")" --argjson w "$wm" \
      '. + [{spec:$s,dev:$d,kind:$k,write_mostly:$w}]' <<< "$legs")
  done
  printf '+ write %s\n' "$path" >&2
  jq -n -c --arg n "$NAME" --argjson l "$legs" --arg r "$REMOTE_INDEX" \
    '{name:$n,remote_index:(if $r == "" then null else ($r | tonumber) end),legs:$l}' > "$path"
}

array_present() {
  mdadm --detail "/dev/md/$NAME" > /dev/null 2>&1
}

parse_args() {
  [[ $# -eq 1 ]] || { usage; exit 2; }
  case "$1" in
    -*) usage; exit 2 ;;
  esac
  NAME=$1
  check_name
}

check_not_in_use() {
  local real base holders
  real=$(readlink -f -- "/dev/md/$NAME" 2> /dev/null || printf '/dev/md/%s' "$NAME")
  base=${real##*/}
  if [[ -d "$HPS_SYS/block/$base/holders" ]]; then
    holders=$(ls -A "$HPS_SYS/block/$base/holders")
    if [[ -n "$holders" ]]; then
      refuse "$NAME is in use: holders: $holders"
    fi
  fi
  if grep -qE "^(/dev/md/$NAME|$real) " "$HPS_PROC_MOUNTS"; then
    refuse "$NAME is mounted"
  fi
  check_no_guest "$real"
}

# check_no_guest <real device>: refuse when a libvirt guest that is not shut
# off lists /dev/md/<name> or its resolved device among its block devices.
check_no_guest() {
  local real="$1" dom
  if ! command -v virsh > /dev/null 2>&1; then
    log "virsh not on PATH; libvirt in-use check skipped"
    return 0
  fi
  while IFS= read -r dom; do
    [[ -n "$dom" ]] || continue
    if virsh domblklist "$dom" 2> /dev/null | grep -qE "[[:space:]](/dev/md/$NAME|$real)\$"; then
      refuse "$NAME is attached to running guest $dom"
    fi
  done < <(virsh list --name 2> /dev/null)
}

main() {
  parse_args "$@"
  if ! array_present; then
    log "/dev/md/$NAME is not assembled; nothing to stop"
    rm -f -- "$(sidecar_path)"
    return 0
  fi
  check_not_in_use
  run mdadm --stop "/dev/md/$NAME"
  printf '+ rm -f %s\n' "$(sidecar_path)" >&2
  rm -f -- "$(sidecar_path)"
  log "mirror $NAME stopped"
}

main "$@"
