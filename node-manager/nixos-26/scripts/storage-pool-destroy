#!/usr/bin/env bash
#
# storage-pool-destroy - destroy a ZFS pool.
#
# ctrl-exec allowlisted node script. Who may run it is ctrl-exec's decision
# (the agent's script allowlist and the dispatcher's auth hook; docs/adr/0007).
#
# Usage: storage-pool-destroy <pool>
#
# Records the pool's devices (zpool status -P), prints "WILL DESTROY: ..."
# lines, exports the pool if it is imported, imports it again with zpool
# import -f -N (a forced import is accepted ONLY here, in destroy; if that
# fails it is retried with -m, a missing log device, which is likewise
# accepted only here), zpool destroy, then zpool labelclear -f on the devices
# it recorded. A pool that is neither imported nor importable is refused. A
# refusal after the import exports the pool again.
# Exit: 0 done, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

POOL=""
DEVICES=()
IMPORTED_BY_US=0

log() {
  printf '[storage-pool-destroy] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-pool-destroy <pool>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

# Runs on every exit: a pool this script imported and did not destroy goes back.
export_back() {
  if [[ $IMPORTED_BY_US -eq 1 ]]; then
    IMPORTED_BY_US=0
    log "exporting $POOL again"
    run zpool export "$POOL" || log "zpool export failed: $POOL may still be imported"
  fi
}

parse_args() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$POOL" ]]; then
          log "only one pool name is accepted"
          usage
          exit 2
        fi
        POOL=$arg
        shift
        ;;
    esac
  done
  [[ -n "$POOL" ]] || { usage; exit 2; }
  if [[ ! "$POOL" =~ ^[a-z][a-z0-9_.-]*$ ]]; then
    refuse "pool name '$POOL' does not match ^[a-z][a-z0-9_.-]*\$"
  fi
}

pool_is_imported() {
  zpool list -H -o name "$POOL" > /dev/null 2>&1
}

# Fills DEVICES with the by-id device paths of the imported pool.
record_devices() {
  local line
  DEVICES=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && DEVICES+=("$line")
  done < <(zpool status -P "$POOL" | grep -o '/dev/disk/by-id/[^ 	]*' || true)
}

announce() {
  local d
  log "WILL DESTROY: pool $POOL"
  for d in "${DEVICES[@]}"; do
    log "WILL DESTROY: device $d"
  done
}

# Forced import is acceptable here only, in destroy; -m (missing log) only if
# the forced import alone fails.
force_import() {
  IMPORTED_BY_US=1
  if run zpool import -f -N -d /dev/disk/by-id "$POOL"; then
    return 0
  fi
  log "forced import failed; retrying with -m (missing log device), allowed in destroy only"
  if ! run zpool import -f -m -N -d /dev/disk/by-id "$POOL"; then
    IMPORTED_BY_US=0
    log "import of $POOL failed"
    exit 1
  fi
}

require_importable() {
  local listing
  printf '+ zpool import -d /dev/disk/by-id\n' >&2
  listing=$(zpool import -d /dev/disk/by-id 2>&1) || true
  if ! printf '%s\n' "$listing" | grep -Eq "^[[:space:]]*pool: ${POOL}\$"; then
    log "refused: pool '$POOL' is not importable; zpool import lists:"
    printf '%s\n' "$listing" >&2
    exit 3
  fi
}

import_for_destroy() {
  if pool_is_imported; then
    record_devices
    announce
    run zpool export "$POOL"
  else
    require_importable
  fi
  force_import
  if [[ ${#DEVICES[@]} -eq 0 ]]; then
    record_devices
    announce
  fi
}

main() {
  local d
  parse_args "$@"
  trap export_back EXIT
  import_for_destroy
  run zpool destroy "$POOL"
  IMPORTED_BY_US=0
  for d in "${DEVICES[@]}"; do
    run zpool labelclear -f "$d" || log "no ZFS label to clear on $d"
  done
  log "pool $POOL destroyed"
}

main "$@"
