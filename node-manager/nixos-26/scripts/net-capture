#!/usr/bin/env bash
#
# net-capture - READ-ONLY summary of the frames seen on one bridge or bridge
# port of this node, with link-level headers (MAC addresses, VLAN tags).
#
# ctrl-exec allowlisted node script.
# Usage: net-capture <interface> <seconds> [dhcp|all]
#   <interface>  an existing bridge, bridge port (tap) or VLAN interface
#   <seconds>    1-120, the capture length
#   dhcp         only DHCP/BOOTP (udp ports 67 and 68); the default
#   all          every frame
# Prints at most 200 lines (tcpdump -e -nn), then a count line
#   CAPTURE <interface> seconds=<n> frames=<n>
# Writes no file and changes nothing. The scale test (plans/scale-test.md)
# uses it to show that one cluster's frames never reach another's ports.
# Exit: 0 shown, 2 usage, 3 not an allowed interface, 1 tcpdump failed.

set -euo pipefail

log() {
  printf '[net-capture] %s\n' "$*" >&2
}

main() {
  local ifc="${1:-}" secs="${2:-}" what="${3:-dhcp}" kind out rc=0 n
  if [[ $# -lt 2 || $# -gt 3 ]]; then
    log "usage: net-capture <interface> <seconds> [dhcp|all]"
    exit 2
  fi
  [[ "$ifc" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,14}$ ]] || { log "bad interface name"; exit 2; }
  [[ "$secs" =~ ^[0-9]{1,3}$ ]] && ((secs >= 1 && secs <= 120)) || { log "seconds must be 1-120"; exit 2; }
  case "$what" in dhcp | all) ;; *) log "filter must be dhcp or all"; exit 2 ;; esac
  # A bridge, a bridge port or a VLAN interface only: no physical uplink capture
  # beyond what the bridge already carries, and nothing that is not there.
  kind=$(ip -d -o link show dev "$ifc" 2> /dev/null) || { log "no interface $ifc"; exit 3; }
  if [[ "$kind" != *" bridge "* && "$kind" != *"bridge_slave"* && "$kind" != *" vlan protocol"* ]]; then
    log "$ifc is not a bridge, bridge port or VLAN interface"
    exit 3
  fi
  local -a filt=()
  [[ "$what" == dhcp ]] && filt=(udp port 67 or udp port 68 or '(' vlan and '(' udp port 67 or udp port 68 ')' ')')
  printf '+ timeout %s tcpdump -i %s -e -nn -l -c 200 %s\n' "$secs" "$ifc" "${filt[*]:-}" >&2
  out=$(timeout "$secs" tcpdump -i "$ifc" -e -nn -l -c 200 "${filt[@]}" 2> /dev/null) || rc=$?
  if ((rc != 0 && rc != 124)); then
    log "tcpdump failed (exit $rc)"
    exit 1
  fi
  [[ -n "$out" ]] && printf '%s\n' "$out"
  n=0
  [[ -n "$out" ]] && n=$(printf '%s\n' "$out" | wc -l)
  printf 'CAPTURE %s seconds=%s frames=%s\n' "$ifc" "$secs" "$n"
}

main "$@"
