#!/usr/bin/env bash
#
# storage-zvol-destroy - destroy a zvol.
#
# ctrl-exec allowlisted node script. Who may run it is ctrl-exec's decision
# (the agent's script allowlist and the dispatcher's auth hook; docs/adr/0007).
#
# Usage: storage-zvol-destroy <pool>/enc/[vm/]<name>
#
# Refuses when the dataset is not a zvol, when it is exported (a LIO block
# backstore names it) or in use (mounted, or holders/partitions on the
# device), prints "WILL DESTROY: ..." and runs zfs destroy. A dataset that is
# not there exits 0 (nothing to do). Snapshots or clones make zfs destroy
# fail; they are never destroyed here.
#
# Exit: 0 done, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

DATASET=""

log() {
  printf '[storage-zvol-destroy] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-zvol-destroy <pool>/enc/[vm/]<name>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

parse_args() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$DATASET" ]]; then
          log "only one dataset is accepted"
          usage
          exit 2
        fi
        DATASET=$arg
        shift
        ;;
    esac
  done
  [[ -n "$DATASET" ]] || { usage; exit 2; }
  if [[ ! "$DATASET" =~ ^[a-z][a-z0-9_.-]*/enc/(vm/)?[A-Za-z0-9_-]+$ ]]; then
    refuse "dataset '$DATASET' is not <pool>/enc/[vm/]<name>"
  fi
}

# Exits 0 when there is nothing to destroy; refuses a dataset that is not a zvol.
require_zvol() {
  local type
  printf '+ zfs list -H -o type %s\n' "$DATASET" >&2
  if ! type=$(zfs list -H -o type "$DATASET" 2> /dev/null); then
    log "$DATASET does not exist; nothing to do"
    exit 0
  fi
  if [[ "$type" != "volume" ]]; then
    refuse "'$DATASET' is a $type, not a zvol"
  fi
}

# Refuses while a LIO block backstore points at the zvol (by device or by the
# backstore name iscsi-export gives it). Fails closed if targetcli cannot say.
refuse_if_exported() {
  local ls name=${DATASET//\//_}
  printf '+ targetcli ls /backstores/block\n' >&2
  ls=$(targetcli ls /backstores/block 2> /dev/null) || {
    log "cannot list the LIO backstores; not destroying what may be exported"
    exit 1
  }
  if printf '%s\n' "$ls" | grep -qF "/dev/zvol/${DATASET} " || printf '%s\n' "$ls" | grep -qF "o- ${name} "; then
    refuse "'$DATASET' is exported (a block backstore uses it); run iscsi-unexport first"
  fi
}

# Refuses while the device is mounted or has holders/partitions.
refuse_if_in_use() {
  local rows first rest
  printf '+ lsblk -n -r -o TYPE,MOUNTPOINTS /dev/zvol/%s\n' "$DATASET" >&2
  rows=$(lsblk -n -r -o TYPE,MOUNTPOINTS "/dev/zvol/$DATASET" 2> /dev/null) || rows=""
  first=${rows%%$'\n'*}
  rest=""
  if [[ "$rows" == *$'\n'* ]]; then
    rest=${rows#*$'\n'}
  fi
  if [[ -n "$rest" ]]; then
    refuse "'$DATASET' is in use (holders or partitions on the device)"
  fi
  if [[ "$first" == *" "* && -n "${first#* }" ]]; then
    refuse "'$DATASET' is in use (mounted at ${first#* })"
  fi
}

main() {
  parse_args "$@"
  require_zvol
  refuse_if_exported
  refuse_if_in_use
  log "WILL DESTROY: zvol $DATASET"
  run zfs destroy "$DATASET"
  log "zvol $DATASET destroyed"
}

main "$@"
