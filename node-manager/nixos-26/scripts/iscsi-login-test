#!/usr/bin/env bash
#
# iscsi-login-test - prove this node can reach an iSCSI target over the network.
#
# ctrl-exec allowlisted node script (profile node). The node-to-node proof of
# CS-3.12a: log in to <portal-ip>/<iqn> the way a mirror leg does (leg-resolve
# iscsi:<portal>:<iqn>), read the first MiB of the LUN, then log out and delete
# the node record so the test leaves nothing behind.
#
# Usage: iscsi-login-test <portal-ip> <iqn>
#
# Refuses (3) when a session for the iqn is already logged in: that session
# belongs to someone (a mirror leg), and this test would log it out.
#
# Calls, in order: iscsiadm -m session; leg-resolve (discovery, login, wait for
# the device); dd (read 1 MiB); iscsiadm --logout; iscsiadm -o delete.
# The resolved device is printed on its own line; the last line on success is
#   ISCSI <iqn> <device> <bytes read> OK
# Exit: 0 read ok, 1 a command failed (or short read), 2 usage, 3 refused
# (bad portal or iqn, a session already exists, the LUN did not appear).
# Test hook: HPS_LEG_RESOLVE (default: leg-resolve next to this script).

set -euo pipefail

: "${HPS_LEG_RESOLVE:=$(dirname "$0")/leg-resolve}"

PORTAL=""
IQN=""
DEVICE=""
BYTES=0
WANT=1048576

log() {
  printf '[iscsi-login-test] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: iscsi-login-test <portal-ip> <iqn>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

refuse() {
  log "refused: $*"
  exit 3
}

parse_args() {
  [[ $# -eq 2 ]] || { usage; exit 2; }
  case "$1$2" in
    -*) usage; exit 2 ;;
  esac
  PORTAL=$1
  IQN=$2
  [[ "$PORTAL" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || refuse "portal '$PORTAL' is not an IPv4 address"
  [[ "$IQN" =~ ^iqn\.[0-9]{4}-[0-9]{2}\.[a-z0-9.-]+(:[A-Za-z0-9._:-]+)?$ ]] || refuse "iqn '$IQN' is not an iSCSI qualified name"
}

# session_present: a session for the iqn is logged in.
session_present() {
  local sessions
  printf '+ iscsiadm -m session\n' >&2
  sessions=$(iscsiadm -m session 2> /dev/null || true)
  grep -qF -- "$IQN" <<< "$sessions"
}

# read_first_mib: BYTES = what dd delivered from the first MiB of the device.
read_first_mib() {
  printf '+ dd if=%s of=/dev/null bs=1M count=1 | wc -c\n' "$DEVICE" >&2
  BYTES=$(dd if="$DEVICE" bs=1M count=1 status=none | wc -c)
  BYTES=$((BYTES + 0))
  log "read $BYTES bytes from $DEVICE"
}

# cleanup: log out and delete the node record; prints nothing on stdout.
# Returns 1 when either command failed.
cleanup() {
  local rc=0
  if session_present; then
    run iscsiadm -m node -T "$IQN" -p "$PORTAL" --logout >&2 || rc=1
  fi
  run iscsiadm -m node -T "$IQN" -p "$PORTAL" -o delete >&2 || rc=1
  return "$rc"
}

main() {
  local rc=0 clean=0
  parse_args "$@"
  if session_present; then
    refuse "a session for $IQN is already logged in; this test would log it out"
  fi
  DEVICE=$(run "$HPS_LEG_RESOLVE" "iscsi:$PORTAL:$IQN") || rc=$?
  if [[ $rc -eq 0 ]]; then
    printf '%s\n' "$DEVICE"
    read_first_mib || rc=1
  fi
  cleanup || clean=1
  if [[ $rc -ne 0 ]]; then
    exit "$rc"
  fi
  if [[ $clean -ne 0 ]]; then
    log "the test read the LUN but could not log out cleanly"
    exit 1
  fi
  if [[ $BYTES -ne $WANT ]]; then
    log "short read: $BYTES of $WANT bytes"
    exit 1
  fi
  printf 'ISCSI %s %s %s OK\n' "$IQN" "$DEVICE" "$BYTES"
}

main "$@"
