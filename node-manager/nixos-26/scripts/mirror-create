#!/usr/bin/env bash
#
# mirror-create - create the md RAID1 for a VM disk from two legs.
#
# ctrl-exec allowlisted node script (input=raw: stdin is read ONLY when a
# wipe approval is needed).
#
# Usage: mirror-create <name> --leg <spec> --leg <spec> [--remote-index 0|1]
#                      [--approval-file <path|->]
#   <name>  the mirror, <vm>-<disk>; the array is /dev/md/<name>
#   <spec>  local:<pool>/enc/vm/<name> | iscsi:<portal-ip>:<iqn>  (see leg-resolve)
#   --remote-index  which --leg is the remote one (marked --write-mostly);
#                   default: the only iscsi: leg; with none or two, no leg is
#
# Both legs are resolved with leg-resolve. A device that carries any signature
# (blkid) or md superblock (mdadm --examine) is refused unless
# --approval-file carries a mirror-create approval with wipe=1 from the IPS (the
# approval document of storage-pool-destroy: {"approval":{...},"secret":"<hex>"};
# action mirror-create, pool = the mirror name, disks = the two leg specs, mac =
# this node); the devices are then wiped (wipefs -a). Clean devices need no
# approval. Then:
#   mdadm --create /dev/md/<name> --run --level=1 --raid-devices=2 --metadata=1.2
#         --bitmap=internal --name=<name> <other-leg> --write-mostly <remote-leg>
# (the write-mostly leg is listed last so the flag covers it alone) and
# mdadm --detail. It returns once the array exists; the first resync runs on in
# the kernel. A mirror that already exists with exactly these members is left
# as it is (exit 0). The sidecar /run/hps/mirrors/<name>.json records the legs.
# Exit: 0 done, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

NAME=""
LEGS=()
REMOTE_INDEX=""
APPROVAL_FILE=""
APPROVAL_WHAT="approval"
PAYLOAD=""
HMAC_KEY=""
DEVS=()

log() {
  printf '[mirror-create] %s\n' "$*" >&2
}

usage() {
  cat >&2 <<'USAGE'
Usage: mirror-create <name> --leg <spec> --leg <spec> [--remote-index 0|1] [--approval-file <path|->]
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

# --- shared helpers (copied into each mirror script; no runtime sourcing) ---

: "${HPS_MIRROR_DIR:=/run/hps/mirrors}"
: "${HPS_CMDLINE:=/proc/cmdline}"
: "${HPS_LEG_RESOLVE:=$(dirname "$0")/leg-resolve}"

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

refuse() {
  log "refused: $*"
  exit 3
}

check_name() {
  if [[ ! "$NAME" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    refuse "mirror name '$NAME' does not match ^[A-Za-z][A-Za-z0-9_-]*\$"
  fi
}

check_spec() {
  case "$1" in
    local:* | iscsi:*) ;;
    *) refuse "leg spec '$1' is neither local:... nor iscsi:..." ;;
  esac
}

leg_kind() {
  case "$1" in
    local:*) printf 'local\n' ;;
    *) printf 'remote\n' ;;
  esac
}

# resolve_leg <spec>: prints the device path (leg-resolve is the only code that
# knows the two kinds of leg).
resolve_leg() {
  run "$HPS_LEG_RESOLVE" "$1"
}

# pick_remote_index: REMOTE_INDEX stays as given; unset, it is the index of the
# only iscsi: leg, and empty (no write-mostly leg) when that is not unique.
pick_remote_index() {
  local i n=0 found=""
  if [[ -n "$REMOTE_INDEX" ]]; then
    if [[ "$(leg_kind "${LEGS[$REMOTE_INDEX]}")" != remote ]]; then
      refuse "--remote-index $REMOTE_INDEX names a local leg"
    fi
    return 0
  fi
  for i in 0 1; do
    if [[ "${LEGS[$i]}" == iscsi:* ]]; then
      n=$((n + 1))
      found=$i
    fi
  done
  if ((n == 1)); then
    REMOTE_INDEX=$found
  fi
}

sidecar_path() {
  printf '%s/%s.json\n' "$HPS_MIRROR_DIR" "$NAME"
}

# sidecar_write: LEGS[], DEVS[] (an empty device = leg not present), REMOTE_INDEX.
sidecar_write() {
  local i path wm legs="[]"
  path=$(sidecar_path)
  mkdir -p "$HPS_MIRROR_DIR"
  for i in 0 1; do
    wm=0
    if [[ "$REMOTE_INDEX" == "$i" ]]; then wm=1; fi
    legs=$(jq -c --arg s "${LEGS[$i]}" --arg d "${DEVS[$i]:-}" --arg k "$(leg_kind "${LEGS[$i]}")" --argjson w "$wm" \
      '. + [{spec:$s,dev:$d,kind:$k,write_mostly:$w}]' <<< "$legs")
  done
  printf '+ write %s\n' "$path" >&2
  jq -n -c --arg n "$NAME" --argjson l "$legs" --arg r "$REMOTE_INDEX" \
    '{name:$n,remote_index:(if $r == "" then null else ($r | tonumber) end),legs:$l}' > "$path"
}

array_present() {
  mdadm --detail "/dev/md/$NAME" > /dev/null 2>&1
}

parse_args() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      --leg | --remote-index | --approval-file)
        [[ $# -ge 2 ]] || { log "$arg needs a value"; usage; exit 2; }
        case "$arg" in
          --leg) LEGS+=("$2") ;;
          --remote-index) REMOTE_INDEX=$2 ;;
          --approval-file) APPROVAL_FILE=$2 ;;
        esac
        shift 2
        ;;
      --secret-from-stdin) shift ;;
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$NAME" ]]; then
          log "only one mirror name is accepted"
          usage
          exit 2
        fi
        NAME=$arg
        shift
        ;;
    esac
  done
  [[ -n "$NAME" && ${#LEGS[@]} -eq 2 ]] || { usage; exit 2; }
  if [[ -n "$REMOTE_INDEX" && ! "$REMOTE_INDEX" =~ ^[01]$ ]]; then
    log "--remote-index must be 0 or 1"
    usage
    exit 2
  fi
  check_name
  check_spec "${LEGS[0]}"
  check_spec "${LEGS[1]}"
  if [[ "${LEGS[0]}" == "${LEGS[1]}" ]]; then
    refuse "the two legs are the same"
  fi
  pick_remote_index
}

# --- approval document (same canonical JSON + HMAC as storage-pool-destroy) ---

read_payload() {
  log "reading the $APPROVAL_WHAT document from ${APPROVAL_FILE/#-/stdin}"
  if [[ "$APPROVAL_FILE" == "-" ]]; then
    PAYLOAD=$(cat)
  else
    PAYLOAD=$(cat -- "$APPROVAL_FILE")
  fi
  if ! printf '%s' "$PAYLOAD" | jq -e 'type == "object"' > /dev/null 2>&1; then
    refuse "the $APPROVAL_WHAT input is not a JSON object"
  fi
}

payload_field() {
  printf '%s' "$PAYLOAD" | jq -r "$1"
}

# hmac_sha256_hex <key-hex>: HMAC-SHA256 of stdin, as hex, computed from the
# definition so the key never appears on a command line.
hmac_sha256_hex() {
  local key=$1 i b ipad="" opad="" inner msg
  msg=$(cat)
  for ((i = 0; i < 64; i++)); do
    if ((i < 32)); then
      b=$((16#${key:$((i * 2)):2}))
    else
      b=0
    fi
    ipad+=$(printf '%02x' $((b ^ 0x36)))
    opad+=$(printf '%02x' $((b ^ 0x5c)))
  done
  inner=$({ printf '%s' "$ipad" | xxd -r -p; printf '%s' "$msg"; } | openssl dgst -sha256 -r | awk '{print $1}')
  { printf '%s' "$opad" | xxd -r -p; printf '%s' "$inner" | xxd -r -p; } | openssl dgst -sha256 -r | awk '{print $1}'
}

this_mac() {
  local word
  for word in $(cat "$HPS_CMDLINE"); do
    if [[ "$word" == hps.mac=* ]]; then
      printf '%s\n' "${word#hps.mac=}" | tr -d ':' | tr 'A-F' 'a-f'
      return 0
    fi
  done
  return 1
}

# verify_approval <action>: HMAC, expiry, action, this node, pool == mirror
# name, disks == the two leg specs of the request.
verify_approval() {
  local want_action=$1 full canon want got now exp mac thismac approved have
  log "+ verifying the $APPROVAL_WHAT (HMAC-SHA256 over the canonical JSON; key not logged)"
  if ! printf '%s' "$PAYLOAD" | jq -e '.approval | type == "object" and (keys == ["action","disks","expires","hmac","issued_by","mac","pool","wipe"])' > /dev/null 2>&1; then
    refuse "$APPROVAL_WHAT must carry exactly: action, disks, expires, issued_by, mac, pool, wipe"
  fi
  HMAC_KEY=$(payload_field '.secret // ""')
  if [[ ! "$HMAC_KEY" =~ ^[0-9a-fA-F]{64}$ ]]; then
    refuse "$APPROVAL_WHAT key must be 64 hex characters"
  fi
  full=$(printf '%s' "$PAYLOAD" | jq -S -c '.approval')
  want=$(printf '%s' "$full" | grep -oE '"hmac":"[0-9a-f]{64}",' | sed -e 's/^"hmac":"//' -e 's/",$//') || want=""
  canon=$(printf '%s' "$full" | sed -E 's/"hmac":"[0-9a-f]{64}",//')
  got=$(printf '%s' "$canon" | hmac_sha256_hex "$HMAC_KEY")
  # cmp over both strings: no short-circuit on the first differing character.
  if [[ -z "$want" ]] || ! cmp -s <(printf '%s' "$want") <(printf '%s' "$got"); then
    refuse "$APPROVAL_WHAT HMAC does not match"
  fi
  now=$(date +%s)
  exp=$(payload_field '.approval.expires')
  if [[ ! "$exp" =~ ^[0-9]+$ ]] || ((exp <= now)); then
    refuse "$APPROVAL_WHAT has expired"
  fi
  if [[ "$(payload_field '.approval.action')" != "$want_action" ]]; then
    refuse "$APPROVAL_WHAT action is not $want_action"
  fi
  mac=$(payload_field '.approval.mac' | tr -d ':' | tr 'A-F' 'a-f')
  thismac=$(this_mac) || refuse "hps.mac is not on the kernel command line"
  if [[ "$mac" != "$thismac" ]]; then
    refuse "$APPROVAL_WHAT is for a different node"
  fi
  if [[ "$(payload_field '.approval.pool')" != "$NAME" ]]; then
    refuse "$APPROVAL_WHAT is for a different mirror"
  fi
  approved=$(payload_field '.approval.disks | sort | join(",")')
  have=$(printf '%s\n' "${LEGS[@]}" | LC_ALL=C sort | paste -sd, -)
  if [[ "$have" != "$approved" ]]; then
    refuse "$APPROVAL_WHAT names legs ($approved) that are not this request's legs ($have)"
  fi
  log "$APPROVAL_WHAT verified: issued_by $(payload_field '.approval.issued_by')"
}

# has_signature <device>: 0 when the device carries a filesystem/RAID/LVM
# signature or an md superblock.
has_signature() {
  local dev=$1
  printf '+ blkid -p %s\n' "$dev" >&2
  if blkid -p "$dev" > /dev/null 2>&1; then
    return 0
  fi
  printf '+ mdadm --examine %s\n' "$dev" >&2
  if mdadm --examine "$dev" > /dev/null 2>&1; then
    return 0
  fi
  return 1
}

# Is /dev/md/<name> already an array of exactly these two devices?
existing_array_matches() {
  local detail dev real
  detail=$(mdadm --detail "/dev/md/$NAME" 2> /dev/null) || return 1
  for dev in "${DEVS[@]}"; do
    real=$(readlink -f -- "$dev")
    if ! grep -qF -e "$dev" -e "$real" <<< "$detail"; then
      refuse "/dev/md/$NAME exists and does not hold $dev; mirror-stop it first"
    fi
  done
  return 0
}

# wipe_needed: devices that carry a signature, announced; refuses without a
# wipe approval.
wipe_if_approved() {
  local i dirty=()
  for i in 0 1; do
    if has_signature "${DEVS[$i]}"; then
      dirty+=("$i")
    fi
  done
  if [[ ${#dirty[@]} -eq 0 ]]; then
    return 0
  fi
  for i in "${dirty[@]}"; do
    log "${LEGS[$i]} (${DEVS[$i]}) carries a signature or an md superblock"
  done
  if [[ -z "$APPROVAL_FILE" ]]; then
    refuse "a device is not clean; a mirror-create approval with wipe=1 is needed (to re-use an existing mirror use mirror-assemble)"
  fi
  APPROVAL_WHAT="approval"
  read_payload
  verify_approval mirror-create
  if [[ "$(payload_field '.approval.wipe')" != "1" ]]; then
    refuse "the approval does not say wipe=1"
  fi
  for i in "${dirty[@]}"; do
    log "WILL WIPE: ${LEGS[$i]} (${DEVS[$i]})"
    run mdadm --zero-superblock "${DEVS[$i]}" || log "no md superblock to clear on ${DEVS[$i]}"
    run wipefs -a "${DEVS[$i]}"
  done
}

create_array() {
  local first second
  if [[ -n "$REMOTE_INDEX" ]]; then
    second=$REMOTE_INDEX
    first=$((1 - REMOTE_INDEX))
    run mdadm --create "/dev/md/$NAME" --run --level=1 --raid-devices=2 --metadata=1.2 \
      --bitmap=internal --name="$NAME" "${DEVS[$first]}" --write-mostly "${DEVS[$second]}"
  else
    run mdadm --create "/dev/md/$NAME" --run --level=1 --raid-devices=2 --metadata=1.2 \
      --bitmap=internal --name="$NAME" "${DEVS[0]}" "${DEVS[1]}"
  fi
}

main() {
  parse_args "$@"
  DEVS[0]=$(resolve_leg "${LEGS[0]}")
  DEVS[1]=$(resolve_leg "${LEGS[1]}")
  if existing_array_matches; then
    log "/dev/md/$NAME already exists with these legs; nothing to do"
    sidecar_write
    return 0
  fi
  wipe_if_approved
  create_array
  sidecar_write
  run mdadm --detail "/dev/md/$NAME"
  log "mirror $NAME created"
}

main "$@"
