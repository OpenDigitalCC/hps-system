#!/usr/bin/env bash
#
# mirror-create - create the md RAID1 for a VM disk from two legs.
#
# ctrl-exec allowlisted node script. Who may run it is ctrl-exec's decision
# (the agent's script allowlist and the dispatcher's auth hook; docs/adr/0007).
#
# Usage: mirror-create <name> --leg <spec> --leg <spec> [--remote-index 0|1] [--wipe]
#   <name>  the mirror, <vm>-<disk>; the array is /dev/md/<name>
#   <spec>  local:<pool>/enc/vm/<name> | iscsi:<portal-ip>:<iqn>  (see leg-resolve)
#   --remote-index  which --leg is the remote one (marked --write-mostly);
#                   default: the only iscsi: leg; with none or two, no leg is
#
# Both legs are resolved with leg-resolve. A device that carries any signature
# (blkid) or md superblock (mdadm --examine) is refused unless --wipe is given;
# with --wipe those devices (only they) are announced ("WILL WIPE: ...") and
# wiped (mdadm --zero-superblock, wipefs -a). Then:
#   mdadm --create /dev/md/<name> --run --level=1 --raid-devices=2 --metadata=1.2
#         --bitmap=internal --name=<name> <other-leg> --write-mostly <remote-leg>
# (the write-mostly leg is listed last so the flag covers it alone) and
# mdadm --detail. It returns once the array exists; the first resync runs on in
# the kernel. A mirror that already exists with exactly these members is left
# as it is (exit 0). The sidecar /run/hps/mirrors/<name>.json records the legs.
# Exit: 0 done, 2 usage, 3 refused, 1 a command failed.

set -euo pipefail

NAME=""
LEGS=()
REMOTE_INDEX=""
WIPE=0
DEVS=()

log() {
  printf '[mirror-create] %s\n' "$*" >&2
}

usage() {
  cat >&2 <<'USAGE'
Usage: mirror-create <name> --leg <spec> --leg <spec> [--remote-index 0|1] [--wipe]
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

# --- shared helpers (copied into each mirror script; no runtime sourcing) ---

: "${HPS_MIRROR_DIR:=/run/hps/mirrors}"
: "${HPS_LEG_RESOLVE:=$(dirname "$0")/leg-resolve}"

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

refuse() {
  log "refused: $*"
  exit 3
}

check_name() {
  if [[ ! "$NAME" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    refuse "mirror name '$NAME' does not match ^[A-Za-z][A-Za-z0-9_-]*\$"
  fi
}

check_spec() {
  case "$1" in
    local:* | iscsi:*) ;;
    *) refuse "leg spec '$1' is neither local:... nor iscsi:..." ;;
  esac
}

leg_kind() {
  case "$1" in
    local:*) printf 'local\n' ;;
    *) printf 'remote\n' ;;
  esac
}

# resolve_leg <spec>: prints the device path (leg-resolve is the only code that
# knows the two kinds of leg).
resolve_leg() {
  run "$HPS_LEG_RESOLVE" "$1"
}

# pick_remote_index: REMOTE_INDEX stays as given; unset, it is the index of the
# only iscsi: leg, and empty (no write-mostly leg) when that is not unique.
pick_remote_index() {
  local i n=0 found=""
  if [[ -n "$REMOTE_INDEX" ]]; then
    if [[ "$(leg_kind "${LEGS[$REMOTE_INDEX]}")" != remote ]]; then
      refuse "--remote-index $REMOTE_INDEX names a local leg"
    fi
    return 0
  fi
  for i in 0 1; do
    if [[ "${LEGS[$i]}" == iscsi:* ]]; then
      n=$((n + 1))
      found=$i
    fi
  done
  if ((n == 1)); then
    REMOTE_INDEX=$found
  fi
}

sidecar_path() {
  printf '%s/%s.json\n' "$HPS_MIRROR_DIR" "$NAME"
}

# sidecar_write: LEGS[], DEVS[] (an empty device = leg not present), REMOTE_INDEX.
sidecar_write() {
  local i path wm legs="[]"
  path=$(sidecar_path)
  mkdir -p "$HPS_MIRROR_DIR"
  for i in 0 1; do
    wm=0
    if [[ "$REMOTE_INDEX" == "$i" ]]; then wm=1; fi
    legs=$(jq -c --arg s "${LEGS[$i]}" --arg d "${DEVS[$i]:-}" --arg k "$(leg_kind "${LEGS[$i]}")" --argjson w "$wm" \
      '. + [{spec:$s,dev:$d,kind:$k,write_mostly:$w}]' <<< "$legs")
  done
  printf '+ write %s\n' "$path" >&2
  jq -n -c --arg n "$NAME" --argjson l "$legs" --arg r "$REMOTE_INDEX" \
    '{name:$n,remote_index:(if $r == "" then null else ($r | tonumber) end),legs:$l}' > "$path"
}

array_present() {
  mdadm --detail "/dev/md/$NAME" > /dev/null 2>&1
}

parse_args() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      --leg | --remote-index)
        [[ $# -ge 2 ]] || { log "$arg needs a value"; usage; exit 2; }
        case "$arg" in
          --leg) LEGS+=("$2") ;;
          --remote-index) REMOTE_INDEX=$2 ;;
        esac
        shift 2
        ;;
      --wipe)
        WIPE=1
        shift
        ;;
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$NAME" ]]; then
          log "only one mirror name is accepted"
          usage
          exit 2
        fi
        NAME=$arg
        shift
        ;;
    esac
  done
  [[ -n "$NAME" && ${#LEGS[@]} -eq 2 ]] || { usage; exit 2; }
  if [[ -n "$REMOTE_INDEX" && ! "$REMOTE_INDEX" =~ ^[01]$ ]]; then
    log "--remote-index must be 0 or 1"
    usage
    exit 2
  fi
  check_name
  check_spec "${LEGS[0]}"
  check_spec "${LEGS[1]}"
  if [[ "${LEGS[0]}" == "${LEGS[1]}" ]]; then
    refuse "the two legs are the same"
  fi
  pick_remote_index
}

# has_signature <device>: 0 when the device carries a filesystem/RAID/LVM
# signature or an md superblock.
has_signature() {
  local dev=$1
  printf '+ blkid -p %s\n' "$dev" >&2
  if blkid -p "$dev" > /dev/null 2>&1; then
    return 0
  fi
  printf '+ mdadm --examine %s\n' "$dev" >&2
  if mdadm --examine "$dev" > /dev/null 2>&1; then
    return 0
  fi
  return 1
}

# Is /dev/md/<name> already an array of exactly these two devices?
existing_array_matches() {
  local detail dev real
  detail=$(mdadm --detail "/dev/md/$NAME" 2> /dev/null) || return 1
  for dev in "${DEVS[@]}"; do
    real=$(readlink -f -- "$dev")
    if ! grep -qF -e "$dev" -e "$real" <<< "$detail"; then
      refuse "/dev/md/$NAME exists and does not hold $dev; mirror-stop it first"
    fi
  done
  return 0
}

# wipe_if_asked: devices that carry a signature, announced; refused without
# --wipe.
wipe_if_asked() {
  local i dirty=()
  for i in 0 1; do
    if has_signature "${DEVS[$i]}"; then
      dirty+=("$i")
    fi
  done
  if [[ ${#dirty[@]} -eq 0 ]]; then
    return 0
  fi
  for i in "${dirty[@]}"; do
    log "${LEGS[$i]} (${DEVS[$i]}) carries a signature or an md superblock"
  done
  if [[ $WIPE -ne 1 ]]; then
    refuse "a device is not clean; --wipe is needed to wipe it (to re-use an existing mirror use mirror-assemble)"
  fi
  for i in "${dirty[@]}"; do
    log "WILL WIPE: ${LEGS[$i]} (${DEVS[$i]})"
    run mdadm --zero-superblock "${DEVS[$i]}" || log "no md superblock to clear on ${DEVS[$i]}"
    run wipefs -a "${DEVS[$i]}"
  done
}

create_array() {
  local first second
  if [[ -n "$REMOTE_INDEX" ]]; then
    second=$REMOTE_INDEX
    first=$((1 - REMOTE_INDEX))
    run mdadm --create "/dev/md/$NAME" --run --level=1 --raid-devices=2 --metadata=1.2 \
      --bitmap=internal --name="$NAME" "${DEVS[$first]}" --write-mostly "${DEVS[$second]}"
  else
    run mdadm --create "/dev/md/$NAME" --run --level=1 --raid-devices=2 --metadata=1.2 \
      --bitmap=internal --name="$NAME" "${DEVS[0]}" "${DEVS[1]}"
  fi
}

main() {
  parse_args "$@"
  DEVS[0]=$(resolve_leg "${LEGS[0]}")
  DEVS[1]=$(resolve_leg "${LEGS[1]}")
  if existing_array_matches; then
    log "/dev/md/$NAME already exists with these legs; nothing to do"
    sidecar_write
    return 0
  fi
  wipe_if_asked
  create_array
  sidecar_write
  run mdadm --detail "/dev/md/$NAME"
  log "mirror $NAME created"
}

main "$@"
