#!/usr/bin/env bash
#
# cnh-disk-prepare - give a container host (CNH) its persistent disk.
#
# ctrl-exec allowlisted node script (CNH image only: profiles/container-host.nix).
#
# Usage: cnh-disk-prepare <device>
#
#   <device>  /dev/vd<x>, /dev/sd<x> (whole disks), /dev/md/<name> or
#             /dev/disk/by-id/<id>; anything else is refused.
#
# The device is probed with `blkid -p` (filesystems, RAID members, partition
# tables, ZFS labels):
#
#   no signature at all   an ext4 filesystem labelled hps-cnh is made on it
#                         (the only mkfs in HPS's container-host path)
#   ext4 labelled hps-cnh already prepared: mounted, never formatted again
#   anything else         refused (exit 3), nothing is written
#
# Then hps-cnh-mount.service (the boot unit, profiles/container-host.nix) is
# restarted: it finds the disk by its label and mounts it at /var/lib/containers
# (podman's storage) with its directory hps-ips bind-mounted at /var/lib/hps-ips
# (the IPS state that cnh-ips-bootstrap fills and cnh-ips-run serves). It never
# formats. The restart is synchronous (oneshot: systemctl returns when its
# script has finished); the unit must then be active and both mounts in the
# host's mount table, else exit 1.
#
# Why the unit mounts and this script does not (IPS-34 item 11): the ctrl-exec
# executor runs every node script in a mount namespace of its own
# (unshare(CLONE_NEWNS), then mount(/, MS_REC | MS_PRIVATE): ctrl-exec
# src/ctrl-exec-executor.c), a private copy of the host's mount table. A mount
# this script made lived in that copy and vanished with the script: on s2 and
# s3 the prepare reported both mounts and cnh-ips-bootstrap, a second later,
# saw /var/lib/hps-ips unmounted, until a reboot let hps-cnh-mount mount the
# disk. systemctl asks PID 1, which mounts in the host's namespace, where every
# later script's copy starts from. For the same reason a mount the unit makes
# while this script runs never appears in this script's own table, so the
# checks read PID 1's (findmnt -N 1), never findmnt's default view.
#
# Idempotent: run again on a prepared and mounted disk, it changes nothing (the
# unit is not restarted; a restart would also restart hps-ips.service, which
# Requires it). A mount point that already holds files, or another device, is
# refused (the state there would be hidden or mixed).
#
# Last line: CNH-DISK <device> formatted=<yes|no> containers=<dir> ips=<dir>
# Exit: 0 ok, 2 usage, 3 refused, 1 a command failed.
#
# Overrides for tests: HPS_DEV (device root, regular files allowed when it is
# not /dev), HPS_CNH_ROOT (prefix of the two mount points).

set -euo pipefail

: "${HPS_DEV:=/dev}"
: "${HPS_CNH_ROOT:=}"

LABEL=hps-cnh
UNIT=hps-cnh-mount.service
DEV=""
CONTAINERS="$HPS_CNH_ROOT/var/lib/containers"
IPSDIR="$HPS_CNH_ROOT/var/lib/hps-ips"
SIG_TYPE=""
SIG_LABEL=""
SIG_OTHER=""

log() {
  printf '[cnh-disk-prepare] %s\n' "$*" >&2
}

refuse() {
  log "refused: $*"
  exit 3
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: cnh-disk-prepare <device>
  <device>: /dev/vd<x>, /dev/sd<x>, /dev/md/<name> or /dev/disk/by-id/<id>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

check_device() {
  local rest
  [[ "$DEV" != *..* && "$DEV" != *//* ]] || refuse "device '$DEV' contains '..' or '//'"
  [[ "$DEV" == "$HPS_DEV"/* ]] || refuse "device '$DEV' is not under $HPS_DEV"
  rest=${DEV#"$HPS_DEV"/}
  if [[ "$rest" =~ ^(vd|sd)[a-z]{1,3}$ ]]; then
    :
  elif [[ "$rest" =~ ^md/[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$ ]]; then
    :
  elif [[ "$rest" =~ ^disk/by-id/[A-Za-z0-9_][A-Za-z0-9_.:+@-]{0,127}$ ]]; then
    :
  else
    refuse "device '$DEV' is not /dev/vd<x>, /dev/sd<x>, /dev/md/<name> or /dev/disk/by-id/<id>"
  fi
  if [[ -b "$DEV" ]]; then
    return 0
  fi
  if [[ "$HPS_DEV" != /dev && -f "$DEV" ]]; then
    return 0
  fi
  refuse "device '$DEV' does not exist or is not a block device"
}

# probe: fill SIG_TYPE, SIG_LABEL and SIG_OTHER (PTTYPE / other keys that mean
# "something is here"). Returns 0 when a signature was found, 1 when the device
# is blank. blkid -p exits 2 for "nothing found" and 8 for an ambivalent result
# (several signatures), which counts as found.
probe() {
  local out rc line
  SIG_TYPE=""
  SIG_LABEL=""
  SIG_OTHER=""
  set +e
  out=$(run blkid -p -o export -- "$DEV")
  rc=$?
  set -e
  case "$rc" in
    0) ;;
    2) return 1 ;;
    8)
      SIG_OTHER="ambivalent (several signatures)"
      return 0
      ;;
    *)
      log "blkid -p exited $rc on $DEV"
      exit 1
      ;;
  esac
  while IFS= read -r line; do
    case "$line" in
      TYPE=*) SIG_TYPE=${line#TYPE=} ;;
      LABEL=*) SIG_LABEL=${line#LABEL=} ;;
      PTTYPE=*) SIG_OTHER="${SIG_OTHER:+$SIG_OTHER }partition table ${line#PTTYPE=}" ;;
    esac
  done <<< "$out"
  if [[ -z "$SIG_TYPE" && -z "$SIG_OTHER" ]]; then
    SIG_OTHER="an unnamed signature"
  fi
  return 0
}

is_prepared() {
  [[ "$SIG_TYPE" == ext4 && "$SIG_LABEL" == "$LABEL" && -z "$SIG_OTHER" ]]
}

# mounted_source <dir>: the device mounted exactly at <dir> in the host's mount
# table (PID 1's: this script's own is a private copy, see the header), or
# nothing.
mounted_source() {
  local src
  src=$(run findmnt -N 1 -n -o SOURCE --mountpoint "$1" || true)
  printf '%s' "$src"
}

# Anything but directories. Empty directories hide nothing, and podman's own
# tmpfiles rule (D! /var/lib/containers/storage/tmp) makes some at every boot
# (lab 2026-11-11: every run refused).
dir_has_files() {
  [[ -d "$1" ]] || return 1
  [[ -n "$(find "$1" -mindepth 1 ! -type d -print -quit)" ]]
}

# Refusals that need no change: checked before any format, so a refused run
# writes nothing.
precheck_mounts() {
  local src
  src=$(mounted_source "$CONTAINERS")
  if [[ -n "$src" ]]; then
    same_device "$src" "$DEV" || refuse "$CONTAINERS is already mounted from $src, not $DEV"
  elif dir_has_files "$CONTAINERS"; then
    refuse "$CONTAINERS already holds files (container storage in RAM): they would be hidden by the mount; reboot the CNH, then run this before any container is loaded"
  fi
  if [[ -z "$(mounted_source "$IPSDIR")" ]] && dir_has_files "$IPSDIR"; then
    refuse "$IPSDIR already holds files: they would be hidden by the bind mount"
  fi
}

same_device() {
  local a b
  a=$(readlink -f -- "$1")
  b=$(readlink -f -- "$2")
  [[ "$a" == "$b" ]]
}

# mount_by_unit: both mounts through hps-cnh-mount.service, unless the host's
# table already has them.
mount_by_unit() {
  local src
  src=$(mounted_source "$CONTAINERS")
  if [[ -n "$src" && -n "$(mounted_source "$IPSDIR")" ]]; then
    log "$CONTAINERS is already mounted from $DEV and $IPSDIR is mounted: $UNIT not restarted"
    return 0
  fi
  log "restarting $UNIT to mount $DEV in the host's mount namespace (a mount made here would end with this script)"
  run systemctl restart "$UNIT" || {
    log "$UNIT failed: journalctl -u $UNIT says why (two disks labelled $LABEL, or the mount itself)"
    exit 1
  }
  run systemctl is-active --quiet "$UNIT" || {
    log "$UNIT is not active after its restart"
    exit 1
  }
  src=$(mounted_source "$CONTAINERS")
  [[ -n "$src" ]] || {
    log "$CONTAINERS is not mounted in the host's mount table after $UNIT ran"
    exit 1
  }
  same_device "$src" "$DEV" || {
    log "$UNIT mounted $src at $CONTAINERS, not $DEV: another disk carries the label $LABEL"
    exit 1
  }
  [[ -n "$(mounted_source "$IPSDIR")" ]] || {
    log "$IPSDIR is not mounted in the host's mount table after $UNIT ran"
    exit 1
  }
  log "$UNIT mounted $DEV at $CONTAINERS and $IPSDIR"
}

main() {
  local formatted=no
  if [[ $# -ne 1 || "$1" == -* ]]; then
    usage
    exit 2
  fi
  DEV=$1
  check_device
  precheck_mounts
  if probe; then
    if is_prepared; then
      log "$DEV already carries an ext4 filesystem labelled $LABEL: not formatting"
    else
      refuse "$DEV carries a signature (type '${SIG_TYPE:-none}', label '${SIG_LABEL:-none}'${SIG_OTHER:+, $SIG_OTHER}); only a blank device or one labelled $LABEL is used"
    fi
  else
    log "$DEV carries no signature: making an ext4 filesystem labelled $LABEL"
    run mkfs.ext4 -q -L "$LABEL" -m 0 -- "$DEV" < /dev/null
    formatted=yes
    probe || {
      log "no filesystem found on $DEV after mkfs"
      exit 1
    }
    is_prepared || {
      log "$DEV after mkfs: type '$SIG_TYPE' label '$SIG_LABEL', expected ext4 $LABEL"
      exit 1
    }
  fi
  mount_by_unit
  printf 'CNH-DISK %s formatted=%s containers=%s ips=%s\n' "$DEV" "$formatted" "$CONTAINERS" "$IPSDIR"
}

main "$@"
