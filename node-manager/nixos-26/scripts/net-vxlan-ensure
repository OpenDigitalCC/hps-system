#!/usr/bin/env bash
#
# net-vxlan-ensure - build one VXLAN workload network on this host.
#
# ctrl-exec allowlisted node script (VXLAN workload networks). Usage:
#
#   net-vxlan-ensure <vni> <bridge> --local <ip> [--peer <ip>]... --mtu <N>
#
#   vni       1-16777215; the VXLAN link is vxlan<vni>
#   bridge    the layout bridge (^br-[a-z0-9-]{1,12}$) guests attach to
#   --local   this host's address on the transit network; it must already be on
#             the host (hps-node net-up gives it, net-vlan-address)
#   --peer    the transit address of another host carrying the network; repeat
#             once per peer, none for a host alone on the transit network
#   --mtu     576-9000, the MTU of vxlan<vni> and the bridge (the IPS passes the
#             layout mtu, by default the transit MTU less the 50 bytes of VXLAN)
#
# The IPS calls it from hps-node net-up (after every pairing, so after every
# boot: nodes run from RAM) and from hps-workload create and start for a VM on
# a vxlan network. It makes, idempotently:
#
#   vxlan<vni>   ip link add vxlan<vni> type vxlan id <vni> local <ip>
#                dstport 4789 nolearning; a member of <bridge>
#   FDB          one all-zero MAC entry per peer
#                (bridge fdb append 00:00:00:00:00:00 dev vxlan<vni> dst <peer>):
#                broadcast, unknown unicast and multicast go to every peer
#                (head-end replication, no multicast needed from the fabric)
#   <bridge>     the bridge, no address, IPv6 link-local off
#
# A second call with the same arguments changes nothing. A changed peer list
# replaces the all-zero entries exactly (missing ones appended, others
# deleted). An existing vxlan<vni> with another local address, port or
# learning setting is deleted and made again (it is this script's own link).
#
# Like net-bridge-ensure: runtime `ip` and `bridge` commands do the work, and an
# "Unmanaged=yes" file /run/systemd/network/05-hps-<bridge>.network (Name=
# <bridge> vxlan<vni>) keeps systemd-networkd off both links. No .netdev.
#
# Refused (nothing changed): the local address not on this host, the link that
# carries it with an MTU below <mtu> + 50, vxlan<vni> existing as another kind
# of link or another VNI, or a member of another bridge, <bridge> existing as
# something other than a bridge or already carrying another VXLAN link.
#
# Exit: 0 done, 1 a command failed, 2 usage, 3 refused. The last line on stdout
# is a one-line summary.
#
# Overrides for tests: HPS_NETWORK_DIR.

set -euo pipefail

: "${HPS_NETWORK_DIR:=/run/systemd/network}"

VXLAN_PORT=4789
ZERO_MAC=00:00:00:00:00:00

VNI=""
BRIDGE=""
LOCAL=""
MTU=""
PEERS=()
VX=""
CARRIER=""
UNMANAGED_CHANGED=0

log() {
  printf '[net-vxlan-ensure] %s\n' "$*" >&2
}

usage() {
  log "$*"
  log "usage: net-vxlan-ensure <vni> <bridge> --local <ip> [--peer <ip>]... --mtu <N>"
  exit 2
}

refuse() {
  log "refused: $*"
  exit 3
}

fail() {
  log "failed: $*"
  exit 1
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

# valid_ipv4 <text>: a dotted quad with every octet 0-255, no leading zeros.
valid_ipv4() {
  local o
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1}"; do
    [[ "$o" == 0 || "$o" =~ ^[1-9][0-9]*$ ]] || return 1
    (( o <= 255 )) || return 1
  done
  return 0
}

parse_args() {
  local p q n
  [[ $# -ge 2 ]] || usage "needs <vni> <bridge>"
  VNI="$1"
  BRIDGE="$2"
  shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)
        [[ $# -ge 2 ]] || usage "--local needs an address"
        [[ -z "$LOCAL" ]] || usage "--local given twice"
        LOCAL="$2"
        shift 2
        ;;
      --peer)
        [[ $# -ge 2 ]] || usage "--peer needs an address"
        PEERS+=("$2")
        shift 2
        ;;
      --mtu)
        [[ $# -ge 2 ]] || usage "--mtu needs a value"
        [[ -z "$MTU" ]] || usage "--mtu given twice"
        MTU="$2"
        shift 2
        ;;
      *) usage "unknown argument '$1'" ;;
    esac
  done
  if [[ ! "$VNI" =~ ^[1-9][0-9]{0,7}$ ]] || (( VNI > 16777215 )); then
    usage "vni '$VNI' is not 1-16777215"
  fi
  [[ "$BRIDGE" =~ ^br-[a-z0-9-]{1,12}$ ]] || usage "bridge '$BRIDGE' does not match ^br-[a-z0-9-]{1,12}\$"
  [[ -n "$LOCAL" ]] || usage "--local is required"
  valid_ipv4 "$LOCAL" || usage "--local '$LOCAL' is not an IPv4 address"
  [[ -n "$MTU" ]] || usage "--mtu is required"
  if [[ ! "$MTU" =~ ^[1-9][0-9]{2,3}$ ]] || (( MTU < 576 || MTU > 9000 )); then
    usage "mtu '$MTU' is not 576-9000"
  fi
  for p in "${PEERS[@]}"; do
    valid_ipv4 "$p" || usage "--peer '$p' is not an IPv4 address"
    [[ "$p" != "$LOCAL" ]] || usage "--peer $p is the local address"
  done
  for p in "${PEERS[@]}"; do
    n=0
    for q in "${PEERS[@]}"; do
      [[ "$q" != "$p" ]] || n=$((n + 1))
    done
    (( n == 1 )) || usage "--peer $p is given twice"
  done
  VX="vxlan${VNI}"
}

# link_json <name>: the link as JSON, failing when it does not exist.
link_json() {
  ip -j -d link show dev "$1" 2> /dev/null
}

link_field() {
  link_json "$1" | jq -r "$2"
}

link_is_up() {
  [[ "$(link_field "$1" '.[0].flags // [] | index("UP") != null')" == "true" ]]
}

# check_local: the local address is on this host, on a link with room for the
# VXLAN header. Sets CARRIER.
check_local() {
  local have
  CARRIER=$(run ip -j -4 addr show | jq -r --arg a "$LOCAL" \
    '[.[] | select(any(.addr_info[]?; .local == $a)) | .ifname][0] // empty')
  [[ -n "$CARRIER" ]] \
    || refuse "local address $LOCAL is not on this host (the transit address comes first: hps-node net-up runs net-vlan-address)"
  have=$(link_field "$CARRIER" '.[0].mtu // 0')
  (( have >= MTU + 50 )) \
    || refuse "$CARRIER carries $LOCAL with MTU $have; VXLAN MTU $MTU needs at least $((MTU + 50)) on the transit link"
}

# check_vxlan: prints "new", "same" or "stale" (ours, another local/port/learning).
check_vxlan() {
  local kind id addr port learning master
  if ! link_json "$VX" > /dev/null; then
    printf 'new\n'
    return 0
  fi
  kind=$(link_field "$VX" '.[0].linkinfo.info_kind // ""')
  [[ "$kind" == vxlan ]] || refuse "interface $VX exists and is a '${kind:-plain}' link, not a VXLAN"
  id=$(link_field "$VX" '.[0].linkinfo.info_data.id // ""')
  [[ "$id" == "$VNI" ]] || refuse "interface $VX exists with VNI '$id', not $VNI"
  master=$(link_field "$VX" '.[0].master // ""')
  [[ -z "$master" || "$master" == "$BRIDGE" ]] || refuse "$VX is a member of bridge $master, not $BRIDGE"
  addr=$(link_field "$VX" '.[0].linkinfo.info_data.local // ""')
  port=$(link_field "$VX" '.[0].linkinfo.info_data.port // ""')
  learning=$(link_field "$VX" '.[0].linkinfo.info_data.learning | if . == null then "unset" else tostring end')  # jq: false // x is x
  if [[ "$addr" == "$LOCAL" && "$port" == "$VXLAN_PORT" && "$learning" == false ]]; then
    printf 'same\n'
    return 0
  fi
  log "$VX has local '${addr}' port '${port}' learning '${learning}'; it is made again"
  printf 'stale\n'
}

# check_bridge: prints "new" or "exists".
check_bridge() {
  local kind other
  if ! link_json "$BRIDGE" > /dev/null; then
    printf 'new\n'
    return 0
  fi
  kind=$(link_field "$BRIDGE" '.[0].linkinfo.info_kind // ""')
  [[ "$kind" == bridge ]] || refuse "interface $BRIDGE exists and is a '${kind:-plain}' link, not a bridge"
  other=$(run ip -j -d link show | jq -r --arg b "$BRIDGE" --arg v "$VX" \
    '[.[] | select((.master // "") == $b and (.linkinfo.info_kind // "") == "vxlan" and .ifname != $v) | .ifname][0] // empty')
  [[ -z "$other" ]] || refuse "bridge $BRIDGE already carries $other; one VXLAN per bridge"
  printf 'exists\n'
}

# write_unmanaged: the 05- file that keeps networkd off the bridge and the VXLAN.
write_unmanaged() {
  local file="$HPS_NETWORK_DIR/05-hps-${BRIDGE}.network" body current=""
  body="[Match]
Name=${BRIDGE} ${VX}

[Link]
Unmanaged=yes
"
  if [[ -f "$file" ]]; then
    current=$(cat "$file")
    current="${current}"$'\n'
  fi
  [[ "$current" != "$body" ]] || return 0
  run mkdir -p "$HPS_NETWORK_DIR"
  log "+ write $file"
  printf '%s' "$body" > "$file"
  UNMANAGED_CHANGED=1
}

reload_networkd() {
  if [[ $UNMANAGED_CHANGED -eq 1 ]] && command -v networkctl > /dev/null 2>&1; then
    run networkctl reload || log "networkctl reload failed (continuing)"
  fi
}

# sync_fdb: make the all-zero MAC entries exactly the peers; prints the number
# of entries changed.
sync_fdb() {
  local have=() p d keep changed=0 fdb
  fdb=$(run bridge -j fdb show dev "$VX") || fail "could not read the FDB of $VX"
  mapfile -t have < <(printf '%s' "$fdb" | jq -r --arg z "$ZERO_MAC" \
    '.[]? | select((.mac // "") == $z and (.dst // "") != "") | .dst' | sort -u)
  for d in "${have[@]}"; do
    [[ -n "$d" ]] || continue
    keep=0
    for p in "${PEERS[@]}"; do
      [[ "$p" != "$d" ]] || keep=1
    done
    if (( keep == 0 )); then
      run bridge fdb del "$ZERO_MAC" dev "$VX" dst "$d" >&2 || fail "could not delete the FDB entry for $d on $VX"
      changed=$((changed + 1))
    fi
  done
  for p in "${PEERS[@]}"; do
    keep=0
    for d in "${have[@]}"; do
      [[ "$p" != "$d" ]] || keep=1
    done
    if (( keep == 0 )); then
      run bridge fdb append "$ZERO_MAC" dev "$VX" dst "$p" >&2 || fail "could not add the FDB entry for $p on $VX"
      changed=$((changed + 1))
    fi
  done
  printf '%s\n' "$changed"
}

set_mtu() {
  if [[ "$(link_field "$1" '.[0].mtu // 0')" != "$MTU" ]]; then
    run ip link set dev "$1" mtu "$MTU" || fail "could not set MTU $MTU on $1"
    return 0
  fi
  return 1
}

main() {
  local vx_state br_state what=unchanged fdb_changed
  parse_args "$@"
  check_local
  vx_state=$(check_vxlan)
  br_state=$(check_bridge)
  write_unmanaged
  reload_networkd
  if [[ "$br_state" == new ]]; then
    run ip link add name "$BRIDGE" type bridge || fail "could not create bridge $BRIDGE"
    run ip link set dev "$BRIDGE" addrgenmode none || fail "could not set addrgenmode on $BRIDGE"
    what=created
  fi
  if [[ "$vx_state" == stale ]]; then
    run ip link del dev "$VX" || fail "could not delete the stale $VX"
  fi
  if [[ "$vx_state" != same ]]; then
    run ip link add "$VX" type vxlan id "$VNI" local "$LOCAL" dstport "$VXLAN_PORT" nolearning \
      || fail "could not create $VX"
    run ip link set dev "$VX" addrgenmode none || fail "could not set addrgenmode on $VX"
    what=created
  fi
  if set_mtu "$VX" && [[ "$what" == unchanged ]]; then what=updated; fi
  if [[ "$(link_field "$VX" '.[0].master // ""')" != "$BRIDGE" ]]; then
    run ip link set dev "$VX" master "$BRIDGE" || fail "could not put $VX in $BRIDGE"
    [[ "$what" != unchanged ]] || what=updated
  fi
  if set_mtu "$BRIDGE" && [[ "$what" == unchanged ]]; then what=updated; fi
  fdb_changed=$(sync_fdb)
  if (( fdb_changed > 0 )) && [[ "$what" == unchanged ]]; then what=updated; fi
  if ! link_is_up "$VX"; then
    run ip link set dev "$VX" up || fail "could not bring $VX up"
    [[ "$what" != unchanged ]] || what=updated
  fi
  if ! link_is_up "$BRIDGE"; then
    run ip link set dev "$BRIDGE" up || fail "could not bring $BRIDGE up"
    [[ "$what" != unchanged ]] || what=updated
  fi
  printf 'net-vxlan-ensure: %s (vni %s, local %s via %s, %s peer(s)) in %s mtu %s: %s\n' \
    "$VX" "$VNI" "$LOCAL" "$CARRIER" "${#PEERS[@]}" "$BRIDGE" "$MTU" "$what"
}

main "$@"
