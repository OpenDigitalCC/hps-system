#!/usr/bin/env bash
#
# storage-pool-import - normal-boot import of an existing ZFS pool.
#
# ctrl-exec allowlisted node script (nix/modules/hps-ctrl-exec.nix). One action,
# a straight sequence of standard commands, every command logged to stderr as
# "+ <command>" before it runs, no library sourcing.
#
# Usage: storage-pool-import <pool>
#
#   <pool>  ^[a-z][a-z0-9_.-]*$
#
# Imports the pool without mounting (zpool import -N -d /dev/disk/by-id). It
# NEVER forces (-f), never discards a missing log (-m) and never creates: a pool
# that is not importable by the plain command is a refusal, not something to
# force. A pool that is already imported is reported (status) and exits 0.
#
# Exit: 0 imported or already imported, 2 usage, 3 refused (bad name, pool not
# importable - the "zpool import" listing is on stderr), 1 a command failed.

set -euo pipefail

POOL=""

log() {
  printf '[storage-pool-import] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-pool-import <pool>
Exit: 0 ok, 2 usage, 3 refused (pool not importable), 1 failed.
USAGE
}

parse_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -*) log "unknown option: $arg"; usage; exit 2 ;;
      *)
        if [[ -n "$POOL" ]]; then
          log "only one pool name is accepted"
          usage
          exit 2
        fi
        POOL="$arg"
        ;;
    esac
  done
  if [[ -z "$POOL" ]]; then
    usage
    exit 2
  fi
  if [[ ! "$POOL" =~ ^[a-z][a-z0-9_.-]*$ ]]; then
    log "refused: pool name '$POOL' does not match ^[a-z][a-z0-9_.-]*\$"
    exit 3
  fi
}

pool_is_imported() {
  zpool list -H -o name "$POOL" > /dev/null 2>&1
}

# The plain listing decides whether the pool can be imported at all.
require_importable() {
  local listing
  printf '+ zpool import -d /dev/disk/by-id\n' >&2
  listing=$(zpool import -d /dev/disk/by-id 2>&1) || true
  if ! printf '%s\n' "$listing" | grep -Eq "^[[:space:]]*pool: ${POOL}\$"; then
    log "refused: pool '$POOL' is not importable; zpool import lists:"
    printf '%s\n' "$listing" >&2
    exit 3
  fi
}

report() {
  run zpool status "$POOL"
  run zpool get -H health,size,allocated "$POOL"
}

main() {
  parse_args "$@"
  if pool_is_imported; then
    log "pool '$POOL' is already imported"
    report
    exit 0
  fi
  require_importable
  run zpool import -N -d /dev/disk/by-id "$POOL"
  report
}

main "$@"
