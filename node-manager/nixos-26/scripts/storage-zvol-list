#!/usr/bin/env bash
#
# storage-zvol-list - READ-ONLY list of the zvols of a pool.
#
# ctrl-exec allowlisted node script. Usage: storage-zvol-list <pool>
# Prints name, volsize, used and referenced of every zvol below <pool>.
#
# Exit: 0 listed, 2 usage, 3 refused (bad name, pool not imported), 1 failed.

set -euo pipefail

POOL=""

log() {
  printf '[storage-zvol-list] %s\n' "$*" >&2
}

# run <command...>: log then execute.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

usage() {
  cat >&2 <<'USAGE'
Usage: storage-zvol-list <pool>
Exit: 0 ok, 2 usage, 3 refused, 1 failed.
USAGE
}

main() {
  if [[ $# -ne 1 || "$1" == -* ]]; then
    usage
    exit 2
  fi
  POOL=$1
  if [[ ! "$POOL" =~ ^[a-z][a-z0-9_.-]*$ ]]; then
    log "refused: pool name '$POOL' does not match ^[a-z][a-z0-9_.-]*\$"
    exit 3
  fi
  if ! zpool list -H -o name "$POOL" > /dev/null 2>&1; then
    log "refused: pool '$POOL' is not imported"
    exit 3
  fi
  run zfs list -t volume -r -o name,volsize,used,referenced "$POOL"
}

main "$@"
