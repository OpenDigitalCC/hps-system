# shellcheck shell=bash
# role - what a storage (SCH) or compute (TCH) node needs beyond the agent
# (docs/BUNDLE.md "Storage and compute"). Sourced by init; nothing runs when it is
# sourced. OS-neutral: the programs come from the role's packages, the services
# are started through the adapter (svc_start, svc_mask, fw_open), and every
# directory outside /run/hps is under ${HPS_ROOT}, so that the tests can run it.
#
# This is what the pinned images' profiles (nix/modules/profiles/storage.nix,
# compute.nix, hps-opensvc.nix, hps-common.nix) arrange at build time, done at
# boot from the bundle instead; the node scripts themselves are the same files.
#
#   role_pre   before pairing: clock, log forwarding, the storage or compute
#              services, host reserve, bridges, om3, the shutdown unit
#   role_post  after pairing set the hostname: the iSCSI initiator (its name is
#              the node's FQDN)
#
# A step that fails is said (console, journal, IPS log) and remembered in
# ROLE_FAILED; it never stops the boot or the pairing, so that a person (or the
# IPS) can look at the node. init ends with a non-zero exit when one failed.
#
# Defined by init and the adapter: log, run, fetch_text, ips_log, write_if_changed,
# ips_url, HERE, HPS_RUN_DIR, HPS_ROOT, HPS_CMDLINE, PKG_BIN, PKG_SBIN, SYS_BIN,
# LIBVIRT_CONF_DIR, svc_start, svc_mask, fw_open.

NODE_TYPE=""
ROLE_FAILED=""

# role_is <ROLE>: the node's registry TYPE (a comma list) names the role.
role_is() {
  [[ ",${NODE_TYPE}," == *",$1,"* ]]
}

# role_try <what> <function> [args]: run a step in a subshell with -e on (a plain
# call inside "if" would switch -e off), say so and remember it when it fails.
role_try() {
  local what="$1" rc=0
  shift
  set +e
  (
    set -e
    "$@"
  )
  rc=$?
  set -e
  if ((rc != 0)); then
    log "role step failed ($rc): $what"
    ips_log "error: role step failed: $what"
    ROLE_FAILED="${ROLE_FAILED:+$ROLE_FAILED, }$what"
  fi
  return 0
}

# role_bin <program>: its path, from the added packages first, then the starter's own.
role_bin() {
  local d
  for d in "$PKG_BIN" "$PKG_SBIN" ${SYS_BIN//:/ }; do
    if [[ -x "$d/$1" ]]; then
      printf '%s\n' "$d/$1"
      return 0
    fi
  done
  return 1
}

# role_need <program>...: every program is there, or the missing ones are named
# (a role's package list that lacks one is found here, not by the first action).
role_need() {
  local p missing=""
  for p in "$@"; do
    role_bin "$p" > /dev/null || missing="$missing $p"
  done
  if [[ -n "$missing" ]]; then
    log "missing programs:$missing (the role's packages: lib/starter/${OS_NAME:-nixos}.roles)"
    return 1
  fi
}

# role_path: the PATH of the services this file starts.
role_path() {
  printf '%s:%s:%s\n' "$PKG_BIN" "$PKG_SBIN" "$SYS_BIN"
}

# role_modules <module>...: load kernel modules; one that is not there is said, not fatal
# (a module built into the kernel has no file).
role_modules() {
  local m
  for m in "$@"; do
    run modprobe "$m" || log "module $m not loaded (built in, or not in this kernel)"
  done
}

# role_lib <name> [VAR=value...]: run a script of the bundle's lib/ with the node's
# settings. Not exec'd as a function: a script of its own, as on the pinned images.
role_lib() {
  local name="$1"
  shift
  run env HPS_CMDLINE="$HPS_CMDLINE" HPS_RUN_DIR="$HPS_RUN_DIR" "$@" bash "$HERE/lib/$name"
}

# role_group <name> / role_user <name> <extra group>: system accounts, once.
role_group() {
  getent group "$1" > /dev/null 2>&1 || run groupadd --system "$1"
}
role_user() {
  local name="$1" extra="${2:-}"
  role_group "$name"
  if ! id "$name" > /dev/null 2>&1; then
    run useradd --system --no-create-home --gid "$name" ${extra:+--groups "$extra"} \
      --shell "$(command -v nologin || echo /bin/false)" "$name"
  fi
}

#-------------------------------------------------------------------------------
# every storage and compute node
#-------------------------------------------------------------------------------
# The clock: from the IPS, before anything needs TLS (hps-time, as on the pinned images).
role_clock() {
  role_lib hps-time HPS_TIMESYNCD_DIR="${HPS_ROOT}/run/systemd/timesyncd.conf.d"
  time_sync "$IPS"
}

# Logs: the journal's lines to the IPS (TCP 514), as the pinned images' rsyslog does:
# the IPS's issue watcher reads the HPS-ISSUE lines and the node's own logs from there.
# lib/hps-log-journal (jq and the shell) instead of rsyslog, whose closure is 335 MiB of RAM.
role_logs() {
  log_forward
}

# The host's reserve (CPU, memory, ZFS ARC), as hps-host-reserve does on the
# pinned images: the allowlisted script itself, before pairing and any guest.
role_reserve() {
  host_cgroups
  run env HPS_CMDLINE="$HPS_CMDLINE" HPS_RUN_DIR="$HPS_RUN_DIR" bash "$HERE/actions/host-reserve-apply" \
    || log "host-reserve-apply exited $? (continuing)"
}

# The bridges of the networks attached to this host: net-bridge-ensure, once, so
# that they exist before any workload; later runs go through the agent.
role_bridges() {
  run env HPS_CMDLINE="$HPS_CMDLINE" bash "$HERE/actions/net-bridge-ensure" \
    || log "net-bridge-ensure exited $? (continuing)"
}

# om3: membership, health and local service management (nix/modules/hps-opensvc.nix).
# The cluster secret arrives later, over the agent (osvc-secret-set), which
# restarts the unit; until then the unit's condition keeps it down.
role_osvc() {
  local om
  om="$(role_bin om)" || { log "om (om3) is not installed"; return 1; }
  role_group opensvc
  run install -d -m 0700 "${HPS_ROOT}/etc/opensvc" "${HPS_ROOT}/var/lib/opensvc"
  svc_start --when-exists "$HPS_RUN_DIR/osvc-cluster-secret" --port 1215 --unit-opt StartLimitIntervalSec=0 \
    --opt Restart=always --opt RestartSec=15 \
    --opt "EnvironmentFile=-$HPS_RUN_DIR/opensvc.env" --opt WorkingDirectory=/var/lib/opensvc \
    --opt "ExecStartPre=$(command -v bash) $HPS_RUN_DIR/bundle/lib/hps-osvc-config" \
    opensvc-daemon "PATH=$(role_path)" HOME=/var/lib/opensvc \
    "$om" daemon run '$OSVC_DAEMON_ARGS'
  fw_open 10000
}

# The monitoring checks, as the pinned images have them (nix/modules/hps-monitor.nix,
# docs/MONITORING.md): hps-monitor on the IPS asks the allowlisted action nagios-check
# for the checks named in /etc/nagios-checks/checks.conf, which says how. Nothing
# runs by itself on the node (no timer, no unit): the IPS asks. What it takes:
#  - nagios-check, the ctrl-exec plugin (a local package, run by its path:
#    $HPS_RUN_DIR/nagios-check, which the bundle's actions/nagios-check runs);
#  - one directory of real files (nagios-check refuses a plugin that resolves
#    outside it): check_disk, check_load, check_procs, check_mem from the package
#    hps-nagios-plugins, and the usage checks, the bundle's plugins/ as they are
#    with the PATH line they all carry filled in (the nix module does the same
#    with the store paths of its packages).
# The check set is the module's: checks.conf below is its text for a node of these roles
# (a test compares the two).
role_monitor() {
  local d="$HPS_RUN_DIR/nagios-plugins" p content path_line plugs
  # HPS_NAGIOS_CHECK_FS, HPS_NAGIOS_PLUGINS_FS (tests): where to look at the two
  # packages, for store paths that are not on the machine that runs the test
  local chk="${HPS_NAGIOS_CHECK_FS:-$NAGIOS_CHECK}" plg="${HPS_NAGIOS_PLUGINS_FS:-$NAGIOS_PLUGINS}"
  if [[ -z "$NAGIOS_CHECK" || -z "$NAGIOS_PLUGINS" ]]; then
    log "the monitoring packages are not in this node's list (nagios-check, hps-nagios-plugins: lib/starter/nixos.roles)"
    return 1
  fi
  role_need awk jq
  [[ -x "$chk" ]] || { log "$NAGIOS_CHECK is not a program"; return 1; }
  run install -d -m 0755 "$d" "${HPS_ROOT}/etc/nagios-checks"
  for p in check_disk check_load check_procs check_mem; do
    [[ -e "$plg/$p" ]] || { log "$NAGIOS_PLUGINS has no $p"; return 1; }
    run install -m 0755 "$plg/$p" "$d/$p"
  done
  plugs="check_cpu check_net check_diskio check_fs check_swap_use check_osvc_hb"
  role_is SCH && plugs="$plugs check_zpool check_zpool_io"
  role_is TCH && plugs="$plugs check_vms"
  path_line="export PATH=$(role_path):\"\$PATH\""
  for p in $plugs; do
    [[ -f "$HERE/plugins/$p" ]] || { log "the bundle has no plugins/$p"; return 1; }
    content="$(cat "$HERE/plugins/$p"; printf x)"
    content="${content%x}"
    printf '%s' "${content//'# @HPS_PATH@'/$path_line}" > "$d/$p.new"
    chmod 0755 "$d/$p.new"
    mv -f "$d/$p.new" "$d/$p"
  done
  run ln -sfn "$NAGIOS_CHECK" "$HPS_RUN_DIR/nagios-check"
  {
    printf '# Written by the HPS node bundle (role_monitor); the IPS (hps-monitor) names the checks, this file says how.\n'
    printf 'plugin_dir = %s\ntimeout = 10\nbudget = 50\n' "$d"
    printf 'disk_root = check_disk -w 20%% -c 10%% -p /\n'
    printf 'load = check_load -r -w 1.5,1.2,1 -c 3,2.5,2\n'
    printf 'mem = check_mem -w 10 -c 5\n'
    printf 'swap = check_swap_use -w 50 -c 80\n'
    printf 'procs = check_procs -k -w 1000 -c 2000\n'
    printf 'cpu = check_cpu\nnet = check_net\ndiskio = check_diskio\n'
    printf 'disk_other = check_fs -a -w 80 -c 90\n'
    printf 'osvc_hb = check_osvc_hb\n'
    if role_is SCH; then
      printf 'zpool = check_zpool\nzpool_io = check_zpool_io\nzpool_cap = check_zpool -m cap -w 80 -c 90\n'
    fi
    if role_is TCH; then printf 'vms = check_vms\n'; fi
  } | write_if_changed "${HPS_ROOT}/etc/nagios-checks/checks.conf" 0644
}

# Power-off: guests stop, mirrors stop, targets and sessions go, pools are
# exported, in that order, while everything they need is still up
# (hps-shutdown-storage; the unit stops before the units it is After=).
role_shutdown() {
  svc_start --unit-opt "After=libvirtd.service iscsid.service ctrl-exec-agent.service ctrl-exec-executor.service hps-log-journal.service network-online.target systemd-networkd.service systemd-resolved.service local-fs.target" \
    --opt Type=oneshot --opt RemainAfterExit=yes --opt Restart=no --opt TimeoutStopSec=300 \
    --opt "ExecStop=$(command -v bash) $HPS_RUN_DIR/bundle/lib/hps-shutdown-storage" \
    hps-shutdown-storage "PATH=$(role_path)" "HPS_SCRIPTS_DIR=$HPS_RUN_DIR/bundle/actions" \
    "$(type -P true)"
}

#-------------------------------------------------------------------------------
# md on a storage or a compute node: HPS assembles every mirror explicitly
# (mirror-assemble); nothing may start a half mirror by itself. A storage node needs it
# as much as a compute node: its zvols carry the mirror legs' md superblocks, and the
# starter's udev rules assemble such a member the moment the pool is imported, which
# holds the device and refuses the export (lab trial: "Cannot configure StorageObject
# because device {dev} is already in use"). AUTO -all stops that.
role_md() {
  # md mirrors: HPS assembles every mirror explicitly (mirror-assemble); nothing
  # may start a half mirror by itself (AUTO -all, the last-resort timers off).
  # The monitor's PROGRAM writes one HPS-ISSUE line per leg event (hps-md-event). The
  # starter's own mdmonitor.service (started by udev when the first array appears) is the
  # monitor and reads this file; it has no bash on its PATH, so PROGRAM is a small sh
  # wrapper that sets one (the pinned image does the same with writeShellScript).
  write_if_changed "$HPS_RUN_DIR/md-event" 0755 << EOF
#!/bin/sh
PATH=$(role_path):/bin:/usr/bin
export PATH
exec $(command -v bash) $HPS_RUN_DIR/bundle/lib/hps-md-event "\$@"
EOF
  write_if_changed "${HPS_ROOT}/etc/mdadm.conf" 0644 << EOF
# written by the HPS node bundle (docs/BUNDLE.md)
PROGRAM $HPS_RUN_DIR/md-event
AUTO -all
EOF
  svc_mask mdadm-last-resort@.timer mdadm-last-resort@.service
  md_monitor
}

#-------------------------------------------------------------------------------
# ZFS datasets that stay mounted. The executor runs every action in a mount namespace of its
# own, so what image-fetch, vm-save and dataset-unlock mount is gone when they end and the
# next action (vm-image-write, vm-restore) does not see the files (lab trial: "--image
# /lab/enc/images/... does not exist"). The unit mounts from PID 1, where the mount stays
# and reaches the actions' namespaces; those three scripts start it when it exists.
role_zfs() {
  svc_start --opt Type=oneshot --opt Restart=no \
    hps-zfs-mount "PATH=$(role_path)" "$(role_bin zfs)" mount -a
}

#-------------------------------------------------------------------------------
# storage (SCH)
#-------------------------------------------------------------------------------
# ZFS is in the starter (the module and the userland, matching its kernel). The
# iSCSI target is the kernel's LIO, driven by targetcli, which keeps its
# configuration in /etc/target: a directory the starter does not have.
role_storage() {
  role_need zpool zfs targetcli mdadm smartctl xxd jq
  zfs_hostid_set
  role_stock_services
  zvol_links
  role_modules zfs target_core_mod iscsi_target_mod target_core_iblock
  # targetcli drives LIO through configfs; systemd mounts it, OpenRC does not
  if [[ -n "${MOUNT_CONFIGFS:-}" ]]; then mountpoint -q /sys/kernel/config || run mount -t configfs none /sys/kernel/config; fi
  run install -d -m 0755 "${HPS_ROOT}/etc/target"
  # the portal; access control is the target's ACL (initiator IQN), as on the pinned images
  fw_open 3260
}

#-------------------------------------------------------------------------------
# compute (TCH)
#-------------------------------------------------------------------------------
# libvirt and QEMU/KVM, md mirrors, the iSCSI initiator (its name and daemon
# follow pairing: role_iscsi). The settings are those of compute.nix, AppArmor
# included: the profiles are loaded and the kernel's AppArmor is checked before
# libvirtd starts, and the step fails (libvirtd is not started) when it is not
# active, never falling back to the DAC model alone (role_apparmor).

# role_aa_fill <file>: a profile text of the bundle (apparmor/, the files the pinned
# images' nix module reads too) with the store paths of this node's packages put
# in place of its @@NAME@@ markers.
role_aa_fill() {
  local -a extra=()
  mapfile -t extra < <(aa_sed_args)
  sed -e "s|@@LIBVIRT@@|$AA_LIBVIRT|g" -e "s|@@QEMU@@|$AA_QEMU|g" -e "s|@@APPARMOR_PARSER@@|$AA_PARSER|g" "${extra[@]}" "$HERE/apparmor/$1"
}

# role_apparmor: AppArmor for the guests, as the pinned images have it
# (nix/modules/profiles/compute-apparmor.nix, docs/CONFINEMENT.md "AppArmor layer"):
# the kernel's AppArmor is active; the libvirtd and virt-aa-helper profiles are
# loaded (enforce); the abstraction, the template and the parser's include path
# are where libvirt and the parser look. Called before libvirtd starts: the daemon
# is only confined if its profile is in the kernel when it is exec'd, and the
# apparmor security driver needs that and TEMPLATE.qemu.
role_apparmor() {
  local enabled="${HPS_AA_ENABLED:-/sys/module/apparmor/parameters/enabled}"
  local profiles="${HPS_AA_PROFILES:-/sys/kernel/security/apparmor/profiles}"
  local f
  role_need apparmor_parser || return 1
  # a libvirt without the AppArmor driver (the adapter says) is no libvirt for this node
  aa_libvirt_check || return 1
  if [[ "$(cat "$enabled" 2> /dev/null || true)" != Y || ! -r "$profiles" ]]; then
    log "ERROR: AppArmor is not active in this kernel ($enabled is not Y, or $profiles is not there)."
    log "ERROR: the kernel line needs lsm=...,apparmor,... apparmor=1 (the IPS issues it; a node booted before that needs a reboot)."
    log "ERROR: libvirtd is NOT started: guests would run with the DAC model alone, and the pinned images never do."
    return 1
  fi
  aa_roots
  [[ -d "$PKG_ETC/apparmor.d/abstractions" ]] || { log "$PKG_ETC/apparmor.d/abstractions is not there (the package apparmor-profiles)"; return 1; }

  run install -d -m 0755 "${HPS_ROOT}/etc/apparmor.d/abstractions" "${HPS_ROOT}/etc/apparmor.d/hps" \
    "${HPS_ROOT}/etc/apparmor" "${HPS_ROOT}/var/lib/apparmor.d/libvirt" "${HPS_ROOT}/sbin"
  # the parser's include path: the abstractions of the package, the one this file
  # adds, and /var/lib/apparmor.d (libvirt writes libvirt/<uuid>.files there; its
  # APPARMOR_DIR is compiled in)
  write_if_changed "${HPS_ROOT}/etc/apparmor/parser.conf" 0644 << EOF
# written by the HPS node bundle (docs/BUNDLE.md "AppArmor")
skip-cache
Include /etc/apparmor.d
Include $PKG_ETC/apparmor.d
Include /var/lib/apparmor.d
EOF
  role_aa_fill libvirt-qemu | write_if_changed "${HPS_ROOT}/etc/apparmor.d/abstractions/libvirt-qemu" 0644
  role_aa_fill TEMPLATE.qemu | write_if_changed "${HPS_ROOT}/var/lib/apparmor.d/libvirt/TEMPLATE.qemu" 0644
  role_aa_fill libvirtd | write_if_changed "${HPS_ROOT}/etc/apparmor.d/hps/libvirtd" 0644
  role_aa_fill virt-aa-helper | write_if_changed "${HPS_ROOT}/etc/apparmor.d/hps/virt-aa-helper" 0644
  # virt-aa-helper runs the parser by this absolute path (libvirt's compiled-in name)
  # (on an OS where it is that file already, there is nothing to link)
  [[ "$(aa_parser_path)" -ef "${HPS_ROOT}/sbin/apparmor_parser" ]] || run ln -sfn "$(aa_parser_path)" "${HPS_ROOT}/sbin/apparmor_parser"

  for f in libvirtd virt-aa-helper; do
    run "$(aa_parser_path)" -r -K "${HPS_ROOT}/etc/apparmor.d/hps/$f" || {
      log "ERROR: apparmor_parser could not load the $f profile"
      return 1
    }
  done
  # the daemon's profile is what libvirt's probe looks for; without it the driver is unusable
  if ! grep -qF "$(aa_libvirtd_path) (enforce)" "$profiles"; then
    log "ERROR: the libvirtd profile ($(aa_libvirtd_path)) is not in $profiles after loading"
    return 1
  fi
  log "AppArmor active; libvirtd and virt-aa-helper profiles loaded (enforce)"
}

role_compute() {
  local libvirtd qemu_bin edk2 f
  role_need virsh libvirtd virtlogd qemu-img qemu-system-x86_64 iscsiadm iscsid mdadm tcpdump jq
  libvirtd="$(role_bin libvirtd)"
  # AppArmor first: when it is not active the step stops here, before anything
  # that starts a guest (libvirtd, the mirror monitor) is started
  role_stock_services
  role_apparmor
  role_modules vhost_net 8021q bridge raid1 iscsi_tcp
  # KVM: the module of the CPU's vendor (the one that is not there always fails)
  if grep -q '^vendor_id[[:space:]]*:[[:space:]]*GenuineIntel' "${HPS_CPUINFO:-/proc/cpuinfo}"; then
    role_modules kvm_intel
  elif grep -qE '^vendor_id[[:space:]]*:[[:space:]]*(AuthenticAMD|HygonGenuine)' "${HPS_CPUINFO:-/proc/cpuinfo}"; then
    role_modules kvm_amd
  else
    log "the CPU is neither Intel nor AMD: no KVM module loaded"
  fi

  # QEMU runs as an unprivileged user (libvirtd relabels each guest's disks to it)
  role_user qemu-libvirtd kvm

  run install -d -m 0755 "${HPS_ROOT}$LIBVIRT_CONF_DIR" "${HPS_ROOT}$LIBVIRT_CONF_DIR/qemu"
  # the guests' logs (vm-define sends the serial console to /var/log/libvirt/qemu/<vm>-serial.log)
  run install -d -m 0755 "${HPS_ROOT}/var/log/libvirt/qemu"
  write_if_changed "${HPS_ROOT}$LIBVIRT_CONF_DIR/qemu.conf" 0644 << 'EOF'
# written by the HPS node bundle (docs/BUNDLE.md); the settings of nix/modules/profiles/compute.nix
user = "qemu-libvirtd"
group = "qemu-libvirtd"
namespaces = []
seccomp_sandbox = 1
clear_emulator_capabilities = 1
dynamic_ownership = 1
allow_disk_format_probing = 0
security_default_confined = 1
security_require_confined = 0
set_process_name = 1
security_driver = "apparmor"
EOF

  # The UEFI firmware the guest definitions name (vm-define: HPS_OVMF_CODE, HPS_OVMF_VARS):
  # the files QEMU ships, linked where the pinned images have them.
  qemu_bin="$(readlink -f "$(role_bin qemu-system-x86_64)")"
  edk2="${qemu_bin%/bin/*}/share/qemu"
  run install -d -m 0755 "${HPS_ROOT}/run/libvirt/nix-ovmf"
  for f in "$edk2"/edk2-*; do
    [[ -e "$f" ]] && ln -sf "$f" "${HPS_ROOT}/run/libvirt/nix-ovmf/${f##*/}"
  done

  # libvirtd does not start virtlogd itself (lab trial: vm-start failed on
  # /run/libvirt/virtlogd-sock); the guests' console logs go through it
  svc_start --opt KillMode=process --opt Restart=on-failure \
    virtlogd "PATH=$(role_path)" "$(role_bin virtlogd)"
  svc_start --opt KillMode=process --opt Restart=on-failure --opt LimitMEMLOCK=infinity \
    --unit-opt "After=virtlogd.service" \
    libvirtd "PATH=$(role_path)" "$libvirtd"
}

# The iSCSI initiator: named by the node's FQDN (so after pairing set the hostname),
# with the open-iscsi package's own configuration and the timeouts of the
# fail-fast ruling (a lost storage host is an outage after 15 s, not a stall).
role_iscsi() {
  local conf iscsid
  iscsid="$(role_bin iscsid)" || { log "iscsid is not installed"; return 1; }
  role_lib hps-iscsi-name
  conf="$(iscsid_conf_source)"
  [[ -f "$conf" ]] || { log "$conf is not there"; return 1; }
  run install -d -m 0755 "${HPS_ROOT}/etc/iscsi" "${HPS_ROOT}/var/lib/iscsi"
  {
    cat "$conf"
    # appended: a later line wins; leg-resolve writes the same values per record before each login
    printf '\n# the fail-fast ruling of 2026-11-12 (docs/WORKLOADS.md); the node bundle\n'
    printf 'node.session.timeo.replacement_timeout = 15\nnode.conn[0].timeo.noop_out_interval = 5\n'
    printf 'node.conn[0].timeo.noop_out_timeout = 5\nnode.conn[0].timeo.login_timeout = 15\n'
  } | write_if_changed "${HPS_ROOT}/etc/iscsi/iscsid.conf" 0644
  ln -sf "$HPS_RUN_DIR/initiatorname.iscsi" "${HPS_ROOT}/etc/iscsi/initiatorname.iscsi"
  svc_start --opt KillMode=process --opt Restart=on-failure \
    iscsid "PATH=$(role_path)" "$iscsid" -f --config="${HPS_ROOT}/etc/iscsi/iscsid.conf"
}

# role_stock_services: the OS's own services a role needs running (ENSURE_SERVICES of the
# adapter: dbus on Alpine, where targetcli and libvirt expect it; none on NixOS)
role_stock_services() {
  local s
  for s in ${ENSURE_SERVICES:-}; do svc_ensure "$s"; done
}


#-------------------------------------------------------------------------------
# the two entry points
#-------------------------------------------------------------------------------
role_detect() {
  local t
  t="$(fetch_text 'host_variable&name=TYPE' 2> /dev/null | tr -d '[:space:]' || true)"
  if [[ "$t" =~ ^[A-Z]{2,5}(,[A-Z]{2,5})*$ ]]; then
    NODE_TYPE="$t"
  else
    NODE_TYPE=""
  fi
}

role_pre() {
  role_detect
  if ! role_is SCH && ! role_is TCH; then
    log "role: registry TYPE '${NODE_TYPE:-none}' is neither SCH nor TCH: no storage or compute services"
    return 0
  fi
  log "role: $NODE_TYPE"
  role_try "clock" role_clock
  role_try "log forwarding" role_logs
  role_try "md" role_md
  role_try "zfs mounts" role_zfs
  role_try "host reserve" role_reserve
  if role_is SCH; then role_try "storage services" role_storage; fi
  if role_is TCH; then role_try "compute services" role_compute; fi
  role_try "bridges" role_bridges
  role_try "om3" role_osvc
  role_try "monitoring checks" role_monitor
  role_try "shutdown unit" role_shutdown
}

role_post() {
  if role_is TCH; then role_try "iSCSI initiator" role_iscsi; fi
  if [[ -n "$ROLE_FAILED" ]]; then
    log "role: failed steps: $ROLE_FAILED"
    return 1
  fi
}
