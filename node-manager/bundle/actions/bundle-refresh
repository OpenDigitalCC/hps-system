#!/usr/bin/env bash
#
# bundle-refresh - fetch the node bundle again from this node's own IPS and run
# its init over it: a script changed on the IPS is live when this has run, a
# package the node's role gained is installed, and a new agent version is taken
# (the agent is restarted a few seconds after this action has answered).
#
# ctrl-exec allowlisted node script (docs/BUNDLE.md). It takes no arguments and
# fetches nothing a dispatcher names: the address is hps.ips= on the node's own
# kernel command line, the file is the IPS's bundle. Every command is logged to
# stderr as "+ command" before it runs.
#
# The action runs under the executor, whose profile keeps the agent's own
# configuration read-only to every action (an action can never rewrite the
# allowlist). The refresh has to write it, so the work is done by a transient
# systemd unit, outside the agent's reach: the action starts it and waits for it
# (systemd-run --wait --pipe), and its output is this action's output. The
# unit runs bootstrap.sh refresh, the same file the node booted with, kept
# inside the bundle. Nothing but the agent and its executor is restarted; guests
# and storage services are not touched.
#
# Usage: bundle-refresh          (no arguments)
# Exit: 0 refreshed, 1 the fetch or init failed, 2 usage.

set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "Usage: bundle-refresh (takes no arguments)" >&2
  exit 2
fi

: "${HPS_RUN_DIR:=/run/hps}"
: "${HPS_SYSTEMD_RUN:=systemd-run}"
BOOTSTRAP="$HPS_RUN_DIR/bundle/bootstrap.sh"

if [[ ! -f "$BOOTSTRAP" ]]; then
  echo "bundle-refresh: $BOOTSTRAP is missing: this node has no bundle to refresh" >&2
  exit 1
fi

printf '+ systemd-run --wait --pipe sh %s refresh\n' "$BOOTSTRAP" >&2
exec "$HPS_SYSTEMD_RUN" --quiet --wait --pipe --collect --unit=hps-refresh sh "$BOOTSTRAP" refresh < /dev/null
