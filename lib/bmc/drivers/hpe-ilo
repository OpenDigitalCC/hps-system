#!/usr/bin/env bash
# hpe-ilo - HPE iLO (iLO 4 and later) over Redfish. The quirks proven in the
# lab (lab/ilo.sh): the system is /redfish/v1/Systems/1/, every path carries a
# trailing slash, and the one-time boot override sends UEFI mode, then powers
# the host on or restarts it. See docs/BMC.md.
set -euo pipefail
export RF_NAME=hpe-ilo
export RF_SYSTEM_DEFAULT=/redfish/v1/Systems/1/
export RF_MANAGER_DEFAULT=/redfish/v1/Managers/1/
export RF_TRAILING_SLASH=1
export RF_PXE_MODE=send
here="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../redfish-common.sh
. "$here/../redfish-common.sh"
rf_main "$@"
