#!/usr/bin/env bash
# ipmi - IPMI over LAN with ipmitool, for devices that have IPMI and no
# Redfish. The password reaches ipmitool through its environment (-E), never
# argv. The user name is on argv (ipmitool offers no other way). Options:
# interface (default lanplus), identify_seconds (default 15). See docs/BMC.md.
#
# Console: `sol activate` bounded by timeout(1), then `sol deactivate`; the
# credential arrives on fd 3 (stdin carries the keystrokes), the limit in
# BMC_CONSOLE_SECONDS.
#
# Contract: <driver> <action>; BMC_ADDR; credential on stdin (user, password).
set -euo pipefail

user=""
pass=""

die() {
  printf 'ipmi: %s\n' "$2" >&2
  exit "$1"
}

read_credential() {
  IFS= read -r user || true
  IFS= read -r pass || true
  [[ -n "$user" && -n "$pass" ]] || die 3 "no credential supplied on stdin"
  [[ -n "${BMC_ADDR:-}" ]] || die 1 "BMC_ADDR is not set"
}

# ipmi_run <ipmitool args...>: stdout on stdout; exit 0, 3, 4 or 1.
ipmi_run() {
  local err out rc=0
  err="/tmp/hps-ipmi-$$.err"
  out="$(IPMI_PASSWORD="$pass" ipmitool -I "${BMC_OPT_interface:-lanplus}" -H "$BMC_ADDR" -U "$user" -E "$@" 2> "$err")" || rc=$?
  if [[ $rc -ne 0 ]]; then
    local msg
    msg="$(head -c 400 "$err" || true)"
    rm -f "$err"
    if grep -qiE 'unauthorized|invalid user|insufficient privilege|password invalid|authentication' <<< "$msg"; then
      die 3 "BMC $BMC_ADDR refused the credential"
    fi
    if grep -qiE 'unable to establish|timed? ?out|refused|unreachable|no route|get auth capabilities' <<< "$msg"; then
      die 4 "BMC $BMC_ADDR unreachable"
    fi
    die 1 "ipmitool failed (exit $rc)"
  fi
  rm -f "$err"
  printf '%s\n' "$out"
}

field() {
  # field <label> <text>: value of the first "label : value" line.
  awk -F' *: *' -v k="$1" '$1 ~ "^" k "$" { print $2; exit }' <<< "$2"
}

# act_console: the SOL session. Output on stdout, keystrokes from stdin. The
# session is bounded by timeout(1) and always deactivated afterwards.
act_console() {
  local secs="${BMC_CONSOLE_SECONDS:-}" err tpid rc=0 iface="${BMC_OPT_interface:-lanplus}"
  { IFS= read -r user <&3 || true; } 2> /dev/null
  { IFS= read -r pass <&3 || true; } 2> /dev/null
  [[ -n "$user" && -n "$pass" ]] || die 3 "no credential supplied on fd 3"
  [[ -n "${BMC_ADDR:-}" ]] || die 1 "BMC_ADDR is not set"
  [[ "$secs" =~ ^[0-9]+$ ]] || die 1 "BMC_CONSOLE_SECONDS is not set"
  err="/tmp/hps-ipmi-console-$$.err"
  : > "$err"
  # shellcheck disable=SC2064  # err is fixed now
  trap "rm -f '$err'" EXIT
  exec 4<&0
  IPMI_PASSWORD="$pass" timeout -k 5 "$secs" ipmitool -I "$iface" -H "$BMC_ADDR" -U "$user" -E sol activate 2> "$err" <&4 &
  tpid=$!
  trap 'kill "$tpid" 2>/dev/null || true' TERM INT HUP
  while true; do
    rc=0
    wait "$tpid" || rc=$?
    kill -0 "$tpid" 2> /dev/null || break
  done
  IPMI_PASSWORD="$pass" ipmitool -I "$iface" -H "$BMC_ADDR" -U "$user" -E sol deactivate > /dev/null 2>&1 || true
  case $rc in
    0 | 124 | 137) return 0 ;;
  esac
  head -c 400 "$err" >&2 || true
  if grep -qiE 'unauthorized|invalid user|insufficient privilege|password invalid|authentication' "$err"; then
    die 3 "BMC $BMC_ADDR refused the credential"
  fi
  if grep -qiE 'unable to establish|timed? ?out|refused|unreachable|no route|get auth capabilities' "$err"; then
    die 4 "BMC $BMC_ADDR unreachable"
  fi
  die 1 "sol activate failed (exit $rc)"
}

act_status() {
  local chassis mc fru power fw model serial
  chassis="$(ipmi_run chassis power status)"
  case "${chassis,,}" in
    *" is on"*) power=on ;;
    *" is off"*) power=off ;;
    *) power=unknown ;;
  esac
  mc="$(ipmi_run mc info || true)"
  fru="$(ipmi_run fru print 0 || true)"
  fw="$(field 'Firmware Revision' "$mc")"
  model="$(field 'Product Name' "$fru")"
  serial="$(field 'Product Serial' "$fru")"
  jq -cn --arg power "$power" --arg model "$model" --arg serial "$serial" --arg fw "$fw" \
    '{power: $power, model: $model, serial: $serial, bmc_firmware: $fw}'
}

current_power() {
  local chassis
  chassis="$(ipmi_run chassis power status)"
  case "${chassis,,}" in *" is on"*) echo on ;; *) echo off ;; esac
}

main() {
  local action="${1:-}"
  case "$action" in
    status | on | off | force-off | reset | pxe-once | identify | console) ;;
    *) die 1 "usage: ipmi status|on|off|force-off|reset|pxe-once|identify|console" ;;
  esac
  if [[ "$action" == console ]]; then
    act_console
    return
  fi
  read_credential
  case "$action" in
    status) act_status ;;
    on) ipmi_run chassis power on > /dev/null ;;
    off) ipmi_run chassis power soft > /dev/null ;;
    force-off) ipmi_run chassis power off > /dev/null ;;
    reset) ipmi_run chassis power reset > /dev/null ;;
    identify) ipmi_run chassis identify "${BMC_OPT_identify_seconds:-15}" > /dev/null ;;
    pxe-once)
      ipmi_run chassis bootdev pxe options=efiboot > /dev/null
      if [[ "$(current_power)" == on ]]; then
        ipmi_run chassis power reset > /dev/null
      else
        ipmi_run chassis power on > /dev/null
      fi
      ;;
  esac
}

main "$@"
